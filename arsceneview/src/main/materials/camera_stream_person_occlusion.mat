// camera_stream_person_occlusion.mat — see CONTRIBUTING.md "Filament runtime ↔ .filamat ABI invariant"
//
// Purpose:    Full-screen AR camera passthrough that occludes virtual content behind real
//             people (issue #1761). Strict superset of `camera_stream_depth.mat`: keeps the
//             ARCore depth-occlusion path and the environment-aware fog (#1717) verbatim, and
//             adds a Scene Semantics PERSON-class segmentation mask that pushes the camera
//             pixel to the near plane wherever a real person is detected — so virtual
//             geometry behind the person is depth-tested away.
// Used by:    ARCameraStream (personOcclusionMaterialFile) — ARSceneView people-occlusion path.
// Parameters:
//   cameraTexture — samplerExternal, the live ARCore camera feed.
//   depthTexture  — sampler2d, ARCore packed depth (mm) in the .xy channels.
//   personTexture — sampler2d, R8 binary PERSON mask (255 = person, 0 = background).
//   uvTransform   — float4x4, ARCore display-rotation UV transform.
//   fogEnabled    — float, 0/1 branchless gate multiplied into the fog factor.
//   fogColor      — float3, RGB haze colour (mirrors FogNode.color).
//   fogDensity    — float [0,1], exponential falloff coefficient in 1/m.
//   fogStart      — float, distance in metres where fog begins to accumulate.
//   fogEnd        — float, distance in metres where fog is fully opaque.
//   groundContact — float4, view-space contact centre (xyz, m) and grounding radius (w, m).
//   groundNormal  — float4, view-space contact-plane normal (xyz) and 0/1 enable gate (w).
// matc profile: C (ARCore — "--optimize-size -p mobile -a opengl -a vulkan").
material {
    name : personOcclusion,
    shadingModel : unlit,
    blending : opaque,
    culling : none,
    vertexDomain : device,
    parameters : [
        {
            type : samplerExternal,
            name : cameraTexture
        },
        {
            type : sampler2d,
            name : depthTexture
        },
        // Scene Semantics PERSON mask (issue #1761). A single-channel R8 raster: each texel
        // is 255 where ARCore classified the pixel as PERSON, 0 elsewhere. The CPU side
        // (`PersonMask.build`) bakes the 12-class semantic ordinal raster down to this
        // binary mask so the shader test is a branchless `step()` — no per-fragment
        // multiply-and-integer-compare.
        {
            type : sampler2d,
            name : personTexture
        },
        {
            type : float4x4,
            name : uvTransform
        },
        // Environment-aware AR fog (issue #1717). Identical declarations to
        // `camera_stream_depth.mat` so a single fog-parameter binding path drives either
        // material.
        {
            type : float,
            name : fogEnabled
        },
        {
            type : float3,
            name : fogColor
        },
        {
            type : float,
            name : fogDensity
        },
        {
            type : float,
            name : fogStart
        },
        {
            type : float,
            name : fogEnd
        },
        // Contact grounding (rule 4 below). Set every frame by ARCameraStream from the placed
        // object's contact; groundNormal.w = 0 (the default) turns the rule off.
        {
            type : float4,
            name : groundContact
        },
        {
            type : float4,
            name : groundNormal
        }
    ],
    variables : [
        {
            name : groundRay,
            precision : high
        }
    ],
    requires : [
        uv0
    ]
}

fragment {
    // See `camera_stream_depth.mat` — stand-in distance for texels with no ARCore depth.
    const float kNoDepthDistanceMeters = 1000.0;

    // ── Occlusion shaping (2026-11-04 device QA, ARMV #71) ────────────────────────────────
    // ARCore's depth is a 160x90 motion-stereo estimate. Writing it into the z-buffer as is
    // made a binary, noisy test: a model on the floor was cut in saw-teeth by the floor's own
    // noise, a model far away was chopped by depth that far being a guess, and the camera
    // could see the real world through holes in its own floor. All in metres along the view
    // axis, decided per fragment with one stable screen-space threshold `b` in [0, 1):
    //
    //  1. Tolerance. The real surface must be nearer than the virtual one by
    //     kTolBase + kTolLinear*d + kTolQuad*d^2 (6 cm at 1 m, 11 cm at 2 m, 27 cm at 4 m):
    //     ARCore's depth error grows about quadratically with distance. A hard limit, not
    //     dithered: spread over [0.5, 1.5] x tolerance by `b`, the contact band of a model
    //     on the floor broke into vertical streaks and the placement ring into dashes
    //     (Pixel 4a, 2026-11-04). The edge stays soft because `d` is a smooth cubic
    //     reconstruction of the depth texture (occlusionDepthMeters), not its bilinear sample.
    //  2. Range. From kFarFadeStart to kFarFadeEnd the share of texels that occlude falls to
    //     zero: beyond ~8 m phone depth does not occlude at all.
    //  3. No depth. A texel with no depth (0, or the filter's 0xFFFF "none") occludes
    //     nothing (#3340).
    //  4. Contact grounding. Around a placed object's contact point (within groundContact.w,
    //     fading out to (1 + kGroundFade) x that radius), measured depth up to kGroundBand
    //     nearer than the contact plane counts as the plane itself. Depth noise on the floor
    //     right under an object cut a pale tongue into its contact shadow and broke its
    //     placement ring (Pixel 4a, 2026-11-04): the decals lie 1-5 mm above a plane whose
    //     measured depth there wandered more than the tolerance. A real object standing in
    //     front still occludes once it is nearer than the plane by kGroundBand + tolerance
    //     (21 cm at 2 m), so a chair leg 30 cm in front still hides the shadow, the ring and
    //     the model. Off (groundNormal.w = 0) the rule is the identity.
    // Hiding what is too CLOSE to the camera cannot be done here: the camera quad can only
    // hide what is farther than the depth it writes.
    const float kTolBase = 0.03;
    const float kTolLinear = 0.02;
    const float kTolQuad = 0.01;
    const float kFarFadeStart = 5.0;
    const float kFarFadeEnd = 8.0;
    const float kMaxValidDepthMeters = 60.0;
    const float kGroundBand = 0.10;
    const float kGroundFade = 0.5;

    // Interleaved gradient noise (Jimenez 2014): a per-pixel threshold in [0, 1) that is
    // stable from frame to frame (no temporal shimmer) and has no visible grid, unlike a
    // Bayer matrix.
    float occlusionThreshold(const vec2 fragCoord) {
        return fract(52.9829189 * fract(dot(fragCoord, vec2(0.06711056, 0.00583715))));
    }

    // Packed depth (mm in .xy) decoded to metres.
    highp float decodeDepthMeters(const highp vec2 packed_depth) {
        return dot(packed_depth, vec2(255.f, 256.f * 255.f)) / 1000.f;
    }

    // Depth for the occlusion test, reconstructed with a cubic B-spline from four bilinear
    // taps (Sigg & Hadwiger, GPU Gems 2 ch. 20). A plain bilinear sample is only C0: its
    // contour against the tolerance kinks on every texel boundary, so the edge where the
    // floor's depth crosses the tolerance came out as 160x90 steps (Pixel 4a, 2026-11-04).
    // The B-spline is C2 and low-pass, so that edge is a smooth curve. The packed .xy blend
    // linearly, so blending before decoding is exact. Everything is highp: in mediump (fp16
    // on the Pixel 4a's Adreno) uv * size near 160 moves in 1/8-texel steps, which brings back
    // finer steps.
    highp float occlusionDepthMeters(const highp vec2 uv) {
        highp vec2 size = vec2(textureSize(materialParams_depthTexture, 0));
        highp vec2 st = uv * size - 0.5;
        highp vec2 i = floor(st);
        highp vec2 f = st - i;
        highp vec2 f2 = f * f;
        highp vec2 f3 = f2 * f;
        highp vec2 w0 = (1.f / 6.f) * (1.f - 3.f * f + 3.f * f2 - f3);
        highp vec2 w1 = (1.f / 6.f) * (4.f - 6.f * f2 + 3.f * f3);
        highp vec2 w2 = (1.f / 6.f) * (1.f + 3.f * f + 3.f * f2 - 3.f * f3);
        highp vec2 w3 = (1.f / 6.f) * f3;
        highp vec2 g0 = w0 + w1;
        highp vec2 g1 = w2 + w3;
        highp vec2 uv0 = (i - 0.5f + w1 / g0) / size;
        highp vec2 uv1 = (i + 1.5f + w3 / g1) / size;
        highp vec2 packed_depth =
                g0.y * (g0.x * texture(materialParams_depthTexture, vec2(uv0.x, uv0.y)).xy +
                        g1.x * texture(materialParams_depthTexture, vec2(uv1.x, uv0.y)).xy) +
                g1.y * (g0.x * texture(materialParams_depthTexture, vec2(uv0.x, uv1.y)).xy +
                        g1.x * texture(materialParams_depthTexture, vec2(uv1.x, uv1.y)).xy);
        return decodeDepthMeters(packed_depth);
    }

    // Rule 4 for the view-space ray `ray` through this pixel: x = distance along the view
    // axis to the contact plane, y = the band (metres) by which nearer measured depth still
    // counts as that plane — kGroundBand inside the contact disc, 0 beyond its fade, when the
    // rule is off, and where the ray never meets the plane in front of the camera.
    // Off returns (0, 0) before any division: max(d, min(0, d)) is exactly d, with no NaN for
    // a GPU that does not drop it in min/max. highp throughout, like the depth reconstruction.
    highp vec2 groundSurface(const highp vec3 ray) {
        if (materialParams.groundNormal.w < 0.5) return vec2(0.0);
        highp vec3 normal = materialParams.groundNormal.xyz;
        highp vec3 contact = materialParams.groundContact.xyz;
        highp float radius = max(materialParams.groundContact.w, 1e-4);
        highp float facing = dot(normal, ray);
        highp float along = dot(normal, contact) / (abs(facing) > 1e-4 ? facing : 1e-4);
        highp vec3 hit = along * ray;
        highp float fade = 1.0 - clamp((length(hit - contact) - radius) / (radius * kGroundFade), 0.0, 1.0);
        highp float band_m = kGroundBand * step(0.0, along) * fade;
        return vec2(-hit.z, band_m);
    }

    // Distance, in metres, the camera quad writes into the z-buffer for a texel whose real
    // depth is `depth_m` and validity `depth_valid`; `ground` is groundSurface() for its ray.
    float occluderDistance(const float depth_m, const float depth_valid, const float b,
                           const vec2 ground) {
        float tolerance = kTolBase + depth_m * (kTolLinear + kTolQuad * depth_m);
        float surface_m = max(depth_m, min(ground.x, depth_m + ground.y));
        float occluder_m = surface_m + tolerance;
        float in_range = step(smoothstep(kFarFadeStart, kFarFadeEnd, depth_m), b);
        return mix(kNoDepthDistanceMeters, occluder_m, depth_valid * in_range);
    }

    // Reverse-Z near plane. Filament maps 1.0 to NEAR and 0.0 to far (see
    // ARDepthOfField's convention note), so this is "as close to the lens as a
    // fragment can be" — what the PERSON mask has to write to win every depth test.
    const float kNdcNearPlane = 1.0;

    // Exact sRGB EOTF (IEC 61966-2-1), issue #3338 — copied verbatim from
    // `camera_stream_depth.mat`; see `camera_stream_flat.mat` for the full rationale.
    vec3 srgbToLinearExact(const vec3 srgb) {
        vec3 s = clamp(srgb, 0.0, 1.0);
        return mix(s * (1.0 / 12.92),
                   pow((s + 0.055) * (1.0 / 1.055), vec3(2.4)),
                   step(vec3(0.04045), s));
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec3 camera = Inverse_Tonemap_Filmic(
                srgbToLinearExact(texture(materialParams_cameraTexture, getUV0()).rgb));
        vec2 packed_depth = texture(materialParams_depthTexture, getUV0()).xy;
        float depth_mm = dot(packed_depth, vec2(255.f, 256.f * 255.f));
        float depth_m = depth_mm / 1000.f;
        // The bilinear sample blends a hole (0xFFFF, 65.5 m) with its neighbour into any
        // depth from 5 to 60 m, which the fog would read as valid: a ring of near-full fog
        // around every hole. The fog reads the unfiltered texel for validity and never a
        // depth farther than it.
        ivec2 depth_texel = ivec2(getUV0() * vec2(textureSize(materialParams_depthTexture, 0)));
        float nearest_m = dot(texelFetch(materialParams_depthTexture, depth_texel, 0).xy,
                              vec2(255.f, 256.f * 255.f)) / 1000.f;
        float fog_m = min(depth_m, nearest_m);

        // Environment-aware fog blend — copied verbatim from `camera_stream_depth.mat`.
        float fog_valid = step(0.001f, nearest_m) * step(nearest_m, kMaxValidDepthMeters);
        float adjusted = clamp(fog_m - materialParams.fogStart, 0.f,
                               max(materialParams.fogEnd - materialParams.fogStart, 0.001f));
        float factor = 1.f - exp(-materialParams.fogDensity * adjusted);
        factor = clamp(factor, 0.f, 1.f) * fog_valid * materialParams.fogEnabled;

        vec3 fogged = mix(camera, materialParams.fogColor, factor);
        material.baseColor.rgb = fogged;

        // Depth-occlusion path — the camera quad writes the real-world depth so virtual
        // geometry farther than the depth pixel fails the depth test. Texels with no
        // ARCore depth are pushed to `kNoDepthDistanceMeters` rather than left at 0,
        // which would divide by `view.w == 0` and clamp to the near plane, occluding
        // everything. Same fix, same reason as `camera_stream_depth.mat` (#3340).
        float occlusion_m = occlusionDepthMeters(getUV0());
        float occlusion_valid = step(0.001f, occlusion_m) * step(occlusion_m, kMaxValidDepthMeters);
        vec2 ground = groundSurface(variable_groundRay.xyz / variable_groundRay.w);
        float occlusion_depth_m = occluderDistance(occlusion_m, occlusion_valid,
                occlusionThreshold(gl_FragCoord.xy), ground);
        vec4 view = mulMat4x4Float3(getClipFromViewMatrix(), vec3(0.f, 0.f, -occlusion_depth_m));
        float ndc_depth = view.z / view.w;

        // People-occlusion path (#1761). `personTexture` is a binary R8 mask; the GPU
        // normalises 255 → 1.0 and 0 → 0.0. `step(0.5, …)` recovers the boolean
        // branch-free. Where a real person is detected we force the camera fragment to the
        // near clip plane so EVERY virtual fragment behind it — regardless of its
        // real-world distance — fails the depth test and the person occludes it.
        //
        // The near plane is `kNdcNearPlane` (1.0), NOT 0.0. This wrote 0.0 until #3340:
        // under Filament's reverse-Z that is the *far* plane, so the mask pushed people
        // behind everything and virtual objects drew straight over them — the exact
        // inverse of people occlusion. The original comment even said "near clip plane
        // (NDC depth 0.0)", which is where the sign was lost.
        //
        // This is intentionally more aggressive than the depth path: ARCore's coarse motion-
        // stereo depth is unreliable on a moving person (thin limbs, fast motion), so the
        // semantic mask is the authoritative people cue. Where there is NO person we keep
        // the genuine `ndc_depth`, so static real-world geometry still occludes correctly.
        float is_person = step(0.5f, texture(materialParams_personTexture, getUV0()).r);
        gl_FragDepth = mix(ndc_depth, kNdcNearPlane, is_person);
    }
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        material.uv0 = mulMat4x4Float3(materialParams.uvTransform, vec3(material.uv0.x, material.uv0.y, 0.f)).xy;
        vec4 clip = getPosition();
        clip.z = 0.9999f;
        material.worldPosition = mulMat4x4Float3(getWorldFromClipMatrix(), clip.xyz);
        // A view-space point on this pixel's ray, kept homogeneous: the quad is flat in clip
        // space, so interpolating it and dividing per fragment is exact.
        material.groundRay = getViewFromClipMatrix() * clip;
    }
}
