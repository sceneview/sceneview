// plane_renderer.mat — soft mark field for detected ARCore planes (#3507, #4307).
// See CONTRIBUTING.md "Filament runtime ↔ .filamat ABI invariant".
//
// Purpose:    The look every good AR app converged on (Google Scene Viewer, ARKit Quick Look,
//             IKEA Place): a field of small soft marks lying on the surface, not a shaded slab.
//             - The marks are anchored to the WORLD, not to the plane polygon: ARCore moves a
//               plane's centre pose every time the plane grows, and a pattern laid out in
//               plane-local space would slide under the user's eyes each time it did.
//             - The mark itself says what kind of surface it is (`surfaceKind`, #4307), so a
//               wall never reads as a floor, with or without colour:
//                 0 — floor / table  : round dots on a square lattice;
//                 1 — wall           : upright dashes on a staggered lattice, pointing up the
//                                      wall, the way a plumb line hangs;
//                 2 — ceiling        : hollow rings, quieter.
//             - Each mark, and the reticle ring, sits in a soft dark halo (`contrast`): a
//               white dot disappears on a sunlit floor or a white wall, the halo keeps its
//               outline; on a dark floor the halo is invisible and costs nothing.
//               The view tone-maps with ToneMapper.Filmic, which flattens everything near
//               white: a halo at 0.55 came out 10 % darker than a white wall, and a light
//               blue came out white. Hence a strong halo (0.80) and deep tints.
//             - The marks fade out towards the polygon edge (per-vertex ramp carried in local
//               Y), with distance from the camera, and into an even tone where they get
//               smaller than a pixel (no moiré at grazing angles).
//             - A plane is revealed by a soft bright front expanding from its centre, the first
//               time it appears and again each time ARCore extends it (`scanProgress`,
//               `scanPlaneRadius`, animated by PlaneVisualizer).
//             - The focused plane (`focus`, the floor under the centre of the screen) gets a
//               pool of light, a thin ring and slow ripples where the camera's optical axis
//               meets it — the reticle is drawn by the surface itself, in perspective, from
//               the camera matrices alone: no per-frame CPU work, no extra node.
//             - `opacity` fades the whole plane in and out (placement, hide, disable).
// Used by:    PlaneRenderer / PlaneVisualizer.
//
// Parameters:
//   uvScale           — float2, marks per metre along the two surface axes.
//   surfaceKind       — float, 0 floor / 1 wall / 2 ceiling (see planeMaterialPresetFor).
//   gridTint          — float3, mark colour (per plane type, see planeMaterialPresetFor).
//   gridAlpha         — float, peak opacity of a mark.
//   surfaceAlpha      — float, opacity of the faint film between marks.
//   contrast          — float 0..1, opacity of the dark halo around each mark.
//   scanProgress      — float 0..1; 1 = fully revealed (no front), below 1 = the reveal front
//                       is on screen with brightness (1 - scanProgress).
//   scanPlaneRadius   — float, plane-local radius in metres the reveal front has reached.
//   opacity           — float 0..1, whole-plane fade.
//   focus             — float 0..1, emphasis of the plane under the centre of the screen.
//
// matc profile: C (ARCore — "--optimize-size -p mobile -a opengl -a vulkan").
material {
    name : "AR Core Plane Material",

    "parameters": [
        { "type": "float2", "name": "uvScale" },
        { "type": "float", "name": "surfaceKind" },
        { "type": "float3", "name": "gridTint" },
        { "type": "float", "name": "gridAlpha" },
        { "type": "float", "name": "surfaceAlpha" },
        { "type": "float", "name": "contrast" },
        { "type": "float", "name": "scanProgress" },
        { "type": "float", "name": "scanPlaneRadius" },
        { "type": "float", "name": "opacity" },
        { "type": "float", "name": "focus" }
    ],
    "variables" : [
        // xy = world-anchored pattern coordinates (in marks), z = edge ramp.
        "patternUv",
        // xyz = plane-local position (reveal front is measured from the plane centre).
        "modelPos",
        // xyz = world point where the camera's optical axis meets this plane, w = 1 if it
        // does in front of the camera. Constant over the plane: computed once per vertex.
        "spotHit"
    ],
    "requires" : [
        "position"
    ],
    shadingModel : unlit,
    // Premultiplied-alpha compositing (ONE, ONE_MINUS_SRC_ALPHA): the fragment premultiplies
    // (#2224 — an unpremultiplied unlit colour reads as an opaque blob).
    "blending": "transparent",
    // A ceiling is seen from below and a wall from either side.
    "culling": "none",
    "depthWrite": false
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        float3 pos = getPosition().xyz;

        // Local Y carries the edge ramp (0 on the polygon, 1 inside the feather), not a height.
        float edge = pos.y;
        pos.y = 0.0;

        material.worldPosition = mulMat4x4Float3(getWorldFromModelMatrix(), pos);

        // Pattern coordinates in USER world space (ARCore's world), so the marks stay where
        // they are on the floor while ARCore re-centres and grows the plane.
        highp float3 userWorld =
            mulMat4x4Float3(getUserWorldFromWorldMatrix(), material.worldPosition.xyz).xyz;
        float3 normal = normalize(getWorldFromModelMatrix()[1].xyz);
        // The pattern AXES follow the geometry (a standing surface is laid out across and up,
        // a lying one along world X/Z); the MARK drawn on them follows `surfaceKind`.
        highp float2 surface;
        if (abs(normal.y) < 0.7) {
            // Along the wall horizontally, and up.
            float3 across = normalize(cross(float3(0.0, 1.0, 0.0), normal));
            surface = float2(dot(userWorld, across), userWorld.y);
        } else {
            surface = userWorld.xz;
        }

        material.patternUv = float4(surface * materialParams.uvScale, edge, 0.0);
        material.modelPos = float4(pos, 0.0);

        // Where the optical axis (screen centre) hits the plane's infinite support.
        float3 cameraPos = getWorldCameraPosition();
        float3 forward = -normalize(getWorldFromViewMatrix()[2].xyz);
        float3 planePoint = getWorldFromModelMatrix()[3].xyz;
        float facing = dot(normal, forward);
        float along = abs(facing) > 1e-3 ? dot(normal, planePoint - cameraPos) / facing : -1.0;
        material.spotHit = float4(cameraPos + forward * max(along, 0.0), along > 0.0 ? 1.0 : 0.0);
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        highp float2 uv = variable_patternUv.xy;
        float edgeRamp = variable_patternUv.z;
        float kind = materialParams.surfaceKind;
        float wall = (kind > 0.5 && kind < 1.5) ? 1.0 : 0.0;
        float ceiling = kind > 1.5 ? 1.0 : 0.0;

        // ── Where the camera looks at this plane ─────────────────────────────────────────
        highp float3 worldPos = getWorldPosition();
        highp float3 cameraPos = getWorldCameraPosition();
        float spotDistance = variable_spotHit.w > 0.5
            ? distance(worldPos, variable_spotHit.xyz) : 1e3;
        float focus = clamp(materialParams.focus, 0.0, 1.0);
        float spot = (1.0 - smoothstep(0.0, 0.45, spotDistance)) * focus;

        // ── Lattice ──────────────────────────────────────────────────────────────────────
        // Pixel footprint from the continuous UV: the wall stagger below jumps by half a cell
        // at each row boundary, and fwidth across that jump drew a 1 px line along the rows.
        float footprint = length(fwidth(uv));
        // Walls: every other row shifted by half a cell — brickwork, not a floor grid.
        uv.x += wall * 0.5 * mod(floor(uv.y), 2.0);
        float2 cell = fract(uv) - 0.5;

        // Slow ripples running outward from the reticle, on the focused plane only.
        // The phase is wrapped in highp: `-p mobile` makes a plain `float` mediump, and engine
        // uptime read into one steps by 0.25 s after 256 s and by 1 s after 1024 s, so the
        // ripples stuttered and then froze. 2.6179939 s = 2π / 2.4: the wrap is seamless.
        highp float ripplePhase = getUserTimeMod(2.6179939) * 2.4;
        float ripple = 0.5 + 0.5 * sin(spotDistance * 9.0 - ripplePhase);
        float grow = 1.0 + spot * (0.35 + 0.25 * ripple);

        // ── Reveal front ─────────────────────────────────────────────────────────────────
        float reveal = 1.0;
        float front = 0.0;
        float progress = clamp(materialParams.scanProgress, 0.0, 1.0);
        if (progress < 1.0) {
            // The CPU eases the front out to the plane edge and back over each extension.
            float frontRadius = materialParams.scanPlaneRadius;
            float fromCentre = length(variable_modelPos.xz);
            reveal = 1.0 - smoothstep(frontRadius - 0.30, frontRadius, fromCentre);
            float band = (fromCentre - frontRadius + 0.12) / 0.12;
            front = exp(-band * band) * (1.0 - progress);
            grow *= 1.0 + front * 0.6;
        }

        // ── The mark: signed distance to its outline, in cells (negative inside) ──────────
        float sd;
        float coverage;
        if (wall > 0.5) {
            // Upright dash: a capsule along the wall's up axis.
            float halfLength = 0.17 * grow;
            float halfWidth = 0.045 * grow;
            float2 p = float2(cell.x, cell.y - clamp(cell.y, -halfLength, halfLength));
            sd = length(p) - halfWidth;
            coverage = 4.0 * halfLength * halfWidth + 3.14159 * halfWidth * halfWidth;
        } else if (ceiling > 0.5) {
            // Hollow ring.
            float ringRadius = 0.105 * grow;
            float ringHalfWidth = 0.028 * grow;
            sd = abs(length(cell) - ringRadius) - ringHalfWidth;
            coverage = 4.0 * 3.14159 * ringRadius * ringHalfWidth;
        } else {
            // Round dot.
            float radius = 0.09 * grow;
            sd = length(cell) - radius;
            coverage = 3.14159 * radius * radius;
        }

        float aa = max(footprint * 0.7, 0.02);
        float markMask = 1.0 - smoothstep(-aa, aa, sd);
        // Marks smaller than a pixel become their average coverage instead of shimmering.
        float subPixel = smoothstep(0.30, 0.70, footprint);
        markMask = mix(markMask, coverage, subPixel);
        // Dark halo, 10 % of a cell wide and fading outwards; gone once the mark itself is
        // sub-pixel. 5 % was a hairline that white paint in daylight swallowed.
        float rimMask = (1.0 - smoothstep(-aa, 0.10 + aa, sd)) * (1.0 - subPixel);

        // ── Reticle ring, 12 cm around the hit point ─────────────────────────────────────
        float ringWidth = max(fwidth(spotDistance) * 1.2, 0.004);
        float ringDistance = abs(spotDistance - 0.12);
        float ring = (1.0 - smoothstep(0.0, ringWidth, ringDistance)) * focus;
        // Same halo as the marks: a white ring is lost on a white floor without it.
        float ringRim = (1.0 - smoothstep(ringWidth, ringWidth * 3.5, ringDistance)) * focus;

        // ── Fades ────────────────────────────────────────────────────────────────────────
        float edgeFade = smoothstep(0.0, 1.0, edgeRamp);
        float cameraDistance = distance(worldPos, cameraPos);
        float distanceFade = 1.0 - smoothstep(3.0, 6.5, cameraDistance);
        float emphasis = mix(0.6, 1.0, focus);
        float opacity = clamp(materialParams.opacity, 0.0, 1.0);
        float fade = edgeFade * distanceFade * reveal;

        // Light: what the mark, the film and the reticle add to the camera image.
        float light = markMask * materialParams.gridAlpha * emphasis * (1.0 + front)
            + materialParams.surfaceAlpha * emphasis
            + spot * 0.05;
        light *= fade;
        light += ring * 0.85 * edgeFade * reveal;
        light = clamp(light * opacity, 0.0, 1.0);

        // Shade: what the halo takes away from it, only where the mark is not.
        float contrast = clamp(materialParams.contrast, 0.0, 1.0);
        float shade = rimMask * (1.0 - markMask) * contrast * emphasis * fade * opacity;
        shade = max(shade, ringRim * contrast * edgeFade * reveal * opacity);

        // The pool of light under the reticle only lifts the tint a third of the way to white:
        // more, and a wall lost its colour exactly where the user is looking.
        float3 rgb = mix(materialParams.gridTint, float3(1.0),
            clamp(spot * 0.35 + front + ring, 0.0, 1.0));

        // Premultiplied: the halo contributes coverage but no colour.
        material.baseColor = float4(rgb * light, clamp(light + shade * (1.0 - light), 0.0, 1.0));
    }
}
