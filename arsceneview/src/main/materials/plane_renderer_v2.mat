// plane_renderer_v2.mat — soft dot field for detected ARCore planes (#3507, rebuild of #2203).
// See CONTRIBUTING.md "Filament runtime ↔ .filamat ABI invariant".
//
// Purpose:    The look every good AR app converged on (Google Scene Viewer, ARKit Quick Look,
//             IKEA Place): a field of small soft dots lying on the surface, not a shaded slab.
//             - The dots are anchored to the WORLD, not to the plane polygon: ARCore moves a
//               plane's centre pose every time the plane grows, and a pattern laid out in
//               plane-local space would slide under the user's eyes each time it did.
//             - Floors and ceilings get a square lattice; walls a staggered, smaller one — the
//               two read as different surfaces without a colour legend.
//             - The dots fade out towards the polygon edge (per-vertex ramp carried in local
//               Y, the V1 convention), with distance from the camera, and into an even tone
//               where they get smaller than a pixel (no moiré at grazing angles).
//             - A plane is revealed by a soft bright front expanding from its centre, the first
//               time it appears and again each time ARCore extends it (`scanProgress`,
//               `scanPlaneRadius`, animated by PlaneVisualizerV2).
//             - The focused plane (`focus`, the floor under the centre of the screen) gets a
//               pool of light, a thin ring and slow ripples where the camera's optical axis
//               meets it — the reticle is drawn by the surface itself, in perspective, from
//               the camera matrices alone: no per-frame CPU work, no extra node.
//             - `opacity` fades the whole plane in and out (placement, hide, disable).
// Used by:    PlaneRendererV2 / PlaneVisualizerV2.
//
// Parameters:
//   texture           — sampler2d, kept for binary/API compatibility; not sampled.
//   color             — float3, legacy tint multiplied into gridTint.
//   uvScale           — float2, dots per metre along the two surface axes.
//   metallic          — float, kept for API compatibility (PlaneRendererV2.MATERIAL_METALLIC);
//                       unused since the surface is unlit.
//   roughness         — float, kept for API compatibility; unused.
//   reflectance       — float, kept for API compatibility; unused.
//   gridTint          — float3, dot colour (per plane type, see planeMaterialPresetFor).
//   gridAlpha         — float, peak opacity of a dot.
//   surfaceAlpha      — float, opacity of the faint film between dots.
//   reflectionFadeIn  — float, kept for API compatibility; unused.
//   scanProgress      — float 0..1; 1 = fully revealed (no front), below 1 = the reveal front
//                       is on screen with brightness (1 - scanProgress).
//   scanPlaneRadius   — float, plane-local radius in metres the reveal front has reached.
//   opacity           — float 0..1, whole-plane fade.
//   focus             — float 0..1, emphasis of the plane under the centre of the screen.
//
// matc profile: C (ARCore — "--optimize-size -p mobile -a opengl -a vulkan").
material {
    name : "AR Core Plane Material V2",

    "parameters": [
        { "type": "sampler2d", "name": "texture" },
        { "type": "float3", "name": "color" },
        { "type": "float2", "name": "uvScale" },
        { "type": "float", "name": "metallic" },
        { "type": "float", "name": "roughness" },
        { "type": "float", "name": "reflectance" },
        { "type": "float3", "name": "gridTint" },
        { "type": "float", "name": "gridAlpha" },
        { "type": "float", "name": "surfaceAlpha" },
        { "type": "float", "name": "reflectionFadeIn" },
        { "type": "float", "name": "scanProgress" },
        { "type": "float", "name": "scanPlaneRadius" },
        { "type": "float", "name": "opacity" },
        { "type": "float", "name": "focus" }
    ],
    "variables" : [
        // xy = world-anchored pattern coordinates (in dots), z = edge ramp, w = 1 on walls.
        "patternUv",
        // xyz = plane-local position (reveal front is measured from the plane centre).
        "modelPos",
        // xyz = world point where the camera's optical axis meets this plane, w = 1 if it
        // does in front of the camera. Constant over the plane: computed once per vertex.
        "spotHit"
    ],
    "requires" : [
        "position"
    ],
    shadingModel : unlit,
    // Premultiplied-alpha compositing (ONE, ONE_MINUS_SRC_ALPHA): the fragment premultiplies,
    // see #2224 in plane_renderer.mat for why an unpremultiplied unlit colour reads as a blob.
    "blending": "transparent",
    // A ceiling is seen from below and a wall from either side.
    "culling": "none",
    "depthWrite": false
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        float3 pos = getPosition().xyz;

        // Local Y carries the edge ramp (0 on the polygon, 1 inside the feather), not a height.
        float edge = pos.y;
        pos.y = 0.0;

        material.worldPosition = mulMat4x4Float3(getWorldFromModelMatrix(), pos);

        // Pattern coordinates in USER world space (ARCore's world), so the dots stay where
        // they are on the floor while ARCore re-centres and grows the plane.
        highp float3 userWorld =
            mulMat4x4Float3(getUserWorldFromWorldMatrix(), material.worldPosition.xyz).xyz;
        float3 normal = normalize(getWorldFromModelMatrix()[1].xyz);
        float wall = abs(normal.y) < 0.7 ? 1.0 : 0.0;
        highp float2 surface;
        if (wall > 0.5) {
            // Along the wall horizontally, and up.
            float3 across = normalize(cross(float3(0.0, 1.0, 0.0), normal));
            surface = float2(dot(userWorld, across), userWorld.y);
        } else {
            surface = userWorld.xz;
        }

        material.patternUv = float4(surface * materialParams.uvScale, edge, wall);
        material.modelPos = float4(pos, 0.0);

        // Where the optical axis (screen centre) hits the plane's infinite support.
        float3 cameraPos = getWorldCameraPosition();
        float3 forward = -normalize(getWorldFromViewMatrix()[2].xyz);
        float3 planePoint = getWorldFromModelMatrix()[3].xyz;
        float facing = dot(normal, forward);
        float along = abs(facing) > 1e-3 ? dot(normal, planePoint - cameraPos) / facing : -1.0;
        material.spotHit = float4(cameraPos + forward * max(along, 0.0), along > 0.0 ? 1.0 : 0.0);
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        highp float2 uv = variable_patternUv.xy;
        float edgeRamp = variable_patternUv.z;
        float wall = variable_patternUv.w;

        // ── Where the camera looks at this plane ─────────────────────────────────────────
        highp float3 worldPos = getWorldPosition();
        highp float3 cameraPos = getWorldCameraPosition();
        float spotDistance = variable_spotHit.w > 0.5
            ? distance(worldPos, variable_spotHit.xyz) : 1e3;
        float focus = clamp(materialParams.focus, 0.0, 1.0);
        float spot = (1.0 - smoothstep(0.0, 0.55, spotDistance)) * focus;

        // ── Dot lattice ──────────────────────────────────────────────────────────────────
        // Walls: every other row shifted by half a dot, a quieter staggered pattern.
        uv.x += wall * 0.5 * mod(floor(uv.y), 2.0);
        float2 cell = fract(uv) - 0.5;
        float d = length(cell);
        float footprint = length(fwidth(uv));
        float radius = mix(0.13, 0.10, wall);

        // Slow ripples running outward from the reticle, on the focused plane only.
        float time = getUserTime().x;
        float ripple = 0.5 + 0.5 * sin(spotDistance * 9.0 - time * 2.4);
        radius *= 1.0 + spot * (0.35 + 0.25 * ripple);

        // ── Reveal front ─────────────────────────────────────────────────────────────────
        float reveal = 1.0;
        float front = 0.0;
        float progress = clamp(materialParams.scanProgress, 0.0, 1.0);
        if (progress < 1.0) {
            // The CPU eases the front out to the plane edge and back over each extension.
            float frontRadius = materialParams.scanPlaneRadius;
            float fromCentre = length(variable_modelPos.xz);
            reveal = 1.0 - smoothstep(frontRadius - 0.30, frontRadius, fromCentre);
            float band = (fromCentre - frontRadius + 0.12) / 0.12;
            front = exp(-band * band) * (1.0 - progress);
            radius *= 1.0 + front * 0.6;
        }

        float aa = max(footprint * 0.7, 0.02);
        float dotMask = 1.0 - smoothstep(radius - aa, radius + aa, d);
        // Dots smaller than a pixel become their average coverage instead of shimmering.
        float coverage = 3.14159 * radius * radius;
        dotMask = mix(dotMask, coverage, smoothstep(0.30, 0.70, footprint));

        // ── Reticle ring, 12 cm around the hit point ─────────────────────────────────────
        float ringWidth = max(fwidth(spotDistance) * 1.2, 0.004);
        float ring = (1.0 - smoothstep(0.0, ringWidth, abs(spotDistance - 0.12))) * focus;

        // ── Fades ────────────────────────────────────────────────────────────────────────
        float edgeFade = smoothstep(0.0, 1.0, edgeRamp);
        float cameraDistance = distance(worldPos, cameraPos);
        float distanceFade = 1.0 - smoothstep(3.0, 6.5, cameraDistance);
        float emphasis = mix(0.6, 1.0, focus);

        float alpha = dotMask * materialParams.gridAlpha * emphasis * (1.0 + front)
            + materialParams.surfaceAlpha * emphasis
            + spot * 0.12;
        alpha *= edgeFade * distanceFade * reveal;
        alpha += ring * 0.85 * edgeFade * reveal;
        alpha = clamp(alpha * clamp(materialParams.opacity, 0.0, 1.0), 0.0, 1.0);

        float3 tint = materialParams.gridTint * materialParams.color;
        float3 rgb = mix(tint, float3(1.0), clamp(spot * 0.6 + front + ring, 0.0, 1.0));

        material.baseColor = float4(rgb * alpha, alpha);
    }
}
