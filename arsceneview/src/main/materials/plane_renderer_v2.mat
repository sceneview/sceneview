// plane_renderer_v2.mat — PR #3: PBR lit + IBL reflection + scan-in animation (#2203).
// See CONTRIBUTING.md "Filament runtime ↔ .filamat ABI invariant".
//
// Purpose:    PR #3 of #2203 — the V2 plane becomes a real PBR surface lit by the real room.
//             Switches `shadingModel: lit` so Filament's IBL pipeline samples the
//             environmental HDR cubemap that LightEstimator continuously feeds into
//             `scene.indirectLight`. A glossy floor visibly reflects the actual ceiling
//             lights / window glow; a matt wall picks up the actual ambient irradiance.
//             The depth-driven vertex stream (PR #2) now carries TANGENTS (Filament's
//             quaternion encoding of the smooth per-vertex normal), so PBR specular
//             highlights wrap correctly across bumps and slopes instead of looking
//             faceted.
//
//             Animation: the first time a plane appears, an 800 ms scan-in pulses a thin
//             bright ring outward from the polygon centroid, and a separate 1 s
//             `reflectionFadeIn` ramps PBR `metallic` + `reflectance` from 0 to their
//             configured values, masking ARCore's HDR cubemap stabilisation window so
//             the reflection brightens up smoothly rather than snapping from flat to
//             fully PBR.
//
// Used by:    PlaneVisualizerV2 — depth-driven OR flat-fallback path. The flat fallback
//             feeds smooth `(0, 1, 0)` normals so the lit shader still reads as a level
//             surface.
//
// Parameters:
//   texture           — sampler2d, kept for binary/API compatibility; not sampled here.
//   color             — float3, legacy tint, multiplied into gridTint at the fragment stage.
//   uvScale           — float2, tiling factor mapping plane-local X/Z to grid-cell coords.
//   metallic          — float, PBR metalness; default 0.0 (dielectric floor).
//   roughness         — float, PBR roughness; default 0.35 (slight gloss — PR #4 varies per
//                       plane.type).
//   reflectance       — float, dielectric Fresnel reflectance at normal incidence; 0.5 = 4%.
//   gridTint          — float3, cool-white tint for the procedural grid + scan ring.
//   gridAlpha         — float, peak per-pixel opacity of the grid lines; 0.85 default.
//   surfaceAlpha      — float, base opacity of the lit surface between grid lines; 0.10
//                       default ("etched into a real surface" effect).
//   reflectionFadeIn  — float, 0..1 — modulates `metallic` + `reflectance` so the IBL
//                       contribution fades in over ~1 s; the visualizer ramps this from 0
//                       to 1 on the first second of the plane's life.
//   scanProgress      — float, 0..1 — drives the scan-in ring expansion; 1.0 means the
//                       scan animation is over and the ring is no longer drawn.
//   scanPlaneRadius   — float, max radius the scan ring will reach, in plane-local metres
//                       (≈ furthest polygon vertex from the centroid). Set per plane.
//
// matc profile: C (ARCore — "--optimize-size -p mobile -a opengl -a vulkan"). Lit shaders
// are significantly larger than unlit — expect ~80–100 KB for the .filamat blob (was
// ~41 KB at PR #2 unlit). The size growth is the PBR pipeline (IBL evaluation, GGX BRDF,
// energy-conserving Fresnel) and is the whole point of PR #3.
material {
    name : "AR Core Plane Material V2",

    "parameters": [
        {
            "type": "sampler2d",
            "name": "texture"
        },
        {
            "type": "float3",
            "name": "color"
        },
        {
            "type": "float2",
            "name": "uvScale"
        },
        {
            "type": "float",
            "name": "metallic"
        },
        {
            "type": "float",
            "name": "roughness"
        },
        {
            "type": "float",
            "name": "reflectance"
        },
        {
            "type": "float3",
            "name": "gridTint"
        },
        {
            "type": "float",
            "name": "gridAlpha"
        },
        {
            "type": "float",
            "name": "surfaceAlpha"
        },
        {
            "type": "float",
            "name": "reflectionFadeIn"
        },
        {
            "type": "float",
            "name": "scanProgress"
        },
        {
            "type": "float",
            "name": "scanPlaneRadius"
        }
    ],
    "variables" : [
        "texCoords",
        "modelPos"
    ],
    // `requires` lists shader inputs the fragment stage reads via Filament's `getXyz()`
    // helpers. The TANGENTS vertex attribute is consumed automatically by the lit
    // shading model whenever it's present on the bound VertexBuffer — no `requires`
    // entry needed (same pattern as `sceneview/.../transparent_colored.mat`).
    "requires" : [
        "position"
    ],
    shadingModel : lit,
    "blending": "transparent"
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        // The vertex POSITION is in plane-local (a.k.a. model) space — X-Z is the plane
        // surface, +Y is the displacement along the plane normal (depth-driven from PR #2;
        // 0 on the flat fallback). Hand the position to Filament in world space so the
        // PBR pipeline can light it.
        float3 pos = getPosition().xyz;
        material.worldPosition = mulMat4x4Float3(getWorldFromModelMatrix(), pos);

        // Pass the plane-local position to the fragment stage. The grid lookup and the
        // radial scan ring both operate in plane-local space so the grid stays glued to
        // the surface regardless of how much the depth pipeline has pushed it up or down.
        // (Material variables are float4 — store xyz, leave w = 0.)
        material.modelPos = vec4(pos, 0.0);

        // Grid UVs are derived from the plane-local X-Z so the grid stays consistent
        // across depth-driven bumps.
        material.texCoords.x = pos.x * materialParams.uvScale.x;
        material.texCoords.y = pos.z * materialParams.uvScale.y;
    }
}

fragment {
    // Anti-aliased distance-to-nearest-grid-line, in grid-cell units. Same screen-space
    // derivative trick as V1: the line stays ~1px wide at any distance/angle.
    float gridLine(float2 uv) {
        float2 grid = abs(fract(uv - 0.5) - 0.5);
        float2 fw = fwidth(uv);
        float2 d = grid / max(fw, vec2(1e-5));
        float line = 1.0 - min(min(d.x, d.y) * 0.65, 1.0);
        return clamp(line, 0.0, 1.0);
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        float2 uv = variable_texCoords.xy;

        // Procedural soft grid — thin anti-aliased lines + cell fill so the plane reads
        // as a surface rather than a wireframe (same "feathered overlay" look as V1/V2 PR #2).
        float line = gridLine(uv);
        float2 cell = abs(fract(uv) - 0.5) * 2.0;
        float fill = (1.0 - max(cell.x, cell.y)) * 0.10;

        // Slope-aware darkening preserved from PR #2 so micro-relief reads even under
        // PBR. In plane-local space the unrotated up axis is (0,1,0); deriving the
        // geometric normal from screen-space derivatives of the plane-local position
        // makes `localGeoN.y` the cosine of the surface tilt. Up to 30% darken on the
        // steepest slopes (gentler than PR #2's 40% because the lit pipeline now also
        // shades the surface — stacking the two would crush detail).
        float3 dPosDx = dFdx(variable_modelPos.xyz);
        float3 dPosDy = dFdy(variable_modelPos.xyz);
        float3 localGeoN = normalize(cross(dPosDx, dPosDy));
        float slope = 1.0 - abs(localGeoN.y);
        float slopeShade = 1.0 - slope * 0.3;

        // ── Scan-in ring ─────────────────────────────────────────────────────────────
        // Bright ring expanding outward from the polygon centroid (plane-local origin)
        // for the first 800 ms of the plane's life. Skip entirely once the visualizer
        // signals scanProgress >= 1.0 — saves a couple of ALU ops per fragment for the
        // entire steady-state lifetime of the plane.
        float ringPulse = 0.0;
        if (materialParams.scanProgress < 1.0) {
            float dist = length(variable_modelPos.xz);
            float ringRadius = materialParams.scanProgress * materialParams.scanPlaneRadius;
            // Thin (~4 cm wide) anti-aliased ring at `ringRadius`.
            float inner = smoothstep(ringRadius - 0.04, ringRadius - 0.02, dist);
            float outer = 1.0 - smoothstep(ringRadius, ringRadius + 0.02, dist);
            ringPulse = inner * outer;
        }

        // ── PBR slots ────────────────────────────────────────────────────────────────
        // Reflection fade-in: scale `metallic` + `reflectance` by `reflectionFadeIn` so
        // during the first ~1 s the surface goes from diffuse-only to fully PBR. Reads
        // as "the reflection brightens up" instead of snapping in when ARCore's HDR
        // cubemap estimate first stabilises.
        float fade = clamp(materialParams.reflectionFadeIn, 0.0, 1.0);
        material.metallic = materialParams.metallic * fade;
        material.roughness = materialParams.roughness;
        material.reflectance = materialParams.reflectance * fade;

        // Grid tint × legacy `color` × slope shade gives the base albedo. Overdrive the
        // scan ring (×2.0) into the base color so it reads as a bright sweep across the
        // surface, independent of any IBL contribution.
        float3 albedo = materialParams.gridTint * materialParams.color * slopeShade;
        material.baseColor.rgb = albedo + ringPulse * materialParams.gridTint * 2.0;

        // Final alpha: grid + fill + ring + base surface opacity, clamped. The
        // `surfaceAlpha` floor is what lets the PBR contribution show through between
        // grid lines (V1 was 0 here, so it had no body — pure wireframe).
        float alpha = clamp(
            line * materialParams.gridAlpha + fill + ringPulse + materialParams.surfaceAlpha,
            0.0, 1.0
        );
        material.baseColor.a = alpha;
    }
}
