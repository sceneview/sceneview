// plane_renderer_shadow.mat — see CONTRIBUTING.md "Filament runtime ↔ .filamat ABI invariant"
//
// Purpose:    Shadow-receiver material for detected ARCore planes — a transparent surface
//             that catches virtual-object shadows so they ground onto the real plane.
// Used by:    PlaneRenderer (shadowMaterial) — ARSceneView plane shadow path.
// Parameters: none (shadowMultiplier = true; baseColor is a fixed 60%-alpha black).
// matc profile: C (ARCore — "--optimize-size -p mobile -a opengl -a vulkan").
material {
    name : "AR Core Plane Shadow Material",
    shadingModel : unlit,
    blending : transparent,
    shadowMultiplier : true
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        float3 pos = getPosition().xyz;

        // Shift the verticies upwards so we don't z-fight with the plane material.
        pos.y = 0.005f;
        material.worldPosition = mulMat4x4Float3(getWorldFromModelMatrix(), pos);
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        material.baseColor = float4(0.0f, 0.0f, 0.0f, .6f);
    }
}
