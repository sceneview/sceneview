// camera_stream_depth.mat — see CONTRIBUTING.md "Filament runtime ↔ .filamat ABI invariant"
//
// Purpose:    Full-screen AR camera passthrough with ARCore depth occlusion and optional
//             environment-aware fog (issue #1717). Writes gl_FragDepth so virtual geometry
//             is correctly occluded by the real world.
// Used by:    ARCameraStream (depthOcclusionMaterialFile) — ARSceneView depth-occlusion path.
// Parameters:
//   cameraTexture — samplerExternal, the live ARCore camera feed.
//   depthTexture  — sampler2d, ARCore packed depth (mm) in the .xy channels.
//   uvTransform   — float4x4, ARCore display-rotation UV transform.
//   fogEnabled    — float, 0/1 branchless gate multiplied into the fog factor.
//   fogColor      — float3, RGB haze colour (mirrors FogNode.color).
//   fogDensity    — float [0,1], exponential falloff coefficient in 1/m.
//   fogStart      — float, distance in metres where fog begins to accumulate.
//   fogEnd        — float, distance in metres where fog is fully opaque.
// matc profile: C (ARCore — "--optimize-size -p mobile -a opengl -a vulkan").
material {
    name : depth,
    shadingModel : unlit,
    blending : opaque,
    culling : none,
    vertexDomain : device,
    parameters : [
        {
            type : samplerExternal,
            name : cameraTexture
        },
        {
            type : sampler2d,
            name : depthTexture
        },
        {
            type : float4x4,
            name : uvTransform
        },
        // Environment-aware AR fog (issue #1717). Disabled by default so the
        // material is a strict superset of the previous depth-only behaviour.
        //
        //  - `fogEnabled`  : 0.0 or 1.0. Branchless gate — multiplied into the
        //                    fog factor so the fog mix collapses to a no-op
        //                    when disabled, avoiding a divergent branch.
        //  - `fogColor`    : RGB haze colour. Matches `FogNode.color`'s
        //                    semantic (`Color(0xFFCCDDFF)` default in code).
        //  - `fogDensity`  : Falloff coefficient in 1/m. Used in the
        //                    exponential term `1 - exp(-density * (d - start))`.
        //                    Range [0, 1] like `FogNode.density`.
        //  - `fogStart`    : Distance in metres at which fog begins to
        //                    accumulate. Real-world surfaces closer than this
        //                    stay crisp.
        //  - `fogEnd`      : Distance in metres at which fog is fully opaque
        //                    (factor clamped to 1).
        //
        // Depth pixels with `depth_mm == 0` (ARCore "no depth available")
        // contribute no fog — we drive the factor to 0 in that case to avoid
        // tinting the camera passthrough on regions the depth API can't see.
        {
            type : float,
            name : fogEnabled
        },
        {
            type : float3,
            name : fogColor
        },
        {
            type : float,
            name : fogDensity
        },
        {
            type : float,
            name : fogStart
        },
        {
            type : float,
            name : fogEnd
        }
    ],
    requires : [
        uv0
    ]
}

fragment {
    // Stand-in distance, in metres, for texels ARCore returned no depth for. Far enough
    // that the projected NDC depth sits on the far plane (so nothing is ever occluded by
    // a hole in the depth image), finite so the projection never divides by zero. See the
    // occlusion block below.
    const float kNoDepthDistanceMeters = 1000.0;

    // ── Occlusion shaping (2026-11-04 device QA, ARMV #71) ────────────────────────────────
    // ARCore's depth is a 160x120 motion-stereo estimate. Writing it into the z-buffer as is
    // made a binary, noisy test: a model on the floor was cut in saw-teeth by the floor's own
    // noise, a model far away was chopped by depth that far being a guess, and the camera
    // could see the real world through holes in its own floor. All in metres along the view
    // axis, decided per fragment with one stable screen-space threshold `b` in [0, 1):
    //
    //  1. Tolerance. The real surface must be nearer than the virtual one by
    //     kTolBase + kTolLinear*d + kTolQuad*d^2 (6 cm at 1 m, 11 cm at 2 m, 27 cm at 4 m):
    //     ARCore's depth error grows about quadratically with distance. A hard limit, not
    //     dithered: spread over [0.5, 1.5] x tolerance by `b`, the contact band of a model
    //     on the floor broke into vertical streaks and the placement ring into dashes
    //     (Pixel 4a, 2026-11-04).
    //  2. Range. From kFarFadeStart to kFarFadeEnd the share of texels that occlude falls to
    //     zero: beyond ~8 m phone depth does not occlude at all.
    //  3. No depth. A texel with no depth (0, or the filter's 0xFFFF "none") occludes
    //     nothing (#3340).
    // Three rules, not four: hiding what is too CLOSE to the camera cannot be done here.
    // The camera quad can only hide what is farther than the depth it writes.
    const float kTolBase = 0.03;
    const float kTolLinear = 0.02;
    const float kTolQuad = 0.01;
    const float kFarFadeStart = 5.0;
    const float kFarFadeEnd = 8.0;
    const float kMaxValidDepthMeters = 60.0;

    // Interleaved gradient noise (Jimenez 2014): a per-pixel threshold in [0, 1) that is
    // stable from frame to frame (no temporal shimmer) and has no visible grid, unlike a
    // Bayer matrix.
    float occlusionThreshold(const vec2 fragCoord) {
        return fract(52.9829189 * fract(dot(fragCoord, vec2(0.06711056, 0.00583715))));
    }

    // Distance, in metres, the camera quad writes into the z-buffer for a texel whose real
    // depth is `depth_m` and validity `depth_valid`.
    float occluderDistance(const float depth_m, const float depth_valid, const float b) {
        float tolerance = kTolBase + depth_m * (kTolLinear + kTolQuad * depth_m);
        float occluder_m = depth_m + tolerance;
        float in_range = step(smoothstep(kFarFadeStart, kFarFadeEnd, depth_m), b);
        return mix(kNoDepthDistanceMeters, occluder_m, depth_valid * in_range);
    }

    // Exact sRGB EOTF (IEC 61966-2-1), issue #3338 — see camera_stream_flat.mat for the
    // full rationale. Short version: the camera texel is sRGB-encoded full-range BT.709
    // (ARCore dataspace 0x08810000), and Filament re-encodes with the exact sRGB OETF at
    // the color-grading output stage, so decoding with `pow(c, 2.2)` (what Filament's
    // `inverseTonemapSRGB()` does) left an achromatic S-curve on the camera background
    // worth up to -8.5/255 in the shadows. Kept verbatim in all three camera materials —
    // matc has no include mechanism.
    vec3 srgbToLinearExact(const vec3 srgb) {
        vec3 s = clamp(srgb, 0.0, 1.0);
        return mix(s * (1.0 / 12.92),
                   pow((s + 0.055) * (1.0 / 1.055), vec3(2.4)),
                   step(vec3(0.04045), s));
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec3 camera = Inverse_Tonemap_Filmic(
                srgbToLinearExact(texture(materialParams_cameraTexture, getUV0()).rgb));
        vec2 packed_depth = texture(materialParams_depthTexture, getUV0()).xy;
        float depth_mm = dot(packed_depth, vec2(255.f, 256.f * 255.f));
        float depth_m = depth_mm / 1000.f;
        // The bilinear sample blends a hole (0xFFFF, 65.5 m) with its neighbour into any
        // depth from 5 to 60 m, which the fog would read as valid: a ring of near-full fog
        // around every hole. The fog reads the unfiltered texel for validity and never a
        // depth farther than it.
        ivec2 depth_texel = ivec2(getUV0() * vec2(textureSize(materialParams_depthTexture, 0)));
        float nearest_m = dot(texelFetch(materialParams_depthTexture, depth_texel, 0).xy,
                              vec2(255.f, 256.f * 255.f)) / 1000.f;
        float fog_m = min(depth_m, nearest_m);

        // Environment-aware fog blend. We deliberately compute the term every
        // pixel rather than `if (fogEnabled > 0.5)` to keep the shader divergent-
        // free on tile-based GPUs.
        //
        // depth_valid : 1 when ARCore returned a non-zero depth for this texel,
        //               0 otherwise. Keeps the camera pixel crisp on regions
        //               where the depth API has no data (e.g. moving objects,
        //               sky, near edges). Occlusion only.
        // fog_valid   : the same test on the unfiltered texel, for the fog.
        // adjusted   : metres beyond `fogStart`, clamped to fogEnd.
        // factor     : 1 - exp(-density * adjusted), clamped to [0, 1].
        float depth_valid = step(0.001f, depth_m) * step(depth_m, kMaxValidDepthMeters);
        float fog_valid = step(0.001f, nearest_m) * step(nearest_m, kMaxValidDepthMeters);
        float adjusted = clamp(fog_m - materialParams.fogStart, 0.f,
                               max(materialParams.fogEnd - materialParams.fogStart, 0.001f));
        float factor = 1.f - exp(-materialParams.fogDensity * adjusted);
        factor = clamp(factor, 0.f, 1.f) * fog_valid * materialParams.fogEnabled;

        vec3 fogged = mix(camera, materialParams.fogColor, factor);
        material.baseColor.rgb = fogged;

        // Depth occlusion path.
        //
        // "No depth available" must mean "occlude nothing" (#3340). ARCore reports
        // `depth_mm == 0` for every texel it could not solve — sky, thin edges, moving
        // subjects, and (crucially) EVERY texel of the 1x1 placeholder texture that is
        // bound until the first depth image lands, plus whole frames on devices where
        // depth estimation drops out mid-session.
        //
        // Feeding 0 straight into the projection puts the sample at the camera origin,
        // so `view.w` is 0 and `ndc_depth` is a division by zero: +inf, which the
        // rasterizer clamps to 1.0 when writing gl_FragDepth. Filament is reverse-Z
        // (1.0 = NEAR, 0.0 = far — see ARDepthOfField's convention note), so the camera
        // quad landed on the near plane and occluded EVERY virtual fragment exactly
        // where we knew the least about the real world. The model simply vanished.
        //
        // Substitute a far-but-finite distance for invalid texels instead. It runs
        // through the same projection as a real sample, so the result is a legal NDC
        // depth near the far plane under whatever convention the active projection
        // uses — no division by zero, no clamped infinity, and "no data" degrades to
        // "occludes nothing", which is the documented intent.
        float occlusion_depth_m = occluderDistance(depth_m, depth_valid,
                occlusionThreshold(gl_FragCoord.xy));
        vec4 view = mulMat4x4Float3(getClipFromViewMatrix(), vec3(0.f, 0.f, -occlusion_depth_m));
        float ndc_depth = view.z / view.w;
        gl_FragDepth = ndc_depth;
    }
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        material.uv0 = mulMat4x4Float3(materialParams.uvTransform, vec3(material.uv0.x, material.uv0.y, 0.f)).xy;
        vec4 clip = getPosition();
        clip.z = 0.9999f;
        material.worldPosition = mulMat4x4Float3(getWorldFromClipMatrix(), clip.xyz);
    }
}
