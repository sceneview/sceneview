{
  "_comment": "Binary 3D assets kept out of git. Each file is stored on the GitHub Release below under its sha256 and materialised at `path` by `bash tools/fetch-assets.sh`. Add or refresh an entry with `bash tools/fetch-assets.sh --register <path>`; source/licence come from assets/catalog.json (CREDITS.md stays generated from there).",
  "release": {
    "repo": "sceneview/sceneview",
    "tag": "assets-v1"
  },
  "baseUrl": "https://github.com/sceneview/sceneview/releases/download/assets-v1",
  "scopes": {
    "android": {
      "dirs": [
        "samples/android-demo/src/main/assets/models",
        "samples/android-demo/src/main/assets/environments",
        "samples/android-demo/src/main/assets/splats"
      ],
      "extensions": [
        ".glb",
        ".hdr",
        ".spz",
        ".ply"
      ]
    },
    "ios": {
      "dirs": [
        "samples/ios-demo/SceneViewDemo/Models",
        "samples/ios-demo/SceneViewDemo/Environments"
      ],
      "extensions": [
        ".usdz",
        ".hdr"
      ],
      "needs": [
        "android"
      ],
      "_why": "the iOS demo bundles ../android-demo/src/main/assets/models/shiba.glb and ../android-demo/src/main/assets/splats/raccoon_family.spz"
    },
    "tv": {
      "dirs": [
        "samples/android-tv-demo/src/main/assets/models"
      ],
      "extensions": [
        ".glb"
      ],
      "needs": [
        "android"
      ],
      "_why": "the TV app also packages ../android-demo/src/main/assets"
    },
    "web": {
      "dirs": [
        "website-static/models/platforms"
      ],
      "extensions": [
        ".glb"
      ]
    }
  },
