<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ModelSource.Url downloads the depth model on first use. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- LiteRT's `litert-api` declares these for its AI Pack downloader, which this module
         never uses. Left in, every app using ML depth would have to justify a data-sync
         foreground service on Google Play. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        tools:node="remove" />

</manifest>
