material {
    "name": "Matter steel",
    "parameters": [
        {
            "type": "float",
            "name": "squash"
        },
        {
            "type": "float2",
            "name": "rimShape"
        },
        {
            "type": "float4[8]",
            "name": "trail",
            "precision": "high"
        },
        {
            "type": "float",
            "name": "trailMode"
        },
        {
            "type": "float4",
            "name": "releaseWave",
            "precision": "high"
        },
        {
            "type": "float2",
            "name": "finger"
        },
        {
            "type": "float",
            "name": "depth"
        },
        {
            "type": "float",
            "name": "radius"
        },
        {
            "type": "float2",
            "name": "profile"
        },
        {
            "type": "float4",
            "name": "dimensions"
        },
        {
            "type": "float",
            "name": "bounce"
        },
        {
            "type": "float3",
            "name": "albedo"
        },
        {
            "type": "float",
            "name": "roughness"
        },
        {
            "type": "float",
            "name": "metallic"
        },
        {
            "type": "float",
            "name": "coat"
        },
        {
            "type": "float",
            "name": "coatRoughness"
        },
        {
            "type": "float",
            "name": "sheen"
        },
        {
            "type": "float",
            "name": "sheenRoughness"
        },
        {
            "type": "float",
            "name": "anisotropy"
        },
        {
            "type": "float4",
            "name": "ripple"
        },
        {
            "type": "float3",
            "name": "rippleColor"
        },
        {
            "type": "float",
            "name": "rippleWidth"
        },
        {
            "type": "float",
            "name": "detailBlend"
        },
        {
            "type": "sampler2d",
            "name": "detail",
            "precision": "medium"
        }
    ],
    "requires": [
        "position",
        "uv0"
    ],
    "variables": [
        "rest",
        {
            "name": "bentNormal",
            "precision": "medium"
        },
        {
            "name": "bentTangent",
            "precision": "medium"
        }
    ],
    // Atlas rows already follow the uploaded RG8 buffer; Filament otherwise flips V.
    "flipUV": false,
    "shadingModel": "lit",
    "blending": "opaque",
    "postLightingBlending": "transparent",
    "doubleSided": false,
    "specularAntiAliasing": true
}
vertex {
    #define MATTER_RIGID
    #include "matter_deformation.vs"
}
fragment {
    #include "matter_detail.fs"
    #include "matter_studio.fs"
    // hash11 from "Hash without Sine", (c) 2014 David Hoskins, MIT (see the file header):
    // no sin(), stable at highp on mobile GPUs.
    highp float steelHash(highp float x) {
        x = fract(x * 0.1031);
        x *= x + 33.33;
        x *= x + x;
        return fract(x);
    }
    // 1D value noise across the brushing; each integer cell is one groove family.
    float steelLines(highp float u) {
        highp float i = floor(u);
        float f = fract(u);
        f = f * f * (3.0 - 2.0 * f);
        return mix(steelHash(i), steelHash(i + 1.0), f) - 0.5;
    }
    void material(inout MaterialInputs material) {
        highp vec3 p = variable_rest.xyz;
        mediump vec2 detail = mix(vec2(0.5), texture(materialParams_detail, getUV0()).rg, materialParams.detailBlend);
        vec3 colour = materialParams.albedo;
        float rough = materialParams.roughness;
        vec3 n = normalize(variable_bentNormal.xyz);
        // Polished roundovers keep their geometric normal. Strong brushed bump and
        // anisotropy on the narrow front bevel made its reflection read as a dent.
        float top = smoothstep(0.75, 0.995, n.y);
        // Brushing grooves run along rest-space X. Three octaves across them, each faded
        // once it is finer than about a pixel, so the lines stay crisp but never shimmer.
        highp float across = p.z + p.y;
        highp float wobble = p.x * 0.35;
        float lines = 0.0;
        highp float u = across * 22.0 + steelLines(wobble * 3.0) * 1.5;
        lines += steelLines(u) * 0.55 * (1.0 - smoothstep(0.35, 0.9, fwidth(u)));
        u = across * 61.0 + 17.0 + steelLines(wobble * 7.0 + 5.0) * 2.0;
        lines += steelLines(u) * 0.45 * (1.0 - smoothstep(0.35, 0.9, fwidth(u)));
        u = across * 170.0 + 41.0;
        lines += steelLines(u) * 0.35 * (1.0 - smoothstep(0.35, 0.9, fwidth(u)));
        // The baked atlas keeps the slow, wide variation of the brushing pass.
        lines += (detail.r - 0.5) * 0.5;
        colour *= 1.0 + lines * 0.24;
        rough += (lines * 0.10 + (detail.g - 0.5) * 0.04) * top;
        rough = mix(max(rough, 0.38), rough, top);
        vec3 detailed = matterBump(n, lines * 0.0016 * top);
        mat3 frame = getWorldTangentFrame();
        mat3 toTangent = transpose(frame);
        material.normal = toTangent * detailed;
        // Grooves along the tangent scatter light ACROSS them: negative anisotropy
        // stretches the highlights perpendicular to the brushing, as on real brushed steel.
        vec3 groove = normalize(variable_bentTangent.xyz);
        material.anisotropyDirection = normalize(toTangent * groove);
        prepareMaterial(material);
        float cavity = variable_bentTangent.w;
        vec3 v = getWorldViewVector();
        // The finite strip supplies spatial motion on the flat top. Its long Z axis
        // spreads the highlight across the X brushing; Filament handles anisotropic IBL.
        // A broad neutral edge reflection avoids a bright/dark groove along the bevel.
        vec3 r = reflect(-v, detailed);
        vec3 studio = mix(vec3(0.30), matterStudioStrip(getUserWorldPosition(), r,
            0.65 + rough * 2.0), top);
        material.baseColor = vec4(colour * (1.0 - 0.42 * cavity), 1.0);
        material.roughness = clamp(rough, 0.045, 1.0);
        material.metallic = materialParams.metallic;
        material.reflectance = 0.5;
        material.ambientOcclusion = 1.0 - 0.72 * cavity;
        material.anisotropy = materialParams.anisotropy * top;
        material.emissive = vec4(colour * studio * (1.0 - 0.8 * cavity), 0.0);
        material.postLightingColor = matterRipple(p);
    }
}
