// Matter steel — Filament 1.77.3. Sample-only; see matter_deformation.vs and MatterDetailAtlas.kt.
material {
    "name": "Matter steel",
    "parameters": [
        {
            "type": "float",
            "name": "squash"
        },
        {
            "type": "float2",
            "name": "rimShape"
        },
        {
            "type": "float4[8]",
            "name": "trail",
            "precision": "high"
        },
        {
            "type": "float",
            "name": "trailMode"
        },
        {
            "type": "float4",
            "name": "releaseWave",
            "precision": "high"
        },
        {
            "type": "float2",
            "name": "finger"
        },
        {
            "type": "float",
            "name": "depth"
        },
        {
            "type": "float",
            "name": "radius"
        },
        {
            "type": "float4",
            "name": "profile"
        },
        {
            "type": "float4",
            "name": "dimensions"
        },
        {
            "type": "float",
            "name": "bounce"
        },
        {
            "type": "float3",
            "name": "albedo"
        },
        {
            "type": "float",
            "name": "roughness"
        },
        {
            "type": "float",
            "name": "metallic"
        },
        {
            "type": "float",
            "name": "coat"
        },
        {
            "type": "float",
            "name": "coatRoughness"
        },
        {
            "type": "float",
            "name": "sheen"
        },
        {
            "type": "float",
            "name": "sheenRoughness"
        },
        {
            "type": "float",
            "name": "anisotropy"
        },
        {
            "type": "float4",
            "name": "ripple"
        },
        {
            "type": "float3",
            "name": "rippleColor"
        },
        {
            "type": "float",
            "name": "rippleWidth"
        },
        {
            "type": "sampler2d",
            "name": "detail",
            "precision": "medium"
        }
    ],
    "requires": [
        "position",
        "uv0"
    ],
    "variables": [
        "rest",
        {
            "name": "bentNormal",
            "precision": "medium"
        },
        {
            "name": "bentTangent",
            "precision": "medium"
        }
    ],
    "shadingModel": "lit",
    "blending": "opaque",
    "postLightingBlending": "transparent",
    "doubleSided": false,
    "specularAntiAliasing": true
}
vertex {
    #define MATTER_RIGID
    #include "matter_deformation.vs"
}
fragment {
    #include "matter_detail.fs"
    void material(inout MaterialInputs material) {
        highp vec3 p = variable_rest.xyz;
        mediump vec2 detail = texture(materialParams_detail, getUV0()).rg;
        float compressed = variable_rest.w;
        float crushed = max(compressed, variable_bentNormal.w * 0.65);
        vec3 colour = materialParams.albedo;
        float rough = materialParams.roughness;
        float occlusion = 1.0, height = 0.0;
        vec3 n = normalize(variable_bentNormal.xyz);
        float footprint = fwidth((p.z + p.y) * 155.0);
        float resolved = 1.0 - smoothstep(0.45, 1.5, footprint);
        float fineResolved = 1.0 - smoothstep(0.4, 1.5, footprint * 5.0);
        float streak = detail.r - 0.5, fine = detail.g - 0.5;
        colour *= 1.0 + streak * 0.15 * resolved;
        rough += streak * 0.22 * resolved + fine * 0.07 * fineResolved;
        height = streak * 0.0010 * resolved + fine * 0.00018 * fineResolved;
        vec3 detailed = matterBump(n, height);
        mat3 toTangent = transpose(getWorldTangentFrame());
        material.normal = toTangent * detailed;
        material.anisotropyDirection = normalize(toTangent * variable_bentTangent.xyz);
        prepareMaterial(material);
        material.baseColor = vec4(colour, 1.0);
        material.roughness = clamp(rough, 0.045, 1.0);
        material.metallic = materialParams.metallic;
        material.reflectance = 0.5;
        material.ambientOcclusion = occlusion;
        material.anisotropy = materialParams.anisotropy;
        material.postLightingColor = matterRipple(p);
    }
}
