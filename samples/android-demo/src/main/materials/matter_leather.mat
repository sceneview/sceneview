// Matter leather — Filament 1.77.3. Sample-only; see matter_deformation.vs and MatterDetailAtlas.kt.
material {
    "name": "Matter leather",
    "parameters": [
        {
            "type": "float",
            "name": "squash"
        },
        {
            "type": "float2",
            "name": "rimShape"
        },
        {
            "type": "float4[8]",
            "name": "trail",
            "precision": "high"
        },
        {
            "type": "float",
            "name": "trailMode"
        },
        {
            "type": "float4",
            "name": "releaseWave",
            "precision": "high"
        },
        {
            "type": "float2",
            "name": "finger"
        },
        {
            "type": "float",
            "name": "depth"
        },
        {
            "type": "float",
            "name": "radius"
        },
        {
            "type": "float4",
            "name": "profile"
        },
        {
            "type": "float4",
            "name": "dimensions"
        },
        {
            "type": "float",
            "name": "bounce"
        },
        {
            "type": "float3",
            "name": "albedo"
        },
        {
            "type": "float",
            "name": "roughness"
        },
        {
            "type": "float",
            "name": "metallic"
        },
        {
            "type": "float",
            "name": "coat"
        },
        {
            "type": "float",
            "name": "coatRoughness"
        },
        {
            "type": "float",
            "name": "sheen"
        },
        {
            "type": "float",
            "name": "sheenRoughness"
        },
        {
            "type": "float",
            "name": "anisotropy"
        },
        {
            "type": "float4",
            "name": "ripple"
        },
        {
            "type": "float3",
            "name": "rippleColor"
        },
        {
            "type": "float",
            "name": "rippleWidth"
        },
        {
            "type": "float",
            "name": "detailBlend"
        },
        {
            "type": "sampler2d",
            "name": "detail",
            "precision": "medium"
        }
    ],
    "requires": [
        "position",
        "uv0"
    ],
    "variables": [
        "rest",
        {
            "name": "bentNormal",
            "precision": "medium"
        },
        {
            "name": "bentTangent",
            "precision": "medium"
        }
    ],
    // Atlas rows already follow the uploaded RG8 buffer; Filament otherwise flips V.
    "flipUV": false,
    "shadingModel": "lit",
    "blending": "opaque",
    "postLightingBlending": "transparent",
    "doubleSided": false,
    "specularAntiAliasing": true
}
vertex {
    #define MATTER_FOLDS
    #include "matter_deformation.vs"
}
fragment {
    #include "matter_detail.fs"
    void material(inout MaterialInputs material) {
        highp vec3 p = variable_rest.xyz;
        mediump vec2 detail = mix(vec2(0.5), texture(materialParams_detail, getUV0()).rg, materialParams.detailBlend);
        float compressed = variable_rest.w;
        float crushed = max(compressed, variable_bentNormal.w * 0.65);
        vec3 colour = materialParams.albedo;
        float rough = materialParams.roughness;
        float occlusion = 1.0, height = 0.0;
        vec3 n = normalize(variable_bentNormal.xyz);
        float footprint = length(fwidth(p * 14.0));
        float resolved = 1.0 - smoothstep(0.55, 1.5, footprint);
        float pebble = smoothstep(0.015, 0.25 + footprint * 0.12, detail.r);
        float valley = (1.0 - pebble) * resolved;
        colour *= 1.0 - 0.18 * valley;
        height = 0.0025 * pebble * resolved;
        rough += valley * 0.10;
        occlusion = 1.0 - valley * 0.10;
        vec3 detailed = matterBump(n, height);
        mat3 toTangent = transpose(getWorldTangentFrame());
        material.normal = toTangent * detailed;
        material.clearCoatNormal = toTangent * detailed;
        prepareMaterial(material);
        material.baseColor = vec4(colour, 1.0);
        material.roughness = clamp(rough, 0.045, 1.0);
        material.metallic = materialParams.metallic;
        material.reflectance = 0.5;
        material.ambientOcclusion = occlusion;
        material.clearCoat = materialParams.coat;
        material.clearCoatRoughness = materialParams.coatRoughness + valley * 0.10;
        material.postLightingColor = matterRipple(p);
    }
}
