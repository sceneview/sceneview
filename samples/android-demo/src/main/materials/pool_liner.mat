// pool_liner.mat — see CONTRIBUTING.md "Filament runtime ↔ .filamat ABI invariant"
//
// Purpose:    The inside of the in-ground pool AR demo — floor, walls and Roman steps — as it
//             looks *through* the water: the liner colour fading to blue-green with depth and
//             viewing angle, moving sun caustics bent by the ripples, a glass-mosaic waterline
//             band, dark safety nosing on the steps, contact shadow in the corners and two
//             underwater lamps that can be switched on. The water surface itself (pool_water.mat)
//             is only a thin glossy sheet; all the depth cues live here.
// Used by:    samples/android-demo ARPoolDemo — nothing in the SDK.
// Parameters:
//   linerColor   — float3, linear RGB of the dry liner (white, sand, light grey, blue).
//   waterY       — float, height of the water surface in the pool's model space (m, < 0).
//   halfWidth    — float, half the inner width; the side walls stand at x = ±halfWidth.
//   zNear, zFar  — float, z of the deep-end wall and of the shallow-end wall (zFar < zNear).
//   deepDepth    — float, floor depth at the deep end (m, positive).
//   shallowDepth — float, floor depth at the shallow end (m, positive).
//   lights       — float [0,1], the two underwater lamps: 0 off, 1 fully on.
//   daylight     — float [0,1], the share of the scene's light the liner receives: 1 by day,
//                  6 % at night (ARPoolDemo's NIGHT_LIGHT). ARCore owns the light in AR and
//                  sets it again every frame, so night is made here, on the surfaces: the base
//                  colour scales the diffuse light by daylight, specularFactor the specular
//                  light by daylight², so the glare of the day is the first thing night takes.
//                  The lamps are emission, never dimmed.
//   opacity      — float [0,1], the placement fade-in; 1 once the pool has landed.
// Fade blending with depth writes: the colour is premultiplied by the opacity, and at opacity 1
// the liner draws like an opaque surface, in the blended pass.
// Vertex colour: rgb = the model-space normal packed as n * 0.5 + 0.5, a = 1 on step nosing.
//   Shading needs the normal in the pool's own frame (tiles, caustics, lamps), which the
//   world-space normals Filament hands the fragment stage do not give once the pool turns.
// matc profile: mobile-only, OpenGL + Vulkan — demo APK asset, not an AAR asset.
material {
    "name" : "Pool Liner",
    "parameters" : [
        { "type" : "float3", "name" : "linerColor" },
        { "type" : "float",  "name" : "waterY" },
        { "type" : "float",  "name" : "halfWidth" },
        { "type" : "float",  "name" : "zNear" },
        { "type" : "float",  "name" : "zFar" },
        { "type" : "float",  "name" : "deepDepth" },
        { "type" : "float",  "name" : "shallowDepth" },
        { "type" : "float",  "name" : "lights" },
        { "type" : "float",  "name" : "daylight" },
        { "type" : "float",  "name" : "opacity" }
    ],
    "requires" : [ "position", "color" ],
    "variables" : [ { "name" : "objectPosition", "precision" : "high" } ],
    "shadingModel" : "lit",
    "blending" : "fade",
    "depthWrite" : true,
    "specularAntiAliasing" : true
}
vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        material.objectPosition = float4(getPosition().xyz, 0.0);
    }
}
fragment {
    // --- Ripples: the same five waves as pool_water.mat. Keep the two lists identical. -------
    highp float2 poolWave(highp float2 p, highp float2 direction, highp float wavelength,
            highp float steepness) {
        highp float k = 6.2831853 / wavelength;
        highp float omega = sqrt(9.81 * k) * 0.45;
        highp float phase = dot(direction, p) * k - getUserTimeMod(6.2831853 / omega) * omega;
        return direction * (steepness * cos(phase));
    }

    highp float2 poolSlope(highp float2 p) {
        highp float2 s = poolWave(p, float2(0.940, 0.342), 0.90, 0.026);
        s += poolWave(p, float2(0.819, -0.574), 0.55, 0.020);
        s += poolWave(p, float2(0.259, 0.966), 0.31, 0.015);
        s += poolWave(p, float2(-0.819, 0.574), 0.19, 0.012);
        s += poolWave(p, float2(-0.342, -0.940), 0.13, 0.008);
        return s;
    }

    // --- Hashes and cells ------------------------------------------------------------------
    highp float poolHash(highp float2 p) {
        p = fract(p * float2(0.3183099, 0.3678794) + 0.1);
        p *= 17.0;
        return fract(p.x * p.y * (p.x + p.y));
    }

    highp float2 poolHash2(highp float2 p) {
        return float2(poolHash(p), poolHash(p + float2(37.0, 11.0)));
    }

    // F2 - F1 of a drifting cell pattern: ~0 on the borders between cells, which is where the
    // light the ripples focus gathers into the familiar bright web.
    highp float causticCells(highp float2 p, highp float t) {
        highp float2 cell = floor(p);
        highp float2 f = p - cell;
        highp float f1 = 8.0;
        highp float f2 = 8.0;
        for (int j = -1; j <= 1; j++) {
            for (int i = -1; i <= 1; i++) {
                highp float2 o = float2(float(i), float(j));
                highp float2 h = poolHash2(cell + o);
                highp float2 site = o + 0.5 + 0.42 * sin(t + 6.2831853 * h);
                highp float d = length(site - f);
                if (d < f1) {
                    f2 = f1;
                    f1 = d;
                } else if (d < f2) {
                    f2 = d;
                }
            }
        }
        return f2 - f1;
    }

    float causticWeb(highp float2 p) {
        // Two layers drifting at different speeds; each time stays continuous inside sin().
        highp float t1 = getUserTimeMod(6.2831853);
        highp float t2 = getUserTimeMod(6.2831853 / 1.3) * 1.3;
        float a = 1.0 - smoothstep(0.0, 0.16, causticCells(p * 4.0, t1));
        float b = 1.0 - smoothstep(0.0, 0.16, causticCells(p * 5.7 + float2(3.1, 1.7), t2));
        return a * a * 0.6 + b * b * 0.4;
    }

    // Projected on the floor from above and on the walls from the side.
    float caustics(highp float3 p, float3 n, highp float2 shift) {
        float3 w = n * n;
        w *= w;
        w /= (w.x + w.y + w.z);
        float c = 0.0;
        if (w.y > 0.01) c += w.y * causticWeb(p.xz + shift);
        if (w.x > 0.01) c += w.x * causticWeb(p.zy + shift);
        if (w.z > 0.01) c += w.z * causticWeb(p.xy + shift);
        return c;
    }

    // --- Waterline mosaic: 2.5 cm glass tiles in two blues on light grout -------------------
    float3 waterlineBand(highp float3 p, float3 n, float3 base) {
        const float bandTop = -0.03;
        const float bandBottom = -0.21;
        const float tile = 0.025;
        const float groutHalf = 0.05;
        highp float along = abs(n.x) > abs(n.z) ? p.z : p.x;
        highp float2 uv = float2(along, p.y) / tile;
        highp float2 cell = floor(uv);
        highp float2 f = uv - cell;
        float3 glass = mix(float3(0.03, 0.12, 0.30), float3(0.06, 0.25, 0.45), poolHash(cell));
        float3 grout = float3(0.75);
        float2 fw = fwidth(uv);
        float2 inner = smoothstep(float2(groutHalf) - fw, float2(groutHalf) + fw, min(f, 1.0 - f));
        float3 mosaic = mix(grout, glass, inner.x * inner.y);
        // Past ~2 pixels per tile the grid would shimmer: settle on its average colour.
        float3 average = mix(grout, float3(0.045, 0.185, 0.375), 0.81);
        mosaic = mix(mosaic, average, smoothstep(0.25, 0.5, max(fw.x, fw.y)));
        float fy = fwidth(p.y);
        float band = smoothstep(bandBottom - fy, bandBottom + fy, p.y)
                * (1.0 - smoothstep(bandTop - fy, bandTop + fy, p.y));
        float wall = 1.0 - smoothstep(0.4, 0.6, abs(n.y));
        return mix(base, mosaic, band * wall);
    }

    float floorDepthAt(float z) {
        float along = clamp((materialParams.zNear - z) / (materialParams.zNear - materialParams.zFar),
                0.0, 1.0);
        return materialParams.deepDepth
                + (materialParams.shallowDepth - materialParams.deepDepth) * smoothstep(0.25, 0.75, along);
    }

    // Light gathered in the inside corners: by the walls on the floor and the treads, by the
    // floor at the foot of the walls, by the other wall in the vertical corners, and overall
    // with depth.
    float cornerOcclusion(highp float3 p, float3 n) {
        float a = materialParams.halfWidth;
        float toSides = a - abs(p.x);
        float toEnds = min(materialParams.zNear - p.z, p.z - materialParams.zFar);
        float ao = mix(1.0, 0.55, clamp(-p.y / materialParams.deepDepth, 0.0, 1.0));
        if (abs(n.y) > 0.5) {
            ao *= mix(0.6, 1.0, smoothstep(0.0, 0.4, min(toSides, toEnds)));
        } else {
            ao *= mix(0.6, 1.0, smoothstep(0.0, 0.4, p.y + floorDepthAt(p.z)));
            float other = abs(n.x) > abs(n.z) ? toEnds : toSides;
            ao *= mix(0.7, 1.0, smoothstep(0.0, 0.3, other));
        }
        return ao;
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        highp float3 p = variable_objectPosition.xyz;
        float4 packed = getColor();
        float3 n = normalize(packed.rgb * 2.0 - 1.0);
        float nosing = packed.a;
        float lights = materialParams.lights;
        float depth = max(materialParams.waterY - p.y, 0.0);

        float3 surface = waterlineBand(p, n, materialParams.linerColor);
        surface = mix(surface, float3(0.06, 0.08, 0.10), nosing);

        // Sun caustics, bent the way the surface above them is: stronger on the floor than on
        // the walls, softer as the water deepens, gone in the dry band.
        highp float2 shift = poolSlope(p.xz) * depth * 1.5;
        float strength = smoothstep(0.0, 0.25, depth) * mix(1.0, 0.6, depth / 1.5);
        strength *= abs(n.y) > 0.5 ? 1.0 : 0.6;
        float3 color = surface * (0.85 + 0.6 * caustics(p, n, shift) * strength);

        // Water: sunlight comes down `depth`, the view ray goes back up, refracted, and both
        // lose red first. What is lost is replaced by the colour the water scatters.
        const float3 absorption = float3(0.45, 0.09, 0.05);
        float vy = abs(getWorldViewVector().y);
        float cosRefracted = sqrt(max(1.0 - (1.0 - vy * vy) / 1.7689, 0.05));
        float3 seen = exp(-absorption * (depth / cosRefracted));
        float3 transmitted = exp(-absorption * depth) * seen;
        float3 underwater = color * transmitted + float3(0.04, 0.32, 0.38) * (1.0 - transmitted);

        float opacity = materialParams.opacity;
        float daylight = materialParams.daylight;
        material.baseColor = float4(underwater * (opacity * daylight), opacity);
        material.roughness = 0.7;
        material.reflectance = 0.3;
        // All of the specular light — the glare of the sky at grazing angles included, which no
        // reflectance reaches, since Filament's image-based light takes f90 = 1 — goes by
        // daylight², faster than the diffuse light, and is all but gone at night.
        material.specularFactor = daylight * daylight;
        material.specularColorFactor = float3(1.0);
        material.ambientOcclusion = cornerOcclusion(p, n);

        // Two lamps 40 cm under the water in the side walls, three quarters of the way from the
        // deep end to the shallow end, clear of the steps (pool_water.mat and pool_coping.mat
        // put them at the same spot). Their light loses red on its way to the liner and again
        // on the way up to the eye, so the pool turns from white-blue at the lamps to deep blue
        // at the far ends. The constant is what the liner bounces into every corner.
        if (lights > 0.0) {
            float3 lampColor = float3(0.55, 0.85, 1.0);
            float zLamp = mix(materialParams.zNear, materialParams.zFar, 0.75);
            float3 lit = float3(0.0);
            float lens = 0.0;
            for (int i = 0; i < 2; i++) {
                float side = i == 0 ? -1.0 : 1.0;
                highp float3 toLamp = float3(side * materialParams.halfWidth, -0.55, zLamp) - p;
                float d2 = dot(toLamp, toLamp);
                float d = sqrt(d2);
                float3 l = toLamp / max(d, 0.01);
                float reach = max(dot(n, l), 0.0) / (1.0 + 2.0 * d2) + exp(-d2 / 0.08) * 0.6 + 0.06;
                lit += reach * exp(-absorption * d);
                lens += 1.0 - smoothstep(0.08, 0.09, d);
            }
            lens *= step(0.5, abs(n.x));
            // The lamp glass replaces the lit liner and stays under 1: a bright lamp, never a
            // white hole burnt into the picture.
            float3 glow = mix(lit * lampColor * surface, float3(0.70, 0.88, 0.95), min(lens, 1.0));
            material.emissive = float4(glow * seen * lights, 0.0);
        }
    }
}
