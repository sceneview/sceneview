// pool_water.mat — see CONTRIBUTING.md "Filament runtime ↔ .filamat ABI invariant"
//
// Purpose:    The surface of the in-ground pool AR demo: a clear sheet of water with moving
//             ripples, the sky mirrored at grazing angles and, with the pool lights on, a halo
//             over each underwater lamp. Everything seen *through* it — the colour depth gives
//             the liner, the caustics, the wobble — is drawn by pool_liner.mat, so the surface
//             stays a thin, cheap transparent layer over the pool.
// Used by:    samples/android-demo ARPoolDemo — nothing in the SDK.
// Parameters:
//   opacity      — float [0,1], the placement fade-in; 1 once the pool has landed.
//   lights       — float [0,1], the two underwater lamps of pool_liner.mat: 0 off, 1 fully on.
//   daylight     — float [0,1], the share of the scene's light the water receives, as in
//                  pool_liner.mat: it dims the tint by daylight, the reflections and the painted
//                  sky by daylight², never the lamp halos.
//   tint         — float3, linear RGB of the water's own faint colour.
//   halfWidth    — float, half the inner width; the lamps sit in the side walls at ±halfWidth.
//   zNear, zFar  — float, z of the deep-end wall and of the shallow-end wall (zFar < zNear).
// The painted sky is a stand-in for the environment the QA preview lacks; in AR the real sky
// also arrives through ARCore's HDR reflections.
// matc profile: mobile-only, OpenGL + Vulkan — demo APK asset, not an AAR asset.
//
// The ripples are five directional sine waves summed in the pool's own (model) space, so they
// stay put on the water while the pool is moved, and scale with it. Each wave turns with
// getUserTimeMod() over its own period, so no phase ever jumps. pool_liner.mat sums the very
// same waves to bend what lies underneath: keep the two lists identical.
material {
    "name" : "Pool Water",
    "parameters" : [
        { "type" : "float",  "name" : "opacity" },
        { "type" : "float",  "name" : "lights" },
        { "type" : "float",  "name" : "daylight" },
        { "type" : "float3", "name" : "tint" },
        { "type" : "float",  "name" : "halfWidth" },
        { "type" : "float",  "name" : "zNear" },
        { "type" : "float",  "name" : "zFar" }
    ],
    "requires" : [ "position" ],
    "variables" : [ { "name" : "objectPosition", "precision" : "high" } ],
    "shadingModel" : "lit",
    "blending" : "transparent",
    "specularAntiAliasing" : true,
    "doubleSided" : false
}
vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        material.objectPosition = float4(getPosition().xyz, 0.0);
    }
}
fragment {
    // Slope (dh/dx, dh/dz) of one wave. Deep-water dispersion, slowed for a still garden pool.
    highp float2 poolWave(highp float2 p, highp float2 direction, highp float wavelength,
            highp float steepness) {
        highp float k = 6.2831853 / wavelength;
        highp float omega = sqrt(9.81 * k) * 0.45;
        highp float phase = dot(direction, p) * k - getUserTimeMod(6.2831853 / omega) * omega;
        return direction * (steepness * cos(phase));
    }

    highp float2 poolSlope(highp float2 p) {
        highp float2 s = poolWave(p, float2(0.940, 0.342), 0.90, 0.026);
        s += poolWave(p, float2(0.819, -0.574), 0.55, 0.020);
        s += poolWave(p, float2(0.259, 0.966), 0.31, 0.015);
        s += poolWave(p, float2(-0.819, 0.574), 0.19, 0.012);
        s += poolWave(p, float2(-0.342, -0.940), 0.13, 0.008);
        return s;
    }

    void material(inout MaterialInputs material) {
        highp float2 slope = poolSlope(variable_objectPosition.xz);
        // Tangent frame of the up-facing quad: T = +X, B = -Z, N = +Y.
        material.normal = normalize(float3(-slope.x, slope.y, 1.0));
        prepareMaterial(material);

        float opacity = materialParams.opacity;
        float lights = materialParams.lights;
        float daylight = materialParams.daylight;
        // How much of its own colour the water shows: a clear sheet.
        const float sheet = 0.10;
        float alpha = sheet * opacity;

        float NoV = clamp(dot(getWorldNormalVector(), getWorldViewVector()), 0.0, 1.0);
        float fresnel = pow(1.0 - NoV, 5.0);
        // Specular light, like the reflections below: it goes by daylight².
        float3 sky = float3(0.55, 0.68, 0.85) * (fresnel * 0.35 * daylight * daylight);

        // The water lights up over each lamp and fades within a metre or so of it, never as a
        // sheet over the whole pool: the rest of the glow is the liner, seen through the water.
        float3 glow = float3(0.0);
        if (lights > 0.0) {
            float zLamp = mix(materialParams.zNear, materialParams.zFar, 0.75);
            float near = 0.0;
            for (int i = 0; i < 2; i++) {
                float side = i == 0 ? -1.0 : 1.0;
                highp float3 toLamp = float3(side * materialParams.halfWidth, -0.55, zLamp)
                        - variable_objectPosition.xyz;
                near += exp(-dot(toLamp, toLamp) / 0.45);
            }
            glow = float3(0.05, 0.35, 0.45) * (0.5 * near * lights);
        }

        // Transparent blending takes a premultiplied colour.
        material.baseColor = float4(materialParams.tint * (alpha * daylight), alpha);
        material.metallic = 0.0;
        material.roughness = 0.04;
        // Water's F0 is ~0.02.
        material.reflectance = 0.35;
        // All of the specular light — the glare at grazing angles included, which no reflectance
        // reaches, since Filament's image-based light takes f90 = 1 — fades in with the pool so
        // the glints do not pop (transparent blending never fades it by alpha), and goes by
        // daylight², like pool_liner.mat's: no glare of the day is left on the water at night.
        material.specularFactor = opacity * daylight * daylight;
        material.specularColorFactor = float3(1.0);
        // This blending mode scales emission by alpha, the sheet times the fade: stated per unit
        // of sheet, the sky and the halos land at the strength written above, times the fade.
        // The halos stay local: `near` is ~0 a metre away from either lamp.
        material.emissive = float4((sky + glow) / sheet, 0.0);
    }
}
