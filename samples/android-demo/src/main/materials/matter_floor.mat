// Lit matte studio floor; analytic contact shadow avoids a dense slab shadow-map pass.
// matc 1.77.3: --optimize-size -p mobile -a opengl -a vulkan
material {
    name: "Matter floor",
    parameters: [
        { type: float3, name: contact },
        { type: float2, name: halfSize }
    ],
    requires: [position],
    variables: [floorPosition],
    shadingModel: lit
}
vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        material.floorPosition = vec4(getPosition().xyz, 0.0);
    }
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        highp vec2 p = variable_floorPosition.xz - materialParams.contact.xy;
        // Rounded rectangular footprint, with a tight contact core and soft penumbra.
        highp vec2 q = abs(p) - materialParams.halfSize + 0.10;
        float outside = max(length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - 0.10, 0.0);
        float shadow = (0.38 * exp(-outside * outside / 0.09) +
            0.30 * exp(-outside * outside / 0.70)) * materialParams.contact.z;
        // Neutral diffuse studio surface. The shared key lights it and the refracted
        // floor consistently; the dark footprint fixes the slab to its supported bottom.
        material.baseColor = vec4(vec3(0.42) * (1.0 - shadow), 1.0);
        material.roughness = 0.95;
        material.metallic = 0.0;
        material.reflectance = 0.25;
    }
}
