// Neutral studio sweep; analytic contact shadow avoids a dense slab shadow-map pass.
// matc 1.77.3: --optimize-size -p mobile -a opengl -a vulkan
material {
    name: "Matter floor",
    parameters: [
        { type: float3, name: contact },
        { type: float2, name: halfSize },
        { type: float3, name: background },
        { type: float3, name: keyPosition, precision: high },
        { type: float3, name: keyTarget, precision: high },
        { type: float2, name: keyCone },
        { type: float2, name: keyPool }
    ],
    requires: [position],
    shadingModel: unlit
}
fragment {
    #include "matter_studio.fs"
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec3 colour = matterStudioFloor(getWorldPosition(), materialParams.background,
            materialParams.keyPosition, materialParams.keyTarget, materialParams.keyCone,
            materialParams.keyPool, materialParams.contact, materialParams.halfSize);
        material.baseColor = vec4(colour, 1.0);
    }
}
