// Neutral studio sweep; analytic contact shadow avoids a dense slab shadow-map pass.
// matc 1.77.3: --optimize-size -p mobile -a opengl -a vulkan
material {
    name: "Matter floor",
    parameters: [
        { type: float3, name: contact },
        { type: float2, name: halfSize },
        { type: float3, name: background }
    ],
    requires: [position],
    variables: [floorPosition],
    shadingModel: unlit
}
vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        material.floorPosition = vec4(getPosition().xyz, 0.0);
    }
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        highp vec2 p = variable_floorPosition.xz - materialParams.contact.xy;
        // Rounded rectangular footprint, with a tight contact core and soft penumbra.
        highp vec2 q = abs(p) - materialParams.halfSize + 0.10;
        float outside = max(length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - 0.10, 0.0);
        float shadow = (0.38 * exp(-outside * outside / 0.09) +
            0.30 * exp(-outside * outside / 0.70)) * materialParams.contact.z;
        // Match the solid skybox exactly before reaching either the plane edge or far clip.
        // The sweep is 22–25% display grey under PBR Neutral, independent of key exposure.
        // Only the local studio pool and contact penumbra vary; no hard horizon can remain.
        float pool = 1.0 - smoothstep(6.0, 18.0, length(variable_floorPosition.xz));
        vec3 colour = materialParams.background * (1.0 + 0.12 * pool) * (1.0 - shadow);
        material.baseColor = vec4(colour, 1.0);
    }
}
