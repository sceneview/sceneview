// matter_gel.mat — see CONTRIBUTING.md "Filament runtime ↔ .filamat ABI invariant"
//
// Purpose:    Glossy, tinted refractive gel with sparse suspended micro-bubbles.
// Used by:    samples/android-demo FeelDemo (Matter); no SDK consumers.
// Parameters:
//   finger, depth, radius — local XZ contact, signed visual depth and well radius.
//   profile              — falloff exponent, bulge ratio, wrinkle ratio, fold count.
//   dimensions           — half width, thickness, half length, bevel radius.
//   bounce               — rigid whole-sample vertical offset, in model space.
//   albedo, roughness    — linear physical constants from MatterSurfaces, never UI tokens.
//   ior, transmission    — physical gel constants. No sheen: Filament forbids it with refraction.
// Cubemap refraction samples the showroom IBL, not the floor/objects behind the gel.
// matc profile: --optimize-size -p mobile -a opengl -a vulkan (Filament 1.77.3).
material {
    "name": "Matter gel",
    "parameters": [
        {
            "type": "float2",
            "name": "finger"
        },
        {
            "type": "float",
            "name": "depth"
        },
        {
            "type": "float",
            "name": "radius"
        },
        {
            "type": "float4",
            "name": "profile"
        },
        {
            "type": "float4",
            "name": "dimensions"
        },
        {
            "type": "float",
            "name": "bounce"
        },
        {
            "type": "float3",
            "name": "albedo"
        },
        {
            "type": "float",
            "name": "roughness"
        },
        {
            "type": "float",
            "name": "ior"
        },
        {
            "type": "float",
            "name": "transmission"
        }
    ],
    "requires": [
        "position",
        "uv0"
    ],
    "variables": [
        "rest",
        "bentNormal",
        "bentTangent"
    ],
    "shadingModel": "lit",
    "blending": "transparent",
    "doubleSided": false,
    "specularAntiAliasing": true,
    "refractionMode": "cubemap",
    "refractionType": "solid"
}
vertex {
    // KEEP IN SYNC: this vertex block is duplicated in matter_surface.mat and matter_gel.mat.
    // Only uniforms move the static rest mesh. Its bottom has zero displacement weight.
    float dentField(vec2 p) {
        vec2 q = (p - materialParams.finger) / materialParams.radius;
        float r = length(q);
        float bowl = exp(-2.0 * pow(r, materialParams.profile.x));
        float rim = exp(-pow((r - 1.05) * 3.8, 2.0)) * smoothstep(0.0, 0.35, r);
        float folds = 0.0;
        if (materialParams.profile.z > 0.0) {
            float angle = r > 0.0001 ? atan(q.y, q.x) : 0.0;
            folds = cos(angle * materialParams.profile.w + r * 4.0) * r * r * exp(-2.0 * r * r);
        }
        return materialParams.depth * (-bowl + materialParams.profile.y * rim +
            materialParams.profile.z * folds);
    }
    void materialVertex(inout MaterialVertexInputs material) {
        highp vec3 p = getPosition().xyz;
        vec3 halfSize = vec3(materialParams.dimensions.x, materialParams.dimensions.y * 0.5,
            materialParams.dimensions.z);
        vec3 centred = p + vec3(0.0, halfSize.y, 0.0);
        vec3 core = clamp(centred, -halfSize + materialParams.dimensions.w,
            halfSize - materialParams.dimensions.w);
        vec3 n = normalize(centred - core);
        vec3 axis = abs(n.x) < 0.9 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 0.0, 1.0);
        vec3 t = normalize(axis - n * dot(axis, n));
        float weight = clamp(1.0 + p.y / materialParams.dimensions.y, 0.0, 1.0);
        float field = 0.0;
        if (abs(materialParams.depth) > 0.000001) {
            field = dentField(p.xz);
            // Central differences of the SAME displacement, not a second approximate well.
            const float e = 0.002;
            float gx = (dentField(p.xz + vec2(e, 0.0)) - dentField(p.xz - vec2(e, 0.0))) / (2.0 * e) * weight;
            float gz = (dentField(p.xz + vec2(0.0, e)) - dentField(p.xz - vec2(0.0, e))) / (2.0 * e) * weight;
            float gy = max(0.15, 1.0 + field / materialParams.dimensions.y);
            // Inverse-transpose Jacobian for the normal, Jacobian for the brushing tangent.
            n = normalize(vec3(n.x - gx * n.y / gy, n.y / gy, n.z - gz * n.y / gy));
            t = normalize(vec3(t.x, gx * t.x + gy * t.y + gz * t.z, t.z));
        }
        material.worldPosition.xyz += mat3(getWorldFromModelMatrix()) *
            vec3(0.0, weight * field + materialParams.bounce, 0.0);
        material.rest = vec4(p, clamp(-field / materialParams.dimensions.y, 0.0, 1.0));
        material.bentNormal = vec4(normalize(getWorldFromModelNormalMatrix() * n), 0.0);
        material.bentTangent = vec4(normalize(mat3(getWorldFromModelMatrix()) * t), 0.0);
        // Keep Filament's original orthonormal TBN for the fragment's world → tangent mapping.
        // The deformed N/T above drive normal, clearCoatNormal and anisotropyDirection there.
    }
}
fragment {
    highp vec3 bubbleHash(highp vec3 p) {
        p = fract(p * vec3(0.1031, 0.1030, 0.0973));
        p += dot(p, p.yxz + 33.33);
        return fract((p.xxy + p.yxx) * p.zyx);
    }
    void material(inout MaterialInputs material) {
        highp vec3 p = variable_rest.xyz;
        // Two sparse layers beneath the surface. View parallax makes these read as inclusions,
        // not painted dots; rest coordinates keep them attached during deformation.
        vec3 eye = getWorldViewVector();
        float bubbles = 0.0;
        for (int layer = 0; layer < 2; layer++) {
            float depth = 0.035 + float(layer) * 0.075;
            vec2 q = (p.xz + eye.xz / max(abs(eye.y), 0.3) * depth) * 18.0;
            vec3 cell = vec3(floor(q), float(layer));
            vec3 h = bubbleHash(cell);
            vec2 delta = fract(q) - mix(vec2(0.2), vec2(0.8), h.xy);
            float d = length(delta);
            float aa = max(fwidth(d), 0.01);
            float rim = 1.0 - smoothstep(0.012, 0.012 + aa, abs(d - 0.075));
            bubbles += rim * step(0.94, h.z) * (1.0 - float(layer) * 0.45);
        }
        vec3 n = normalize(variable_bentNormal.xyz);
        material.normal = transpose(getWorldTangentFrame()) * n;
        prepareMaterial(material);
        material.baseColor = vec4(mix(materialParams.albedo, vec3(0.95), bubbles * 0.3), 1.0);
        material.metallic = 0.0;
        material.roughness = materialParams.roughness + bubbles * 0.12;
        material.ior = materialParams.ior;
        material.transmission = materialParams.transmission * (1.0 - bubbles * 0.35);
        material.thickness = materialParams.dimensions.y * (1.0 - variable_rest.w);
    }
}
