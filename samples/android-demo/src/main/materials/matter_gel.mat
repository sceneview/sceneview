// matter_gel.mat — see CONTRIBUTING.md "Filament runtime ↔ .filamat ABI invariant"
//
// Purpose:    Clear, lightly tinted gel with a smooth refractive finger well.
// Used by:    samples/android-demo FeelDemo (Matter); no SDK consumers.
// Parameters:
//   finger, depth, radius — local XZ contact, signed visual depth and well radius.
//   profile              — falloff exponent and broad rim height relative to depth.
//   rimShape             — radial peak and width, relative to the dent radius.
//   trail[8], trailMode  — XZ, strength, inverse width²; 0 off, 1 foam groove, 2 velvet pile.
//   releaseWave          — gel release XZ, age in seconds, damped amplitude.
//   dimensions           — half width, thickness, half length, bevel radius.
//   bounce, squash       — rigid vertical offset and supported opening compression, in model space.
//   albedo, roughness    — linear physical constants from MatterSurfaces, never UI tokens.
//   ior, transmission    — physical gel constants. No sheen: Filament forbids it with refraction.
//   absorption           — Beer-Lambert RGB coefficients per model-space unit.
// Screen-space transmission includes the showroom floor; absorption colours the volume.
// Cost: the existing Filament scene-colour resolve/mips and an analytic box exit; no ray march.
// matc profile: --optimize-size -p mobile -a opengl -a vulkan (Filament 1.77.3).
material {
    "name": "Matter gel",
    "parameters": [
        { "type": "float", "name": "squash" },
        { "type": "float2", "name": "rimShape" },
        { "type": "float4[8]", "name": "trail", "precision": "high" },
        { "type": "float", "name": "trailMode" },
        { "type": "float4", "name": "releaseWave", "precision": "high" },
        {
            "type": "float2",
            "name": "finger"
        },
        {
            "type": "float",
            "name": "depth"
        },
        {
            "type": "float",
            "name": "radius"
        },
        {
            "type": "float2",
            "name": "profile"
        },
        {
            "type": "float4",
            "name": "dimensions"
        },
        {
            "type": "float",
            "name": "bounce"
        },
        {
            "type": "float3",
            "name": "albedo"
        },
        {
            "type": "float",
            "name": "roughness"
        },
        {
            "type": "float",
            "name": "ior"
        },
        {
            "type": "float",
            "name": "transmission"
        },
        {
            "type": "float3",
            "name": "absorption"
        }
    ],
    "requires": [
        "position",
        "uv0"
    ],
    "variables": [
        "rest",
        "bentNormal",
        "bentTangent"
    ],
    "shadingModel": "lit",
    "blending": "transparent",
    "doubleSided": false,
    "specularAntiAliasing": true,
    "refractionMode": "screenspace",
    "refractionType": "solid"
}
vertex {
    #define MATTER_GEL
    #define MATTER_RELEASE_WAVE
    #include "matter_deformation.vs"
}
fragment {
    void material(inout MaterialInputs material) {
        highp vec3 p = variable_rest.xyz;
        p.y += variable_rest.w;
        vec3 n = normalize(variable_bentNormal.xyz);
        // Matter only translates its slabs: world and rest-space axes coincide.
        // Find the refracted ray's exit from the supported slab with three plane distances.
        // The displaced entry includes the well and raised rim. Retain the full path through
        // the sides instead of artificially thinning every edge to 22% as in v14.
        vec3 ray = refract(-getWorldViewVector(), n, 1.0 / materialParams.ior);
        highp vec3 halfSize = vec3(materialParams.dimensions.x,
            materialParams.dimensions.y * 0.5, materialParams.dimensions.z);
        highp vec3 centred = p + vec3(0.0, halfSize.y, 0.0);
        highp vec3 exitDistance = (halfSize - sign(ray) * centred) / max(abs(ray), vec3(0.0001));
        float path = max(0.02, min(exitDistance.x, min(exitDistance.y, exitDistance.z)));
        material.normal = transpose(getWorldTangentFrame()) * n;
        prepareMaterial(material);
        material.baseColor = vec4(materialParams.albedo, 1.0);
        material.metallic = 0.0;
        material.roughness = materialParams.roughness;
        material.ior = materialParams.ior;
        material.transmission = materialParams.transmission;
        material.absorption = materialParams.absorption;
        // Filament 1.77 solid refraction uses d = thickness * -dot(n, ray). Convert the
        // slab path to that convention, so both absorption and the floor lookup use it.
        // The smooth concave normal gathers the key reflection into a bright well highlight.
        material.thickness = path / max(-dot(n, ray), 0.2);
        material.ambientOcclusion = 1.0;
    }
}
