// matter_gel.mat — see CONTRIBUTING.md "Filament runtime ↔ .filamat ABI invariant"
//
// Purpose:    Clear, lightly tinted gel with a smooth refractive finger well.
// Used by:    samples/android-demo FeelDemo (Matter); no SDK consumers.
// Parameters:
//   finger, depth, radius — local XZ contact, signed visual depth and well radius.
//   profile              — falloff exponent and broad rim height relative to depth.
//   rimShape             — radial peak and width, relative to the dent radius.
//   trail[8], trailMode  — XZ, strength, inverse width²; 0 off, 1 foam groove, 2 velvet pile.
//   releaseWave          — gel release XZ, age in seconds, damped amplitude.
//   dimensions           — half width, thickness, half length, bevel radius.
//   bounce, squash       — rigid vertical offset and supported opening compression, in model space.
//   albedo, roughness    — linear physical constants from MatterSurfaces, never UI tokens.
//   ior, transmission    — dielectric interface and transmitted fraction.
//   absorption           — Beer-Lambert RGB coefficients per model-space unit.
//   background, key*, contact — same analytic studio radiance as matter_floor.mat.
// The studio floor is the only transmitted object in this demo. Intersect it in world
// space instead of projecting a box exit into the opaque screen-colour buffer. That
// projection folds the contact footprint into the well when the exit changes planes.
// Cost: one analytic floor sample; no scene-colour resolve/mips, texture or ray march.
// matc profile: --optimize-size -p mobile -a opengl -a vulkan (Filament 1.77.3).
material {
    "name": "Matter gel",
    "parameters": [
        { "type": "float3", "name": "background" },
        { "type": "float3", "name": "keyPosition", "precision": "high" },
        { "type": "float3", "name": "keyTarget", "precision": "high" },
        { "type": "float2", "name": "keyCone" },
        { "type": "float2", "name": "keyPool" },
        { "type": "float3", "name": "contact" },
        { "type": "float", "name": "squash" },
        { "type": "float2", "name": "rimShape" },
        { "type": "float4[8]", "name": "trail", "precision": "high" },
        { "type": "float", "name": "trailMode" },
        { "type": "float4", "name": "releaseWave", "precision": "high" },
        {
            "type": "float2",
            "name": "finger"
        },
        {
            "type": "float",
            "name": "depth"
        },
        {
            "type": "float",
            "name": "radius"
        },
        {
            "type": "float2",
            "name": "profile"
        },
        {
            "type": "float4",
            "name": "dimensions"
        },
        {
            "type": "float",
            "name": "bounce"
        },
        {
            "type": "float3",
            "name": "albedo"
        },
        {
            "type": "float",
            "name": "roughness"
        },
        {
            "type": "float",
            "name": "ior"
        },
        {
            "type": "float",
            "name": "transmission"
        },
        {
            "type": "float3",
            "name": "absorption"
        }
    ],
    "requires": [
        "position",
        "uv0"
    ],
    "variables": [
        "rest",
        "bentNormal",
        "bentTangent"
    ],
    "shadingModel": "lit",
    "blending": "opaque",
    "doubleSided": false,
    "specularAntiAliasing": true
}
vertex {
    #define MATTER_GEL
    #define MATTER_RELEASE_WAVE
    #include "matter_deformation.vs"
}
fragment {
    #include "matter_studio.fs"
    void material(inout MaterialInputs material) {
        highp vec3 p = variable_rest.xyz;
        p.y += variable_rest.w;
        vec3 n = normalize(variable_bentNormal.xyz);
        vec3 v = getWorldViewVector();
        vec3 ray = refract(-v, n, 1.0 / materialParams.ior);
        // A single supported plane gives the well one continuous lens. Signed rest.w
        // is still required: dents shorten the optical column and raised rims lengthen it.
        // The grazing guard only bounds nearly horizontal rays on the vertical bevel.
        float down = max(-ray.y, 0.25);
        float path = max(p.y + materialParams.dimensions.y, 0.002) / down;
        highp vec3 world = getWorldPosition();
        float floorDistance = max(world.y - materialParams.keyTarget.y, 0.002) / down;
        highp vec2 floorXZ = world.xz + ray.xz * floorDistance;
        highp vec3 floorPoint = vec3(floorXZ.x, materialParams.keyTarget.y, floorXZ.y);
        vec3 transmitted = matterStudioFloor(floorPoint, materialParams.background,
            materialParams.keyPosition, materialParams.keyTarget, materialParams.keyCone,
            materialParams.keyPool, materialParams.contact, materialParams.dimensions.xz);
        transmitted *= exp(-materialParams.absorption * path) * materialParams.albedo;
        float f0 = (materialParams.ior - 1.0) / (materialParams.ior + 1.0);
        f0 *= f0;
        float fresnel = f0 + (1.0 - f0) * pow(1.0 - max(dot(n, v), 0.0), 5.0);
        material.normal = transpose(getWorldTangentFrame()) * n;
        prepareMaterial(material);
        // Opaque depth selects the nearest surface of the concave well. Transmission
        // is the actual analytic floor radiance, not overlapping transparent layers.
        material.baseColor = vec4(0.0, 0.0, 0.0, 1.0);
        material.metallic = 0.0;
        material.roughness = materialParams.roughness;
        material.ior = materialParams.ior;
        // w=0 keeps the pre-exposed floor sample identical to the unlit floor outside.
        material.emissive = vec4(transmitted * ((1.0 - fresnel) * materialParams.transmission), 0.0);
        material.ambientOcclusion = 1.0;
    }
}
