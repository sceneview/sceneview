// matter_gel.mat — see CONTRIBUTING.md "Filament runtime ↔ .filamat ABI invariant"
//
// Purpose:    Clear aqua gel with a smooth refractive finger well and caustics.
// Used by:    samples/android-demo FeelDemo (Matter); no SDK consumers.
// Parameters:
//   finger, depth, radius — local XZ contact, signed visual depth and well radius.
//   profile              — falloff exponent and broad rim height relative to depth.
//   rimShape             — radial peak and width, relative to the dent radius.
//   trail[8], trailMode  — XZ, strength, inverse width²; 0 off, 1 foam groove, 2 velvet pile.
//   releaseWave          — gel release XZ, age in seconds, damped amplitude.
//   dimensions           — half width, thickness, half length, bevel radius.
//   bounce, squash       — rigid vertical offset and supported opening compression, in model space.
//   albedo, roughness    — linear physical constants from MatterSurfaces, never UI tokens.
//   ior, transmission    — dielectric interface and transmitted fraction.
//   absorption           — Beer-Lambert RGB coefficients per model-space unit.
//   background, key*, contact — same analytic studio radiance as matter_floor.mat.
// The studio floor is the only transmitted geometry in this demo. Intersect it in world
// space instead of projecting a box exit into the opaque screen-colour buffer. That
// projection folds the contact footprint into the well when the exit changes planes.
// Cost: one analytic floor sample, two analytic strip samples and one caustic footprint;
// no scene-colour resolve/mips, texture or ray march.
// matc profile: --optimize-size -p mobile -a opengl -a vulkan (Filament 1.77.3).
material {
    "name": "Matter gel",
    "parameters": [
        { "type": "float3", "name": "background" },
        { "type": "float3", "name": "keyPosition", "precision": "high" },
        { "type": "float3", "name": "keyTarget", "precision": "high" },
        { "type": "float2", "name": "keyCone" },
        { "type": "float2", "name": "keyPool" },
        { "type": "float3", "name": "contact" },
        { "type": "float", "name": "squash" },
        { "type": "float2", "name": "rimShape" },
        { "type": "float4[8]", "name": "trail", "precision": "high" },
        { "type": "float", "name": "trailMode" },
        { "type": "float4", "name": "releaseWave", "precision": "high" },
        {
            "type": "float2",
            "name": "finger"
        },
        {
            "type": "float",
            "name": "depth"
        },
        {
            "type": "float",
            "name": "radius"
        },
        {
            "type": "float2",
            "name": "profile"
        },
        {
            "type": "float4",
            "name": "dimensions"
        },
        {
            "type": "float",
            "name": "bounce"
        },
        {
            "type": "float3",
            "name": "albedo"
        },
        {
            "type": "float",
            "name": "roughness"
        },
        {
            "type": "float",
            "name": "ior"
        },
        {
            "type": "float",
            "name": "transmission"
        },
        {
            "type": "float3",
            "name": "absorption"
        }
    ],
    "requires": [
        "position",
        "uv0"
    ],
    "variables": [
        "rest",
        "bentNormal",
        "bentTangent"
    ],
    "shadingModel": "lit",
    "blending": "opaque",
    "doubleSided": false,
    "specularAntiAliasing": true
}
vertex {
    #define MATTER_GEL
    #define MATTER_RELEASE_WAVE
    #include "matter_deformation.vs"
}
fragment {
    #include "matter_studio.fs"
    void material(inout MaterialInputs material) {
        highp vec3 p = variable_rest.xyz;
        p.y += variable_rest.w;
        vec3 n = normalize(variable_bentNormal.xyz);
        vec3 v = getWorldViewVector();
        vec3 ray = refract(-v, n, 1.0 / materialParams.ior);
        // A single supported plane gives the well one continuous lens. Signed rest.w
        // is still required: dents shorten the optical column and raised rims lengthen it.
        // The grazing guard only bounds nearly horizontal rays on the vertical bevel.
        float down = max(-ray.y, 0.25);
        // Bound absorption by the first side/bottom exit, not an infinite optical
        // column. Matter slabs translate but never rotate, so ray.xz is also local XZ.
        vec2 sideDistance = (materialParams.dimensions.xz - sign(ray.xz) * p.xz) /
            max(abs(ray.xz), vec2(0.001));
        float bottomDistance = max(p.y + materialParams.dimensions.y, 0.002) / max(-ray.y, 0.001);
        float path = max(min(bottomDistance, min(sideDistance.x, sideDistance.y)), 0.002);
        // API world space, like the floor: the key, pool and contact are not camera-relative.
        highp vec3 world = getUserWorldPosition();
        float floorDistance = max(world.y - materialParams.keyTarget.y, 0.002) / down;
        highp vec2 floorXZ = world.xz + ray.xz * floorDistance;
        highp vec3 floorPoint = vec3(floorXZ.x, materialParams.keyTarget.y, floorXZ.y);
        // Flat top only (rest normal, as in the vertex stage): on the bevel the quad
        // derivatives are too coarse and the ratio crawls along the edge as dots.
        vec3 halfSize = vec3(materialParams.dimensions.x, materialParams.dimensions.y * 0.5,
            materialParams.dimensions.z);
        vec3 centred = variable_rest.xyz + vec3(0.0, halfSize.y, 0.0);
        vec3 rested = normalize(centred - clamp(centred, -halfSize + materialParams.dimensions.w,
            halfSize - materialParams.dimensions.w) + vec3(0.0, 1e-5, 0.0));
        float top = smoothstep(0.92, 0.995, rested.y);
        vec3 transmitted = matterStudioFloor(floorPoint, materialParams.background,
            materialParams.keyPosition, materialParams.keyTarget, materialParams.keyCone,
            materialParams.keyPool,
            // Through a wall the ray lands beside the slab, on the caustic's edge: keep the
            // caustic to rays that entered through the top, or that edge draws a seam.
            vec3(materialParams.contact.xy, materialParams.contact.z * top),
            materialParams.dimensions.xz);
        // Caustic: the key refracted by the top lands on the floor; its footprint per
        // surface area (screen derivatives) focuses the light under a dent or a wave.
        // A flat top gives exactly 1. Only the top, where the area ratio is defined.
        highp vec3 keyRay = refract(normalize(world - materialParams.keyPosition), n, 1.0 / materialParams.ior);
        highp vec2 lit = world.xz + keyRay.xz * (max(world.y - materialParams.keyTarget.y, 0.002) /
            max(-keyRay.y, 0.25));
        highp vec2 sx = dFdx(world.xz), sy = dFdy(world.xz), lx = dFdx(lit), ly = dFdy(lit);
        highp float surfaceArea = abs(sx.x * sy.y - sx.y * sy.x);
        highp float floorArea = abs(lx.x * ly.y - lx.y * ly.x);
        float focus = clamp(surfaceArea / max(floorArea, surfaceArea * 0.2 + 1e-12), 0.0, 4.0);
        // On the steep wall of a deep well the normal turns faster than a 2x2 quad can
        // sample: the ratio then follows the mesh triangles and speckles. Fade it to flat
        // where the normal changes by more than ~0.02 per pixel; the dent's floor keeps it.
        float turn = length(fwidth(n));
        focus = mix(focus, 1.0, smoothstep(0.02, 0.08, turn));
        // An off-camera neutral bounce card fills the vertical faces. The midnight
        // floor alone made a clear interface read as an opaque black-green block.
        // Keep the continuous floor projection in the well: never switch exit planes
        // for that sample, which would fold a box-shaped seam through the refraction.
        // Light entering through the lit top scatters down the column, so the walls glow
        // brighter toward the top edge, faintly aqua: a block of jelly, not a grey wall.
        float rise = smoothstep(-materialParams.dimensions.y, 0.0, p.y);
        vec3 card = mix(vec3(0.15, 0.20, 0.22), vec3(0.46, 0.55, 0.56), rise * rise);
        transmitted = mix(card, transmitted, mix(0.30, 1.0, top));
        // A bottom-reflected strip supplies internal glints. Fade it when the ray
        // exits a side first; no additional geometry, scene-colour pass or ray march.
        vec3 internalRay = vec3(ray.x, -ray.y, ray.z);
        // Wide on purpose: a narrow switch drew the side/bottom exit boundary as a hard
        // diagonal across the top and down the front face.
        // Rays entering through a wall skip both exit-dependent terms: there the side/bottom
        // switch drew a hard vertical seam down the front face.
        float bottomReflection = smoothstep(-0.35, 0.9, min(sideDistance.x, sideDistance.y) - bottomDistance) * top;
        transmitted += 0.28 * bottomReflection *
            matterStudioStrip(world + ray * bottomDistance, internalRay, 0.75);
        // Unit gain at rest; stronger bright/dark pairs make release ripples legible.
        transmitted *= mix(1.0, 0.3 + 0.7 * focus * sqrt(focus), top);
        transmitted *= exp(-materialParams.absorption * mix(1.2, path, top)) * materialParams.albedo;
        float f0 = (materialParams.ior - 1.0) / (materialParams.ior + 1.0);
        f0 *= f0;
        float fresnel = f0 + (1.0 - f0) * pow(1.0 - max(dot(n, v), 0.0), 5.0);
        material.normal = transpose(getWorldTangentFrame()) * n;
        prepareMaterial(material);
        // Opaque depth selects the nearest surface of the concave well. Transmission
        // is the actual analytic floor radiance, not overlapping transparent layers.
        material.baseColor = vec4(0.0, 0.0, 0.0, 1.0);
        material.metallic = 0.0;
        // The walls are flat mirrors of the studio HDR: at the top's roughness they
        // showed a softbox's hard rounded edge as a seam down the front face.
        material.roughness = mix(0.34, materialParams.roughness, top);
        material.ior = materialParams.ior;
        // w=0 keeps the pre-exposed floor sample identical to the unlit floor outside.
        vec3 interfaceLight = matterStudioStrip(world, reflect(-v, n), 0.65);
        material.emissive = vec4(transmitted * ((1.0 - fresnel) * materialParams.transmission) +
            interfaceLight * fresnel, 0.0);
        material.ambientOcclusion = 1.0;
    }
}
