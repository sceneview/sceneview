// Matter soft — Filament 1.77.3. Sample-only; see matter_deformation.vs and MatterDetailAtlas.kt.
material {
    "name": "Matter soft",
    "parameters": [
        { "type": "float3", "name": "imprint", "precision": "high" },
        {
            "type": "float",
            "name": "squash"
        },
        {
            "type": "float2",
            "name": "rimShape"
        },
        {
            "type": "float4[8]",
            "name": "trail",
            "precision": "high"
        },
        {
            "type": "float",
            "name": "trailMode"
        },
        {
            "type": "float4",
            "name": "releaseWave",
            "precision": "high"
        },
        {
            "type": "float2",
            "name": "finger"
        },
        {
            "type": "float",
            "name": "depth"
        },
        {
            "type": "float",
            "name": "radius"
        },
        {
            "type": "float4",
            "name": "profile"
        },
        {
            "type": "float4",
            "name": "dimensions"
        },
        {
            "type": "float",
            "name": "bounce"
        },
        {
            "type": "float3",
            "name": "albedo"
        },
        {
            "type": "float",
            "name": "roughness"
        },
        {
            "type": "float",
            "name": "metallic"
        },
        {
            "type": "float",
            "name": "coat"
        },
        {
            "type": "float",
            "name": "coatRoughness"
        },
        {
            "type": "float",
            "name": "sheen"
        },
        {
            "type": "float",
            "name": "sheenRoughness"
        },
        {
            "type": "float",
            "name": "anisotropy"
        },
        {
            "type": "float4",
            "name": "ripple"
        },
        {
            "type": "float3",
            "name": "rippleColor"
        },
        {
            "type": "float",
            "name": "rippleWidth"
        },
        {
            "type": "float",
            "name": "detailBlend"
        },
        {
            "type": "sampler2d",
            "name": "detail",
            "precision": "medium"
        }
    ],
    "requires": [
        "position",
        "uv0"
    ],
    "variables": [
        "rest",
        {
            "name": "bentNormal",
            "precision": "medium"
        },
        {
            "name": "bentTangent",
            "precision": "medium"
        }
    ],
    // Atlas rows already follow the uploaded RG8 buffer; Filament otherwise flips V.
    "flipUV": false,
    "shadingModel": "lit",
    "blending": "opaque",
    "postLightingBlending": "transparent",
    "doubleSided": false,
    "specularAntiAliasing": true
}
vertex {
    #define MATTER_TRAIL
    #include "matter_deformation.vs"
}
fragment {
    #include "matter_detail.fs"
    void material(inout MaterialInputs material) {
        highp vec3 p = variable_rest.xyz;
        mediump vec2 detail = mix(vec2(0.5), texture(materialParams_detail, getUV0()).rg, materialParams.detailBlend);
        float compressed = variable_rest.w;
        float crushed = max(compressed, variable_bentNormal.w * 0.65);
        vec3 colour = materialParams.albedo;
        float rough = materialParams.roughness;
        float occlusion = 1.0, height = 0.0;
        vec3 n = normalize(variable_bentNormal.xyz);
        // The wall transition is only 0.175 of a cell. Fade its bump before that band
        // becomes subpixel; waiting for an entire cell to disappear shimmers with a 1-tap bake.
        highp vec3 cells = p * 32.0;
        float footprint = max(length(dFdx(cells)), length(dFdy(cells)));
        float resolved = 1.0 - smoothstep(0.0875, 0.35, footprint);
        float wall = detail.r * resolved;
        colour *= (0.982 + 0.018 * wall) * (1.0 - 0.035 * compressed);
        occlusion = 0.98 + 0.02 * wall;
        height = 0.0030 * wall * (1.0 - 0.65 * compressed);
        if (materialParams.imprint.z > 0.001) {
            // A 9 x 12 mm pad at WORLD_PER_MM=.025, with a faint off-centre whorl.
            // Derivatives suppress ridge detail before it becomes subpixel at dynamic resolution.
            highp vec2 pad = (p.xz - materialParams.imprint.xy) / vec2(0.1125, 0.15);
            float padRadius = length(pad);
            float padMask = (1.0 - smoothstep(0.65, 1.0, padRadius)) *
                smoothstep(-materialParams.dimensions.w, -0.005, p.y) * materialParams.imprint.z;
            float whorl = length(pad + vec2(0.13 * pad.y * pad.y, 0.10));
            float phase = whorl * 31.4;
            float ridgeAA = 1.0 - smoothstep(0.7, 2.5, fwidth(phase));
            height += padMask * (-0.002 + 0.0012 * sin(phase) * ridgeAA);
            colour *= 1.0 - 0.045 * padMask;
            rough -= 0.035 * padMask;
        }
        vec3 detailed = matterBump(n, height);
        mat3 toTangent = transpose(getWorldTangentFrame());
        material.normal = toTangent * detailed;
        prepareMaterial(material);
        // Cavity stays legible under direct light; AO separately attenuates the IBL.
        float cavity = variable_bentTangent.w;
        material.baseColor = vec4(colour * (1.0 - 0.42 * cavity), 1.0);
        material.roughness = clamp(rough, 0.045, 1.0);
        material.metallic = materialParams.metallic;
        material.reflectance = 0.5;
        material.ambientOcclusion = occlusion * (1.0 - 0.72 * cavity);
        material.postLightingColor = matterRipple(p);
    }
}
