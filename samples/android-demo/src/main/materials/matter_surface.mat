// matter_surface.mat — see CONTRIBUTING.md "Filament runtime ↔ .filamat ABI invariant"
//
// Purpose:    Rest-space procedural foam, velvet, leather, marble and brushed steel.
// Used by:    samples/android-demo FeelDemo (Matter); no SDK consumers.
// Parameters:
//   finger, depth, radius — local XZ contact, signed visual depth and well radius.
//   profile              — falloff exponent, bulge ratio, wrinkle ratio, fold count.
//   rimShape             — radial peak and width, relative to the dent radius.
//   trail[8], trailMode  — XZ, strength, inverse width²; 0 off, 1 foam groove, 2 velvet pile.
//   releaseWave          — gel release XZ, age in seconds, damped amplitude.
//   dimensions           — half width, thickness, half length, bevel radius.
//   bounce, squash       — rigid vertical offset and supported opening compression, in model space.
//   albedo, roughness    — linear physical constants from MatterSurfaces, never UI tokens.
//   surface              — FeelMaterial ordinal (0 foam, 2 velvet, 3 leather, 4 marble, 5 steel).
//   metallic, coat, coatRoughness, sheen, sheenRoughness, anisotropy — physical finish constants.
//   ripple               — rigid contact XZ, expanding radius, opacity; zero opacity disables.
//   rippleColor, rippleWidth — theme primary in scene-linear light; model-space hairline.
// matc profile: --optimize-size -p mobile -a opengl -a vulkan (Filament 1.77.3).
material {
    "name": "Matter surface",
    "parameters": [
        { "type": "float", "name": "squash" },
        { "type": "float2", "name": "rimShape" },
        { "type": "float4[8]", "name": "trail", "precision": "high" },
        { "type": "float", "name": "trailMode" },
        { "type": "float4", "name": "releaseWave", "precision": "high" },
        {
            "type": "float2",
            "name": "finger"
        },
        {
            "type": "float",
            "name": "depth"
        },
        {
            "type": "float",
            "name": "radius"
        },
        {
            "type": "float4",
            "name": "profile"
        },
        {
            "type": "float4",
            "name": "dimensions"
        },
        {
            "type": "float",
            "name": "bounce"
        },
        {
            "type": "float3",
            "name": "albedo"
        },
        {
            "type": "float",
            "name": "roughness"
        },
        {
            "type": "float",
            "name": "surface"
        },
        {
            "type": "float",
            "name": "metallic"
        },
        {
            "type": "float",
            "name": "coat"
        },
        {
            "type": "float",
            "name": "coatRoughness"
        },
        {
            "type": "float",
            "name": "sheen"
        },
        {
            "type": "float",
            "name": "sheenRoughness"
        },
        {
            "type": "float",
            "name": "anisotropy"
        },
        {
            "type": "float4",
            "name": "ripple"
        },
        {
            "type": "float3",
            "name": "rippleColor"
        },
        {
            "type": "float",
            "name": "rippleWidth"
        }
    ],
    "requires": [
        "position",
        "uv0"
    ],
    "variables": [
        "rest",
        "bentNormal",
        "bentTangent"
    ],
    "shadingModel": "lit",
    "blending": "opaque",
    "postLightingBlending": "transparent",
    "doubleSided": false,
    "specularAntiAliasing": true
}
vertex {
    // KEEP IN SYNC: this vertex block is duplicated in matter_surface.mat and matter_gel.mat.
    // A field and its analytic XZ gradient, evaluated ONCE per vertex (including the trail).
    // Components: displacement, d/dx, d/dz, crushed pile. The supported bottom stays fixed.
    highp vec4 dentField(highp vec2 p) {
        vec2 q = (p - materialParams.finger) / materialParams.radius;
        float r = max(length(q), 0.0001);
        vec2 radial = q / r / materialParams.radius;
        float power = pow(r, materialParams.profile.x);
        float bowl = exp(-2.0 * power);
        float db = -2.0 * materialParams.profile.x * power / r * bowl;
        float gateT = clamp((r - 0.20) / 0.35, 0.0, 1.0);
        float gate = gateT * gateT * (3.0 - 2.0 * gateT);
        float dg = 6.0 * gateT * (1.0 - gateT) / 0.35;
        float rimQ = (r - materialParams.rimShape.x) / materialParams.rimShape.y;
        float rim = exp(-rimQ * rimQ);
        float dr = rim * (dg - gate * 2.0 * rimQ / materialParams.rimShape.y);
        float positiveDepth = max(materialParams.depth, 0.0);
        float field = -materialParams.depth * bowl + positiveDepth * materialParams.profile.y * rim * gate;
        vec2 gradient = (-materialParams.depth * db + positiveDepth * materialParams.profile.y * dr) * radial;
        if (materialParams.profile.z > 0.0 && positiveDepth > 0.00001) {
            float angle = r > 0.0001 ? atan(q.y, q.x) : 0.0;
            float phase = angle * materialParams.profile.w + r * 0.35;
            float fold = cos(phase), slope = -sin(phase);
            // Seven narrow leather creases; eighteen rounded velvet folds.
            if (materialParams.profile.w < 10.0) {
                slope *= 3.0 * fold * fold;
                fold = fold * fold * fold;
            }
            float envelopeQ = (r - 0.9) / 0.55;
            float envelope = exp(-envelopeQ * envelopeQ);
            float de = envelope * (dg - gate * 2.0 * envelopeQ / 0.55);
            float amplitude = positiveDepth * materialParams.profile.z;
            vec2 angular = vec2(-q.y, q.x) / (r * r * materialParams.radius);
            field += amplitude * envelope * gate * fold;
            gradient += amplitude * (de * fold * radial + envelope * gate * slope *
                (materialParams.profile.w * angular + 0.35 * radial));
        }
        float pile = 0.0;
        if (materialParams.trailMode > 0.5) {
            float memory = 0.0;
            vec2 memoryGradient = vec2(0.0);
            for (int i = 0; i < 8; i++) {
                vec4 samplePoint = materialParams.trail[i];
                vec2 delta = p - samplePoint.xy;
                float cell = samplePoint.z * exp(-dot(delta, delta) * samplePoint.w);
                memory += cell;
                memoryGradient -= 2.0 * delta * samplePoint.w * cell;
            }
            float remaining = exp(-memory);
            pile = 1.0 - remaining;
            if (materialParams.trailMode < 1.5) {
                // Smooth bounded union: grooves cannot stack up or deepen the main well.
                float groove = 0.22 * pile;
                field -= groove * (1.0 - bowl);
                gradient += groove * db * radial - 0.22 * remaining * memoryGradient * (1.0 - bowl);
                pile = 0.0;
            }
        }
        if (materialParams.releaseWave.w > 0.00001) {
            vec2 delta = p - materialParams.releaseWave.xy;
            float distance = max(length(delta), 0.0001);
            float offset = distance - materialParams.releaseWave.z * 1.35;
            float envelope = exp(-offset * offset / 0.16);
            float gateT = clamp(distance / 0.25, 0.0, 1.0);
            float gate = gateT * gateT * (3.0 - 2.0 * gateT);
            float dg = 6.0 * gateT * (1.0 - gateT) / 0.25;
            float wave = sin(offset * 10.0);
            float amplitude = materialParams.releaseWave.w;
            field += amplitude * envelope * gate * wave;
            gradient += amplitude * envelope * ((dg - gate * offset * 12.5) * wave +
                gate * 10.0 * cos(offset * 10.0)) * delta / distance;
        }
        return vec4(field, gradient, pile);
    }
    void materialVertex(inout MaterialVertexInputs material) {
        highp vec3 p = getPosition().xyz;
        vec3 halfSize = vec3(materialParams.dimensions.x, materialParams.dimensions.y * 0.5,
            materialParams.dimensions.z);
        vec3 centred = p + vec3(0.0, halfSize.y, 0.0);
        vec3 core = clamp(centred, -halfSize + materialParams.dimensions.w,
            halfSize - materialParams.dimensions.w);
        vec3 n = normalize(centred - core);
        vec3 axis = abs(n.x) < 0.9 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 0.0, 1.0);
        vec3 t = normalize(axis - n * dot(axis, n));
        float weight = clamp(1.0 + p.y / materialParams.dimensions.y, 0.0, 1.0);
        vec4 deformation = vec4(0.0);
        if (abs(materialParams.depth) > 0.000001 || materialParams.trailMode > 0.5 ||
            materialParams.releaseWave.w > 0.00001 || abs(materialParams.squash) > 0.000001) {
            deformation = dentField(p.xz);
            deformation.x -= materialParams.squash;
            float gx = deformation.y * weight, gz = deformation.z * weight;
            float gy = max(0.15, 1.0 + deformation.x / materialParams.dimensions.y);
            // Inverse-transpose Jacobian for N, Jacobian for the brushing tangent.
            n = normalize(vec3(n.x - gx * n.y / gy, n.y / gy, n.z - gz * n.y / gy));
            t = normalize(vec3(t.x, gx * t.x + gy * t.y + gz * t.z, t.z));
        }
        material.worldPosition.xyz += mat3(getWorldFromModelMatrix()) *
            vec3(0.0, weight * deformation.x + materialParams.bounce, 0.0);
        material.rest = vec4(p, clamp(-deformation.x / materialParams.dimensions.y, 0.0, 1.0));
        material.bentNormal = vec4(normalize(getWorldFromModelNormalMatrix() * n), deformation.w * weight);
        material.bentTangent = vec4(normalize(mat3(getWorldFromModelMatrix()) * t), 0.0);
        // Filament's original TBN maps the deformed world-space frame back in the fragment.
    }
}
fragment {
    highp vec3 hash3(highp vec3 p) {
        p = fract(p * vec3(0.1031, 0.1030, 0.0973));
        p += dot(p, p.yxz + 33.33);
        return fract((p.xxy + p.yxx) * p.zyx);
    }
    // Four hashes per sample; the marble's domain warp uses three-octave 2D fBm.
    // A continuous oblique projection carries the pattern across the top and sides.
    highp float noise2(highp vec2 p) {
        vec2 i = floor(p), f = fract(p);
        f = f * f * (3.0 - 2.0 * f);
        return mix(mix(hash3(vec3(i, 0)).x, hash3(vec3(i + vec2(1,0), 0)).x, f.x),
                   mix(hash3(vec3(i + vec2(0,1), 0)).x, hash3(vec3(i + vec2(1,1), 0)).x, f.x), f.y);
    }
    highp float fbm(highp vec2 p) {
        return noise2(p) * 0.57 + noise2(p * 2.13 + 7.1) * 0.29 +
            noise2(p * 4.37 + 19.7) * 0.14;
    }
    // One 3D Worley neighbourhood, shared by colour, occlusion and screen-derivative bump.
    // Uniform surface branches ensure marble/steel never pay for the cell search.
    highp vec2 cells(highp vec3 p) {
        vec3 i = floor(p), f = fract(p);
        float first = 10.0, second = 10.0;
        for (int z = -1; z <= 1; z++) for (int y = -1; y <= 1; y++) for (int x = -1; x <= 1; x++) {
            vec3 o = vec3(float(x), float(y), float(z));
            vec3 delta = o + hash3(i + o) - f;
            float d = dot(delta, delta);
            second = min(second, max(first, d));
            first = min(first, d);
        }
        return sqrt(vec2(first, second));
    }
    void material(inout MaterialInputs material) {
        highp vec3 p = variable_rest.xyz;
        float compressed = variable_rest.w;
        float crushed = max(compressed, variable_bentNormal.w * 0.65);
        vec3 colour = materialParams.albedo;
        float rough = materialParams.roughness;
        float occlusion = 1.0;
        float height = 0.0;
        float pile = 0.0;
        float kind = materialParams.surface;
        float coatRoughness = materialParams.coatRoughness;
        vec3 n = normalize(variable_bentNormal.xyz);
        vec3 t = normalize(variable_bentTangent.xyz);
        t = normalize(t - n * dot(t, n));
        if (kind < 0.5) {
            vec2 cell = cells(p * 32.0);
            float resolved = 1.0 - smoothstep(0.65, 1.5, length(fwidth(p * 32.0)));
            // Open-cell walls, resolved at the hero distance, with no dark pore centres.
            float wall = (1.0 - smoothstep(0.025, 0.20, cell.y - cell.x)) * resolved;
            colour *= (0.982 + 0.018 * wall) * (1.0 - 0.035 * compressed);
            occlusion = 0.98 + 0.02 * wall;
            height = 0.0030 * wall * (1.0 - 0.65 * compressed);
        } else if (kind < 2.5) {
            vec2 nap = p.xz + p.y * vec2(0.31, 0.73);
            pile = noise2(nap * vec2(3.0, 8.0));
            float fibre = noise2(nap * vec2(65.0, 240.0));
            float resolved = 1.0 - smoothstep(0.35, 1.4, length(fwidth(nap * vec2(65.0, 240.0))));
            float facing = clamp(dot(n, getWorldViewVector()), 0.0, 1.0);
            colour *= (0.48 + 0.24 * pile + 0.28 * (1.0 - facing)) * (1.0 + 1.1 * crushed);
            height = (fibre - 0.5) * 0.0018 * resolved;
            // Swept nap tilts the sheen lobe; a crushed patch lays fibres along the slab tangent.
            vec3 b = cross(n, t);
            float sweep = (pile - 0.5) * 0.30;
            n = normalize(n + t * (sweep + crushed * 0.22) + b * sweep * 0.45);
            rough -= crushed * 0.12;
        } else if (kind < 3.5) {
            vec2 cell = cells(p * 14.0);
            float footprint = length(fwidth(p * 14.0));
            float resolved = 1.0 - smoothstep(0.55, 1.5, footprint);
            // Rounded irregular pebbles, not sharp micro-pits: a broad, smooth satin lobe.
            float pebble = smoothstep(0.015, 0.25 + footprint * 0.12, cell.y - cell.x);
            float valley = (1.0 - pebble) * resolved;
            colour *= 1.0 - 0.18 * valley;
            height = 0.0025 * pebble * resolved;
            rough += valley * 0.10;
            coatRoughness += valley * 0.10;
            occlusion = 1.0 - valley * 0.10;
        } else if (kind < 4.5) {
            // Continuous high-precision coordinates: no rounded band IDs or periodic forks
            // whose discontinuities print dashed lines across the polished top.
            highp vec2 stone = vec2(p.x + p.z * 0.58, p.z - p.x * 0.58) + p.y * vec2(0.43, 0.71);
            highp float along = stone.y;
            highp float meander = (noise2(vec2(along * 0.8, 7.2)) - 0.5) * 0.85 +
                (noise2(vec2(along * 2.1, 18.4)) - 0.5) * 0.18;
            highp float across = stone.x + meander;
            float cloud = fbm(stone * 0.95 + 3.4);
            float broadWidth = mix(0.22, 0.46, cloud);
            float softVein = exp(-pow((across + 0.85) / broadWidth, 2.0));
            float secondVein = exp(-pow((across - 1.0 + 0.18 * sin(along * 1.6)) /
                (broadWidth * 1.35), 2.0));
            // Eighteen secondary streams across the ~6-unit diagonal span. All share the
            // same warp and feather into the cloud; no hard thresholds that read as cracks.
            vec2 flow = vec2(sin(along * 1.2), cos(along * 1.2));
            vec2 fadeFlow = vec2(sin(along * 0.85), cos(along * 0.85));
            float fineVeins = 0.0;
            // Only the three neighbouring streams can contribute at this fragment. Each
            // has a fixed ID/centre: changing neighbourhood drops only negligible Gaussian
            // tails, never changes a vein's position at a band boundary.
            highp float stream = floor((across + 2.9) / 0.34);
            for (int i = -1; i <= 1; i++) {
                highp float seed = stream + float(i);
                if (seed < 0.0 || seed > 17.0) continue;
                vec3 h = hash3(vec3(seed, 3.1, 9.7));
                highp float centre = -2.9 + seed * 0.34 + (h.x - 0.5) * 0.14;
                vec2 direction = h.yz * 2.0 - 1.0;
                highp float offset = across - centre + 0.10 * dot(flow, direction);
                float life = 0.65 + 0.25 * dot(fadeFlow, direction.yx);
                float width = mix(0.018, 0.045, h.y) + fwidth(offset) * 0.6;
                fineVeins += exp(-pow(offset / width, 2.0)) * life;
            }
            // Blue-grey mineral tint in linear light. Even overlaps stay well above black.
            float haze = 0.10 + 0.22 * cloud;
            float mineral = clamp(haze + 0.34 * softVein + 0.22 * secondVein +
                0.25 * min(fineVeins, 1.0), 0.0, 0.72);
            colour = mix(colour, vec3(0.36, 0.41, 0.47), mineral);
            rough += cloud * 0.018;
        } else {
            // Visible long brushing plus subpixel micro-grooves, both running along X.
            vec2 brushed = vec2(p.x * 1.4, (p.z + p.y) * 155.0);
            float streak = noise2(brushed);
            float resolved = 1.0 - smoothstep(0.45, 1.5, fwidth(brushed.y));
            float fine = noise2(brushed * vec2(1.0, 5.0));
            float fineResolved = 1.0 - smoothstep(0.4, 1.5, fwidth(brushed.y * 5.0));
            colour *= 1.0 + (streak - 0.5) * 0.15 * resolved;
            rough += (streak - 0.5) * 0.22 * resolved + (fine - 0.5) * 0.07 * fineResolved;
            height = (streak - 0.5) * 0.0010 * resolved + (fine - 0.5) * 0.00018 * fineResolved;
        }
        // Surface-gradient bump from the rest-space field: no extra noise evaluations.
        vec3 detailed = n;
        if (kind < 3.5 || kind > 4.5) {
            highp vec3 dx = dFdx(getWorldPosition()), dy = dFdy(getWorldPosition());
            highp vec3 r1 = cross(dy, n), r2 = cross(n, dx);
            highp float det = dot(dx, r1);
            // Never divide by a mediump epsilon that underflows to zero on mobile GPUs.
            if (abs(det) > 0.000000000001) {
                highp vec3 gradient = (dFdx(height) * r1 + dFdy(height) * r2) / det;
                detailed = normalize(n - gradient);
            }
        }
        mat3 toTangent = transpose(getWorldTangentFrame());
        material.normal = toTangent * detailed;
        material.clearCoatNormal = toTangent * (kind > 2.5 && kind < 3.5 ? detailed : n);
        material.anisotropyDirection = normalize(toTangent * t);
        prepareMaterial(material);
        material.baseColor = vec4(colour, 1.0);
        material.roughness = clamp(rough, 0.045, 1.0);
        material.metallic = materialParams.metallic;
        material.reflectance = 0.5;
        material.ambientOcclusion = occlusion;
        material.clearCoat = materialParams.coat;
        material.clearCoatRoughness = coatRoughness;
        vec3 pileTint = sqrt(materialParams.albedo);
        pileTint /= max(max(pileTint.r, pileTint.g), max(pileTint.b, 0.001));
        material.sheenColor = clamp(pileTint * materialParams.sheen * (0.85 + pile * 0.15 + crushed * 0.2), 0.0, 1.0);
        material.sheenRoughness = clamp(materialParams.sheenRoughness - crushed * 0.13 + (pile - 0.5) * 0.10, 0.2, 1.0);
        material.anisotropy = materialParams.anisotropy;
        // A hairline on the actual rigid surface: no extra mesh, clipping or vertex upload.
        float distanceToRing = abs(length(p.xz - materialParams.ripple.xy) - materialParams.ripple.z);
        float aa = max(fwidth(distanceToRing), 0.0001);
        float ring = (1.0 - smoothstep(materialParams.rippleWidth * 0.5,
            materialParams.rippleWidth * 0.5 + aa, distanceToRing)) * materialParams.ripple.w;
        ring *= smoothstep(-materialParams.dimensions.w, -0.005, p.y);
        // Source-over keeps primary legible on white marble as well as reflective steel.
        material.postLightingColor = vec4(materialParams.rippleColor * ring, ring);
    }
}
