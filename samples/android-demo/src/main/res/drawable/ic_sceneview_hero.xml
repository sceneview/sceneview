<?xml version="1.0" encoding="utf-8"?>
<!--
    SceneView hero mark — the app's adaptive launcher icon rendered as a standalone
    96 dp tile, for the About screen's identity block (#3563).

    It is not a redraw: the paths below are `ic_launcher_foreground.xml` verbatim,
    inside a group translated by -18 so the visible area is exactly the 72 dp safe
    viewport a launcher mask keeps — the cube fills the tile the way it fills the
    icon on the home screen, instead of floating in a 108 dp square. The ground is
    `ic_launcher_background` (#0D2137), drawn here as an M3 squircle-ish rounded
    rect because there is no mask outside a launcher.

    Theme-independent on purpose: this is the product's identity, the same picture in
    light and dark, exactly like the launcher icon it is cut from. Its own contrast is
    self-contained (light cube on dark navy), so it never depends on the surface under it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="72"
    android:viewportHeight="72">

    <!-- Ground — `ic_launcher_background`, rounded at 0.28 * width like the M3 mask. -->
    <path
        android:fillColor="#0D2137"
        android:pathData="M20,0 L52,0 A20,20 0 0 1 72,20 L72,52 A20,20 0 0 1 52,72 L20,72 A20,20 0 0 1 0,52 L0,20 A20,20 0 0 1 20,0 Z" />

    <group
        android:translateX="-18"
        android:translateY="-18">


        <!-- Subtle drop shadow under the cube -->
        <path
            android:fillColor="#18000000"
            android:pathData="M54,82 L78,67 L78,66 L54,81 L30,66 L30,67 Z" />

        <!-- Left face — deepest blue (shadow side) -->
        <path
            android:fillColor="#003A7D"
            android:pathData="M54,54 L30,40 L30,66 L54,80 Z" />

        <!-- Right face — medium blue (lit side) -->
        <path
            android:fillColor="#3D7FD9"
            android:pathData="M54,54 L78,40 L78,66 L54,80 Z" />

        <!-- Top face — lightest blue (direct light) -->
        <path
            android:fillColor="#A4C1FF"
            android:pathData="M54,28 L78,42 L54,56 L30,42 Z" />

        <!-- Top face inner highlight for depth -->
        <path
            android:fillColor="#BDD3FF"
            android:pathData="M54,31 L73,42 L54,53 L35,42 Z" />

        <!-- Edge highlights — white strokes for definition -->
        <!-- Top edges -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#DDEEFF"
            android:strokeWidth="0.6"
            android:pathData="M54,28 L78,42 L54,56 L30,42 Z" />

        <!-- Vertical front-left edge -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#BBDDFF"
            android:strokeWidth="0.4"
            android:pathData="M30,42 L30,66" />

        <!-- Vertical front-right edge -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#BBDDFF"
            android:strokeWidth="0.4"
            android:pathData="M78,42 L78,66" />

        <!-- Bottom edges -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#3377BB"
            android:strokeWidth="0.4"
            android:pathData="M54,80 L30,66 M54,80 L78,66" />

        <!-- Viewport bracket — top-left corner -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.8"
            android:strokeLineCap="round"
            android:pathData="M25,28 L25,22 L31,22" />

        <!-- Viewport bracket — top-right corner -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.8"
            android:strokeLineCap="round"
            android:pathData="M83,28 L83,22 L77,22" />

        <!-- Viewport bracket — bottom-left corner -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.8"
            android:strokeLineCap="round"
            android:pathData="M25,78 L25,84 L31,84" />

        <!-- Viewport bracket — bottom-right corner -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.8"
            android:strokeLineCap="round"
            android:pathData="M83,78 L83,84 L77,84" />
    </group>

</vector>
