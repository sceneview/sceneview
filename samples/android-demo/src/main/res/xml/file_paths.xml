<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!--
        Surfaces app-private external storage as content:// URIs so the
        Android Sharesheet (and other apps that receive an ACTION_SEND
        intent) can read AR session recordings without the app having
        WRITE_EXTERNAL_STORAGE.

        Used by ARRecordPlaybackDemo's "Share" button, which exposes
        files in `getExternalFilesDir("ar-recordings")` via
        FileProvider.getUriForFile().
    -->
    <external-files-path name="ar-recordings" path="ar-recordings/" />

    <!--
        Bug-report screenshots (feedback/BugReportSheet) — PNGs written to
        cacheDir/feedback/ and attached to the ACTION_SEND share intent.
        Scoped to the feedback/ subdirectory only, never the whole cache.
    -->
    <cache-path name="feedback" path="feedback/" />

    <!--
        Photos and videos of the scene (DemoScaffold's Take photo / Record video), written by
        the SDK's SceneRecorder to getExternalFilesDir()/captures/, or filesDir/captures/ on a
        device without external files storage.
    -->
    <external-files-path name="captures" path="captures/" />
    <files-path name="captures-internal" path="captures/" />

    <!--
        The Rerun demo's Share: the `.svscan` copy, the model and the exports, each written
        to its own directory of cacheDir/rerun-share/ for the share sheet. Scoped to that
        subdirectory only.
    -->
    <cache-path name="rerun-share" path="rerun-share/" />
</paths>
