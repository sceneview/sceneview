<?xml version="1.0" encoding="utf-8"?>
<!-- Strings for the unified `materials` demo (registered by
     `MaterialsFragment.kt`). #3495 rebuilt the demo as a material studio: a
     nine-sphere gallery, a single-sphere Inspect with live sliders, and the
     Occlusion section carried over from the retired `occlusion-material` demo
     (#2239 Batch 4). The retired `texture-streaming` id deep-links to Inspect,
     which is where a live `MaterialInstance` parameter swap now happens, so its
     own strings are gone with the scene they described.
     Android's resource merger fans every `res/values/*.xml` file in, so
     `R.string.demo_materials_title` etc. remains globally resolvable. Adding a
     new demo never needs to touch this file or `strings.xml` — see #1870. -->
<resources>
    <string name="demo_materials_title">Materials</string>
    <string name="demo_materials_subtitle">A PBR studio: metal, coat, sheen, glass and glow</string>
    <!-- The scene is procedural; what the cover waits on is the HDR environment's
         IBL prefilter, without which nothing has anything to reflect. -->
    <string name="demo_materials_loading">Lighting the studio…</string>

    <!-- Segmented modes. Order mirrors the `MaterialsMode` enum. -->
    <string name="demo_materials_mode_gallery">Gallery</string>
    <string name="demo_materials_mode_inspect">Inspect</string>
    <string name="demo_materials_mode_occlusion">Occlusion</string>

    <string name="demo_materials_gallery_hint">Tap a sphere to inspect its material</string>
    <string name="demo_materials_picker_label">Material</string>
    <string name="demo_materials_environment_label">Environment</string>

    <!-- Occlusion section — formerly the `occlusion-material` demo (#1776). -->
    <string name="demo_occlusion_material_toggle">Occluder visible</string>
    <string name="demo_occlusion_material_status_visible">Occluder shown · a tinted plate covers the helmet</string>
    <string name="demo_occlusion_material_status_occluding">Occlusion material · invisible, still hides the helmet</string>
    <string name="demo_occlusion_material_explainer">A plane sits between the camera and the helmet. Toggle ON: a debug-tinted plate shows where the plane is. Toggle OFF: the same plane wears the occlusion material — invisible, but it still hides what is behind it.</string>
</resources>
