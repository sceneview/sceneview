<?xml version="1.0" encoding="utf-8"?>
<!-- Strings for the `lines-paths` demo (registered by
     `LinesPathsFragment.kt`). Android's resource merger
     fans every `res/values/*.xml` file in, so `R.string.demo_lines_paths_title` etc.
     remains globally resolvable. Adding a new demo never needs to touch
     this file or `strings.xml` — see #1870. -->
<resources>
    <string name="demo_lines_paths_title">Lines &amp; Paths</string>
    <string name="demo_lines_paths_subtitle">Splines, polylines and point sets</string>
    <!-- Live status pill: curve family, sample count, stroke width.
         e.g. "Spline · 192 samples · 12 mm". -->
    <string name="demo_lines_paths_status">%1$s · %2$d samples · %3$d mm</string>
</resources>
