<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The XML theme and the Compose colour scheme are two independent copies of the
      same palette, and only the Compose one was complete. Everything Compose draws
      picked up `md_theme_surface`; everything the *platform* draws — the window
      background, and therefore the strip behind the status bar before the first
      frame — fell through to the Material3 baseline, #FEF7FF light / #141218 dark.

      That is the seam device QA measured at the top of every screen: a near-white
      status-bar band against a #F9F9FF page, off by 5 levels in the red channel and
      visible as a line. It was easy to blame on Material You, but it survived
      `dynamicColor = false` because it never came from the wallpaper — it came from
      this file not binding `colorSurface` at all.

      So: bind the surface roles here too, and pin `android:windowBackground` to the
      same token. A colour that exists in `colors.xml` but is named by nobody is not
      a palette, it is a comment.
    -->
    <style name="Theme.SceneViewDemo" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_secondaryContainer</item>
        <item name="colorTertiary">@color/md_theme_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_tertiaryContainer</item>
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="colorError">@color/md_theme_error</item>
        <item name="colorOnError">@color/md_theme_onError</item>
        <item name="android:windowBackground">@color/md_theme_surface</item>
    </style>

    <!--
      Launch theme, MainActivity only (#3899). Drawn by the system before the app's first
      frame, then swapped for `Theme.SceneViewDemo` by `installSplashScreen()`.

      It paints what the platform splash already painted: the launcher icon (its
      background layer is `md_theme_primary`, so it follows the theme) on
      `md_theme_surface`, dark system-bar icons in light, light ones in dark. The
      attributes are spelled out because `Theme.SplashScreen` defaults the icon to the
      generic Android one and its bar appearance to the device default, not ours.
      `values-v31/themes.xml` sets the platform icon attribute back to `@null`: see there.

      The theme is not what fixes #3899 — the exit listener in MainActivity is. Without
      it, the system fades this window out over the app's first frames, and the status
      bar keeps this window's dark icons over a demo's dark stage the whole time.
    -->
    <style name="Base.Theme.SceneViewDemo.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/md_theme_surface</item>
        <!-- Drawn by core-splashscreen itself below API 31 only. -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.SceneViewDemo</item>
        <item name="android:windowLightStatusBar">@bool/splash_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/splash_light_system_bars</item>
    </style>

    <style name="Theme.SceneViewDemo.Starting" parent="Base.Theme.SceneViewDemo.Starting" />
</resources>
