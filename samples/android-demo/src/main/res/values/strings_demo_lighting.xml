<?xml version="1.0" encoding="utf-8"?>
<!-- Strings for the `lighting` demo (registered by `LightingFragment.kt`).

     Rebuilt from scratch in #3496: three *rigs* (image-based, studio, sun) over
     the one stage `LightingStage`. Since #4603 it also carries what `lighting-lab`
     used to: reflections, contact shading, fog and the frame options. The retired
     `lighting-lab`, `movable-light` and `dynamic-sky` ids still deep-link here
     through `DeepLinkRouter.DEMO_ID_ALIASES` + `ALIAS_INITIAL_TAB`.

     Android's resource merger fans every `res/values/*.xml` file in, so
     `R.string.demo_lighting_title` etc. stays globally resolvable (#1870). -->
<resources>
    <string name="demo_lighting_title">Lighting</string>
    <string name="demo_lighting_subtitle">Studio light, daylight, reflections, fog and shading</string>
    <string name="demo_lighting_loading">Loading the stage…</string>

    <!-- Rig picker. Order matches the `LightingRig` enum, which `ALIAS_INITIAL_TAB` indexes. -->
    <string name="demo_lighting_rig_image">Image</string>
    <string name="demo_lighting_rig_studio">Studio</string>
    <string name="demo_lighting_rig_sun">Sun</string>
    <string name="demo_lighting_rig_image_explainer">An HDR environment is the whole rig: the chrome ball mirrors it, the matte ball reads it. Rotate the environment and the light turns with it.</string>
    <string name="demo_lighting_rig_studio_explainer">A three-point rig of analytic lights — a shadow-casting key, a cool fill, a cold rim — each drawn where it stands. Move the key and watch the modeling change.</string>
    <string name="demo_lighting_rig_sun_explainer">One sun on a clock. The hour drives its color, height and strength, and the sky swaps with it, so midnight is night rather than a dark noon.</string>

    <!-- Status pill, one per rig. -->
    <string name="demo_lighting_status_image">Image-based · %1$s · %2$d°</string>
    <string name="demo_lighting_status_studio">Studio · %1$s key · %2$d kcd · %3$d lights</string>
    <string name="demo_lighting_status_sun">Sun · %1$s h · %2$s</string>

    <!-- Controls. -->
    <string name="demo_lighting_environment">Environment</string>
    <string name="demo_lighting_rotation">Environment rotation</string>
    <string name="demo_lighting_rotation_hint">Filament turns the lighting, not the painted sky — hide the sky to rotate.</string>
    <string name="demo_lighting_ibl_intensity">Environment intensity</string>
    <string name="demo_lighting_sky">Draw the sky</string>
    <string name="demo_lighting_key_angle">Key angle</string>
    <string name="demo_lighting_key_intensity">Key intensity</string>
    <string name="demo_lighting_key_color">Key color</string>
    <string name="demo_lighting_fill">Fill light</string>
    <string name="demo_lighting_rim">Rim light</string>
    <string name="demo_lighting_markers">Show the lights</string>
    <string name="demo_lighting_time_of_day">Time of day</string>
    <string name="demo_lighting_haze">Haze</string>
    <string name="demo_lighting_exposure">Exposure</string>

    <!-- Sections shared by every rig (formerly the Lighting Lab bench). -->
    <string name="demo_lighting_section_reflections">Reflections</string>
    <string name="demo_lighting_section_frame">Frame</string>
    <string name="demo_lighting_probe">Local reflections</string>
    <string name="demo_lighting_probe_hint">A reflection probe swaps the reflections for a sunset while the camera is inside its area.</string>
    <string name="demo_lighting_probe_zone">Reflection area</string>
    <string name="demo_lighting_ssao">Contact shading</string>
    <string name="demo_lighting_ssao_hint">Ambient occlusion darkens small creases and nearby surfaces.</string>
    <string name="demo_lighting_fog">Fog</string>
    <string name="demo_lighting_fog_density">Fog density</string>
    <string name="demo_lighting_msaa">Smooth edges · geometry</string>
    <string name="demo_lighting_fxaa">Smooth edges · image</string>
    <string name="demo_lighting_dithering">Dithering</string>
</resources>
