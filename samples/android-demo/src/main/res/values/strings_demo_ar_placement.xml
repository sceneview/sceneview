<?xml version="1.0" encoding="utf-8"?>
<!-- Strings for the `ar-placement` demo (registered by
     `ArPlacementFragment.kt`). Android's resource merger
     fans every `res/values/*.xml` file in, so `R.string.demo_ar_placement_title` etc.
     remains globally resolvable. Adding a new demo never needs to touch
     this file or `strings.xml` — see #1870.

     #3405 folded `ar-instant-placement` into this demo; the placement-mode copy it brought
     went again when placement became automatic (no cursor, no tap — plan §2.1). -->
<resources>
    <string name="demo_ar_placement_title">AR Placement</string>
    <string name="demo_ar_placement_subtitle">Place objects on a floor or mount a TV on a wall</string>

    <!-- Pre-AR chooser (#3405). The whole point of this screen is that the subject is
         chosen before the camera opens, so its copy is about the choice, not about AR. -->
    <string name="ar_placement_chooser_headline">Choose an object to place in your space</string>
    <string name="ar_placement_teaches">Choose a floor or wall object, then point the camera where you want it. It appears on the first surface found. Move, rotate and resize it to see how it fits.</string>
    <string name="ar_placement_cta">Place in AR</string>
    <string name="ar_placement_cta_named">Place %1$s in AR</string>
    <string name="ar_placement_cta_checking">Checking whether this device supports ARCore…</string>
    <string name="ar_placement_cta_unsupported">This device does not support ARCore, so the camera half of this demo cannot run here.</string>
    <string name="ar_placement_cta_no_model">Pick a model first.</string>

    <!-- In-AR chrome. -->
    <string name="ar_placement_change_model">Change model</string>
    <string name="ar_placement_catalogue_note">Bundled models work offline. Online models download when selected and appear once the download completes.</string>

    <!-- Automatic placement (plan §2.2) — the exact copy of the state machine. Shared by
         the AR View tab and the `ar-placement` demo through `TapToPlaceStatusOverlays`. -->
    <string name="ar_place_move_slowly">Move slowly to find a surface.</string>
    <string name="ar_place_tracking_paused">Tracking paused. Move slowly.</string>
    <string name="ar_place_try_brighter_area">Try a brighter area.</string>
    <string name="ar_place_finding_placement">Finding your placement…</string>
    <string name="ar_place_gesture_hint">Drag to move. Pinch or twist to adjust.</string>
    <string name="ar_place_keep_on_surface">Keep the object on a surface.</string>
    <string name="ar_place_no_surface_title">No surface found.</string>
    <string name="ar_place_no_surface_detail">Try a brighter, textured area.</string>
    <string name="ar_place_view_in_3d">View in 3D</string>
    <string name="ar_place_keep_scanning">Keep scanning</string>
    <string name="ar_place_recovery_failed_title">Couldn\'t recover this placement.</string>
    <string name="ar_place_scan_again">Scan again</string>
    <string name="ar_place_camera_error_title">Camera couldn\'t start.</string>
    <string name="ar_place_try_again">Try again</string>
    <!-- Pinch read-out: "Actual size" only when the asset's size was measured (§2.3). -->
    <string name="ar_scale_preview_size">Preview size · %1$d%%</string>
    <string name="ar_scale_actual_size_percent">Actual size · %1$d%%</string>
    <!-- Accessibility action offered on the read-out while the model is not at 100% (#3830). -->
    <string name="ar_scale_reset_action">Reset to real-world size</string>
    <string name="ar_place_loading_model">Loading model…</string>
    <string name="ar_place_model_failed">Model couldn’t load.</string>
    <string name="ar_place_preview_size">Preview size</string>

    <!-- Sheet-only accessibility adjustments of the feature comparison screens. The
         move/rotate/scale labels are shared with the wall placement demo; only the
         depth axis differs, because a free-standing subject moves closer, not up. -->
    <string name="ar_adjust_move_closer">Move closer</string>
    <string name="ar_adjust_move_farther">Move farther</string>
    <!-- Shared AR start-up scrim (ARCameraInitScrim), shown until the first camera frame. -->
    <string name="ar_starting_camera">Starting camera…</string>
</resources>
