    <string name="contact_shadow_stage_floor">Floor</string>
    <string name="contact_shadow_stage_table">Table</string>
    <string name="contact_shadow_stage_wall">Wall</string>

    <!-- One line per staging, in plain words: what the screen is showing, no preset names and
         no rendering jargon (#3498). -->
    <string name="contact_shadow_caption_floor">The shadow under the chair is what puts it on the floor.</string>
    <string name="contact_shadow_caption_table">A smaller, tighter shadow for something resting on a table.</string>
    <string name="contact_shadow_caption_wall">A band of shade under the TV makes it look flat against the wall.</string>

    <!-- The hold-to-compare pill. Two states, because a pill that never changed would give no
