<resources>
    <string name="demo_contact_shadow_preview_title">Contact Shadow Preview</string>
    <string name="demo_contact_shadow_preview_subtitle">The soft shadow that makes an object look like it is really there</string>
    <string name="contact_shadow_toggle">Contact shadows</string>
    <string name="contact_shadow_motion_toggle">Lift and settle</string>
    <!-- Split from a single "Shadow intensity: %d%%" string when the demos moved to the shared
         LabeledSlider, which renders the name and the value on opposite edges of one line.
         The value half is gone again with #3372: the readout is now a bare multiplier ("1.00×")
