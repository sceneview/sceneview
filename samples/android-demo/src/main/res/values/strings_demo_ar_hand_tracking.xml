    <string name="demo_ar_hand_tracking_xr_available">Jetpack XR runtime detected — use XrHandNode for live tracking</string>
    <string name="demo_ar_hand_tracking_reference_note">Showing a static reference hand skeleton. On an Android XR headset, XrHandNode mirrors a real tracked hand.</string>
</resources>
