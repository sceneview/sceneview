    <string name="demo_ar_measure_depth_supported">Lets you measure clutter, slopes and edges that never grow a plane.</string>
    <string name="demo_ar_measure_depth_unsupported">Not supported on this device — planes and feature points only.</string>
    <string name="demo_ar_measure_accuracy_notice">Accuracy: a few centimeters on a phone without a depth sensor, close to one centimeter with one. Good enough to plan a room, a quote or a piece of furniture. Not a caliper. See AR_MEASURE.md.</string>
