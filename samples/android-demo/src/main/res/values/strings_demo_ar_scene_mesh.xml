<?xml version="1.0" encoding="utf-8"?>
<!-- Strings for the Streetscape mode of `ar-geospatial-anchors` (ARSceneGeometryDemo.kt).
     Android's resource merger fans every res/values/*.xml file in, so these names
     remain globally resolvable. Adding a new demo never needs to touch strings.xml —
     see #1870.

     The `demo_ar_scene_mesh_` prefix is historical: this file belonged to the
     `ar-scene-mesh` card ("Scene Geometry"). The AR catalogue clean-up, wave 1, folded
     that card into the Streetscape mode as its "Colour buildings & terrain" switch;
     the old link resolves through DEMO_ID_ALIASES. -->
<resources>
    <!-- Settings sheet: the switch that picks SceneMeshNode (on) or the raw
         StreetscapeGeometryNode (off), and the one-line explainer under it. -->
    <string name="demo_ar_scene_mesh_colour_switch">Colour buildings &amp; terrain</string>
    <string name="demo_ar_scene_mesh_colour_on_explainer">SceneMeshNode colours every surface by its MeshClassification — one hue for terrain, another for buildings. The same enum labels an ARKit scene-reconstruction mesh, so classification-driven code runs unchanged on both platforms.</string>
    <string name="demo_ar_scene_mesh_colour_off_explainer">StreetscapeGeometryNode is the raw node the coloured one builds on: the same Geospatial surfaces, one material for all of them, no classification.</string>

    <!-- Status pill. -->
    <string name="demo_ar_scene_mesh_streetscape_rendering">Rendering %1$d structure(s)</string>
    <string name="demo_ar_scene_mesh_streetscape_looking">Looking for streetscape geometry…</string>
    <!-- Shown after ~15 s of tracking with no geometry found and no unsupported-device
         error — the supported-device / no-VPS-coverage case (#1615). Streetscape can
         never find geometry indoors, so the demo must explicitly tell the user to go
         outside rather than spinning on "Looking for streetscape geometry…" forever. -->
    <string name="demo_ar_scene_mesh_streetscape_no_geometry_hint">No streetscape geometry found. This demo needs an outdoor location with Google Street View coverage — point at nearby buildings. It will not find anything indoors.</string>

    <string name="demo_ar_scene_mesh_scanning">Scanning environment…</string>
    <string name="demo_ar_scene_mesh_geospatial_unavailable">%1$s — try outdoors near mapped buildings. This feature also needs cloud setup.</string>

    <!-- Permission gate: CAMERA + ACCESS_FINE_LOCATION before an ARSceneView may be
         mounted at all. -->
    <string name="demo_ar_scene_mesh_requesting_permissions">Requesting permissions…</string>
    <string name="demo_ar_scene_mesh_streetscape_denied">Location permission denied — Streetscape Geometry needs ACCESS_FINE_LOCATION</string>
    <string name="demo_ar_scene_mesh_retry">Retry</string>

    <!-- Classification legend, shown with the colour switch on. -->
    <string name="demo_ar_scene_mesh_legend_title">Classification</string>
    <string name="demo_ar_scene_mesh_legend_terrain">Terrain</string>
    <string name="demo_ar_scene_mesh_legend_building">Building</string>
</resources>
