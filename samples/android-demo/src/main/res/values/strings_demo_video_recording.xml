<?xml version="1.0" encoding="utf-8"?>
<!-- Strings for the `video-recording` demo (registered by
     `VideoRecordingFragment.kt`). Android's resource merger
     fans every `res/values/*.xml` file in, so `R.string.demo_video_recording_title` etc.
     remains globally resolvable. Adding a new demo never needs to touch
     this file or `strings.xml` — see #1870. -->
<resources>
    <string name="demo_video_recording_title">Scene to MP4</string>
    <string name="demo_video_recording_subtitle">Record and share a moving 3D model</string>
    <string name="demo_video_recording_loading">Loading model…</string>
    <string name="demo_video_recording_explainer">Record the moving model without the controls. Stop to preview or share your video. Videos are saved on this device.</string>
    <string name="demo_video_recording_record">Record</string>
    <string name="demo_video_recording_stop">Stop</string>
    <string name="demo_video_recording_saved">Saved: %1$s (%2$d KB)</string>
    <string name="demo_video_recording_idle">Ready to record — capture the 3D scene without the controls.</string>
    <string name="demo_video_recording_recording">Recording the moving scene to MP4…</string>
    <string name="demo_video_recording_ready">MP4 saved — play it or share it below.</string>
    <string name="demo_video_recording_failed">Could not record or open the video. Try again or use another video app.</string>
    <string name="demo_video_recording_play">Play video</string>
    <string name="demo_video_recording_share">Share video</string>
</resources>
