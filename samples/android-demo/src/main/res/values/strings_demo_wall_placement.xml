<?xml version="1.0" encoding="utf-8"?>
<!-- Strings for the `wall-placement` demo (registered by
     `ArWallPlacementFragment.kt`, #2740). Android's resource merger
     fans every `res/values/*.xml` file in, so `R.string.demo_wall_placement_title` etc.
     remains globally resolvable. Adding a new demo never needs to touch
     this file or `strings.xml` — see #1870. -->
<resources>

    <string name="wall_title">Wall Placement</string>
    <string name="wall_phase_scanning">Point at a wall and move slowly.</string>
    <string name="wall_preview_size">TV · Preview size</string>
    <string name="wall_reset">Reset placement</string>
    <string name="wall_scale_down">Scale down</string>
    <string name="wall_scale_up">Scale up</string>

    <!-- Sheet-only accessibility adjustments. -->
    <string name="wall_dpad_left">Move left</string>
    <string name="wall_dpad_right">Move right</string>
    <string name="wall_dpad_up">Move up</string>
    <string name="wall_dpad_down">Move down</string>
    <string name="wall_dpad_rotate_left">Rotate left</string>
    <string name="wall_dpad_rotate_right">Rotate right</string>
</resources>
