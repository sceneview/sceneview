<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          Debug-only harness for instrumentation tests. Launches a single demo composable
          directly via an intent extra, bypassing the home list / navigation stack. Not
          declared in src/main so release builds never ship it. See DemoHostActivity.kt.
        -->
        <activity
            android:name=".DemoHostActivity"
            android:exported="true"
            android:theme="@style/Theme.SceneViewDemo" />
        <!-- Debug-only visual QA of the SDK's AR coaching overlay, no ARCore session needed.
             See ARCoachingPreviewActivity.kt. -->
        <activity
            android:name=".ARCoachingPreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.SceneViewDemo" />
        <!-- Debug-only visual QA of the "View in 3D" preview sheets, no ARCore session needed.
             See PlacementPreviewQaActivity.kt. -->
        <activity
            android:name=".PlacementPreviewQaActivity"
            android:exported="true"
            android:theme="@style/Theme.SceneViewDemo" />
    </application>
</manifest>
