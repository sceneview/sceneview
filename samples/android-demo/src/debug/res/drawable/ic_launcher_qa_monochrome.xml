<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 13+ themed-icon layer of the QA build. The system tints this layer with one
    colour and keeps only its alpha, so the colour badge cannot carry over: the cube
    silhouette (what the store monochrome layer shows once tinted) is cut away around the
    badge by a clip-path with a counter-clockwise hole, and the badge becomes an outlined
    pill with the same "QA" strokes as ic_launcher_qa_badge. Only alpha is read here, so
    every path uses the launcher navy.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group>
        <!-- Whole canvas clockwise + the badge area (2 units of air around the pill)
             counter-clockwise: non-zero winding leaves the badge area out of the clip. -->
        <clip-path android:pathData="M0,0 H108 V108 H0 Z M62,61 H46 A14,14 0 0,0 46,89 H62 A14,14 0 0,0 62,61 Z" />

        <!-- Cube silhouette (union of the three faces of ic_launcher_foreground). -->
        <path
            android:fillColor="@color/ic_launcher_background"
            android:pathData="M54,28 L78,42 L78,66 L54,80 L30,66 L30,42 Z" />
    </group>

    <!-- Viewport brackets, as in ic_launcher_foreground. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/ic_launcher_background"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M25,28 L25,22 L31,22 M83,28 L83,22 L77,22 M25,78 L25,84 L31,84 M83,78 L83,84 L77,84" />

    <!-- Outlined badge + QA. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/ic_launcher_background"
        android:strokeWidth="2.2"
        android:pathData="M46,63 H62 A12,12 0 0,1 62,87 H46 A12,12 0 0,1 46,63 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/ic_launcher_background"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M42.8,75 A5,6.5 0 1,0 52.8,75 A5,6.5 0 1,0 42.8,75 Z M50.6,78.2 L53.6,81.8 M56.2,81.5 L60.7,68.5 L65.2,81.5 M57.7,77.2 L63.7,77.2" />
</vector>
