// splat_web.mat — see CONTRIBUTING.md "Filament runtime ↔ .filamat ABI invariant"
//
// WEB fork of sceneview/src/main/materials/splat.mat (keep the two in sync — the ONLY
// intended delta is the parameter types, see below). Same engine, different runtime:
// this blob is compiled for the Filament version `sceneview-web` actually runs against —
// the npm `filament` pin in sceneview-web/build.gradle.kts (`filamentWeb` in
// gradle/libs.versions.toml), NOT the Android `filament` version. A blob compiled with
// the Android matc is silently rejected by the web runtime (MATERIAL_VERSION mismatch —
// the v4.1.0 incident class, CONTRIBUTING.md).
//
// DELTA vs splat.mat (Android), and why:
//   * `texWidth` / `instanceOffset` are `float` here (Android: `int`) — Filament.js's
//     embind MaterialInstance exposes setBool/Float/Float2/3/4/Mat3/4/Texture parameter
//     setters but NO setIntParameter (verified against npm filament 1.52.3 filament.d.ts
//     + wasm exports), so an `int` parameter cannot be set from JS at all. The vertex
//     shader casts them back with `int(...)` — both values are exact in an IEEE binary32
//     up to 2^24, far above the 65535 instances/draw cap and any realistic texWidth.
//   * Everything else is byte-identical to splat.mat. If you change splat.mat, mirror
//     the change here and regenerate BOTH blobs (tools/GenerateFilamat.sh).
//
// Purpose:    3D Gaussian Splatting (3DGS) renderer. Draws one hardware-instanced,
//             camera-facing quad per gaussian; the per-splat centre / scale / colour /
//             opacity is fetched in the VERTEX shader from two RGBA16F data textures,
//             indexed by the instance id. The fragment applies an isotropic gaussian
//             falloff and premultiplied-alpha compositing (radiance-field alpha blend).
// Used by:    io.github.sceneview.web.nodes.SplatNode (P2 of epic #2646).
// Parameters:
//   splatPositionScale — sampler2d RGBA16F: rgb = splat model-space centre (shader applies
//                        getWorldFromModelMatrix), a = isotropic billboard half-extent (≈3σ).
//   splatColorOpacity  — sampler2d RGBA16F: rgb = linear SH0 colour, a = opacity 0..1.
//   texWidth           — float (integral value): side of the (square) data textures.
//   instanceOffset     — float (integral value): base global splat index for THIS
//                        renderable's instance 0 (multi-batch clouds above 65535/draw).
// matc profile: W (web — "-p mobile -a opengl" with the filamentWeb toolchain,
//               see tools/GenerateFilamat.sh).
//
// Rendering notes: identical to splat.mat — WebGL2/ESSL 300 es guarantees vertex-stage
// textureLod (≥16 VTF units), integer ops, and gl_InstanceID, so the shader body needs
// no adaptation beyond the float→int parameter casts.
material {
    "name" : "SplatWeb",

    "parameters" : [
        {
            "type" : "sampler2d",
            "name" : "splatPositionScale",
            "format" : "float",
            "precision" : "high"
        },
        {
            "type" : "sampler2d",
            "name" : "splatColorOpacity",
            "format" : "float"
        },
        {
            "type" : "float",
            "name" : "texWidth"
        },
        {
            "type" : "float",
            "name" : "instanceOffset"
        }
    ],
    "requires" : [
        "position"
    ],
    "variables" : [
        "quadUv",
        "splatColor"
    ],
    "shadingModel" : "unlit",
    "blending" : "transparent",
    "instanced" : true,
    "doubleSided" : true,
    "depthWrite" : false,
    "depthCulling" : true
}
vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        // float→int casts: see the header — embind has no setIntParameter, so the two
        // integral parameters travel as floats (exact up to 2^24).
        int idx = getInstanceIndex() + int(materialParams.instanceOffset);
        int tw = int(materialParams.texWidth);
        // Texel centre of splat `idx` in the square data textures.
        highp float2 uv = (float2(float(idx % tw), float(idx / tw)) + 0.5) / float(tw);

        // Per-splat attributes (inlined fetch — samplers can't be helper args under matc).
        highp float4 posScale = textureLod(materialParams_splatPositionScale, uv, 0.0);
        float4 col = textureLod(materialParams_splatColorOpacity, uv, 0.0);

        // Camera-facing billboard: the world-space camera right/up axes are the first two
        // ROWS of the view (ViewFromWorld) matrix.
        highp mat4 view = getViewFromWorldMatrix();
        float3 camRight = float3(view[0][0], view[1][0], view[2][0]);
        float3 camUp    = float3(view[0][1], view[1][1], view[2][1]);

        // Unit quad corner in [-1, 1]^2, instanced N times (the only vertex attribute).
        float2 corner = getPosition().xy;

        // Splat centre in world space (node transform applied), then offset along the
        // camera plane by the isotropic half-extent.
        highp float3 center = mulMat4x4Float3(getWorldFromModelMatrix(), posScale.xyz).xyz;
        material.worldPosition = float4(
            center + (corner.x * camRight + corner.y * camUp) * posScale.w,
            1.0
        );

        // Custom material `variables` are float4 interpolants — pad the float2 corner.
        material.quadUv = float4(corner, 0.0, 0.0);
        material.splatColor = col;
    }
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        // Isotropic gaussian footprint: exp(-0.5 * r^2 * k), k = 9 → ~3σ at the quad edge
        // (|uv| = 1 ⇒ g ≈ 0.011), so the disc fades smoothly to nothing instead of a hard quad.
        float2 uv = variable_quadUv.xy;
        float g = exp(-0.5 * dot(uv, uv) * 9.0);
        float a = variable_splatColor.a * g;

        // #2224 / #2325 — premultiply. blending:transparent composites ONE*src + (1-a)*dst,
        // so the emitted rgb must already be alpha-weighted for a correct radiance-field blend.
        material.baseColor = float4(variable_splatColor.rgb * a, a);
    }
}
