<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to load gltf from network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Declared on purpose: merged into every consumer app for the vibrator tiers of
         SceneViewHaptic. Normal permission (granted at install time, no prompt). An app that
         wants none removes it with tools:node="remove"; the View tiers keep working. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- SceneView requires OpenGLES 3.0 or later for 3D rendering. -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <application>
        <!-- Prepares Filament's native libraries and the shared EGL context on a background
             thread at app startup, so the first rememberEngine() does not do it inside a
             composition (see EngineWarmUp). An app that wants none removes this meta-data with
             tools:node="remove" and may call EngineWarmUp.start() itself. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="io.github.sceneview.EngineWarmUpInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>
</manifest>