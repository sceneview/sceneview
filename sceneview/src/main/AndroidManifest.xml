<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to load gltf from network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Declared on purpose: merged into every consumer app for the vibrator tiers of
         SceneViewHaptic. Normal permission (granted at install time, no prompt). An app that
         wants none removes it with tools:node="remove"; the View tiers keep working. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- SceneView requires OpenGLES 3.0 or later for 3D rendering. -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />
</manifest>