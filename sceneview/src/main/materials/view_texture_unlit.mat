// view_texture_unlit.mat — see CONTRIBUTING.md "Filament runtime ↔ .filamat ABI invariant"
//
// Purpose:    Unlit transparent material that draws a rendered Android View as a 3D quad,
//             ignoring scene lighting (flat passthrough).
// Used by:    MaterialLoader.createViewInstance (unlit = true) / ViewNode.
// Parameters:
//   uvOffset — float2, per-axis UV mirror offset (1,0) flips X for front-camera use.
//   texture  — samplerExternal, the View's hardware-rendered surface texture.
// matc profile: A (heavy Android — "-p all -a all", see tools/GenerateFilamat.sh).
material {
    name : view,
    shadingModel : unlit,
    blending : transparent,
    doubleSided : true,

    defines : [
        baseColor
    ],

    parameters : [
        // Todo: See if still useful
        // {
        //     type : bool,
        //     name : isViewReady
        // },
        {
            type : float2,
            name : uvOffset
        },
        {
           type : samplerExternal,
           name : texture
        }
    ],

    requires : [
        position,
        uv0
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        vec2 uv = getUV0();

        if (!gl_FrontFacing) {
          uv.x = 1.0 - uv.x;
        }

        // Set offsetUv if we want to invert around an axis.
        // In front facing camera, set uvOffset.x to 1 and uvOffset.y to 0.
        uv.x = uv.x + materialParams.uvOffset.x * (1.0 - 2.0 * uv.x);
        uv.y = uv.y + materialParams.uvOffset.y * (1.0 - 2.0 * uv.y);

        // Todo: See if still useful
        // if (materialParams.isViewReady) {
            material.baseColor = texture(materialParams_texture, uv);
            material.baseColor.rgb = inverseTonemapSRGB(material.baseColor.rgb);
        // } else {
        //     material.baseColor = vec4(0.0);
        // }
    }
}
