// semantics_overlay.mat — see CONTRIBUTING.md "Filament runtime ↔ .filamat ABI invariant"
//
// Purpose:    Color-codes ARCore Scene Semantics segmentation (#1730 / #1868). Samples an R8
//             label-ordinal texture (the raster from `Frame.semanticImage()`) and maps each
//             pixel to one of the 12 outdoor-class colors, modulated by a global `opacity`.
//             Drawn as a transparent full-screen overlay on top of the live camera feed so
//             the camera ↔ semantic blend reads through Filament's alpha pipeline.
// Used by:    MaterialLoader.createSemanticsOverlayInstance() — opt-in AR visualization.
// Parameters:
//   semanticTexture — sampler2d, R8 image; each texel's red channel is a SemanticLabel ordinal
//                     (0..11, UNLABELED first) scaled to [0, 1] (255 → 1.0). Upload the
//                     `Frame.semanticImage()` R8 buffer into a single-channel Filament Texture.
//   opacity         — float [0, 1], global overlay alpha. 0 = camera only, 1 = full overlay.
//   inverseFilmic   — bool: the View tone-maps with ToneMapper.Filmic (createARView) rather than
//                     PBR Neutral (createView, the default). Picks which exact inverse the
//                     palette is pre-distorted by. Set from the view the overlay is drawn in.
// matc profile: C (ARCore overlay — "--optimize-size -p mobile -a opengl -a vulkan").
//
// #2224/#2325: `blending: transparent` composites ONE*src + (1-a)*dst, but Filament does NOT
//             premultiply unlit baseColor for us. Emitting a straight `tint` made dialling
//             `opacity` down never reduce the tint over the camera feed — the overlay
//             composited as `tint + (1-a)*bg` and read near-opaque. The fragment now
//             premultiplies the tint by the final alpha → `lerp(bg, tint, alpha)`.
//
// The 12-class palette is a compile-time `const` array: the ARCore Scene Semantics model
// always emits exactly the same 12 ordinals (UNLABELED, then SKY..WATER), so baking the colors keeps the
// parameter surface tiny (one texture + one float) and the lookup branch-free. The colors are
// ported from Google's `samples/semantics_java` `background_semantics.frag` reference.
//
// #5102: the palette holds sRGB-encoded colours, the same bytes the demo's legend
//        (SemanticsOverlay.PALETTE_ARGB) paints. Written straight into baseColor they were taken
//        as linear and then tone-mapped and sRGB-encoded by the View: SKY #66B0F5 reached the
//        screen as (157, 204, 237). Each colour is now decoded with the exact sRGB EOTF and
//        pre-distorted by the exact inverse of the View's tone mapper, taken in the Rec.2020
//        space Filament tone-maps in, so a class displays in its documented colour. The PBR
//        Neutral inverse is the one video_texture.mat, view_texture_*.mat and splat.mat share.
material {
    name : semanticsOverlay,
    shadingModel : unlit,
    blending : transparent,
    culling : none,
    depthWrite : false,
    depthCulling : false,
    parameters : [
        {
            type : sampler2d,
            name : semanticTexture
        },
        {
            type : float,
            name : opacity
        },
        {
            // true when the overlay is drawn in a Filmic view (createARView), false for the
            // createView default (PBR Neutral). Set from the view the overlay is drawn in.
            type : bool,
            name : inverseFilmic
        }
    ],
    requires : [
        uv0
    ]
}

fragment {
    // Per-class sRGB colors (the bytes the legend paints, #5102) for the 12 ARCore Scene
    // Semantics outdoor labels, indexed by the byte
    // ARCore writes in the semantic image, which is the `SemanticLabel` ordinal:
    //   0 UNLABELED  1 SKY  2 BUILDING  3 TREE  4 ROAD  5 SIDEWALK
    //   6 TERRAIN  7 STRUCTURE  8 OBJECT  9 VEHICLE  10 PERSON  11 WATER
    // The table used to start at SKY and end at UNLABELED, one place off ARCore's order: each
    // class took the next one's color, unclassified pixels were tinted sky blue and water was
    // left transparent (#4036).
    const vec3 SEMANTIC_PALETTE[12] = vec3[12](
        vec3(0.00, 0.00, 0.00),  // UNLABELED  — black, never drawn (transparent)
        vec3(0.40, 0.69, 0.96),  // SKY        — light blue
        vec3(0.85, 0.37, 0.34),  // BUILDING   — terracotta
        vec3(0.30, 0.69, 0.31),  // TREE       — green
        vec3(0.46, 0.46, 0.46),  // ROAD       — grey
        vec3(0.74, 0.74, 0.55),  // SIDEWALK   — khaki
        vec3(0.80, 0.62, 0.42),  // TERRAIN    — tan
        vec3(0.62, 0.46, 0.74),  // STRUCTURE  — purple
        vec3(1.00, 0.76, 0.03),  // OBJECT     — amber
        vec3(0.13, 0.59, 0.95),  // VEHICLE    — strong blue
        vec3(0.96, 0.26, 0.55),  // PERSON     — pink
        vec3(0.00, 0.74, 0.83)   // WATER      — cyan
    );

    // ---- Inverse of ToneMapper.PBRNeutralToneMapper (Khronos PBR Neutral, #4595) ----
    // Shared verbatim by splat.mat, video_texture*.mat and view_texture_*.mat
    // (ToneMapInverseContractTest checks they stay identical).

    // The forward curve's highlight compression at scene peak p: (new peak, desaturation).
    vec2 pbrNeutralCompression(float p) {
        float np = 1.0 - 0.0576 / (p - 0.52);
        return vec2(np, 1.0 - 1.0 / (0.15 * (p - np) + 1.0));
    }

    // Undoes the toe offset the forward curve subtracts from every channel.
    vec3 inversePbrNeutralToe(vec3 c) {
        float m = min(c.r, min(c.g, c.b));
        float offset = m < 0.04 ? sqrt(max(m, 0.0) / 6.25) - m : 0.04;
        return c + offset;
    }

    // Display-linear colour -> scene-linear colour that PBR Neutral maps back onto it.
    // Exact for every colour the curve can produce. The peak is capped at 0.99143 (252.8/255),
    // whose inverse is 7.24, the value Filmic's inverse gives white: PBR Neutral's inverse is
    // unbounded as the peak nears 1. A bright saturated colour (#FF0000) has no preimage, since
    // the curve desaturates highlights: the scene peak is then bisected so the peak shortfall
    // equals the unavoidable desaturation lift in display (gamma) space, red -> (235, 13, 13)
    // instead of a pink (255, 212, 212).
    vec3 inversePbrNeutral(vec3 o) {
        float peak = max(o.r, max(o.g, o.b));
        if (peak < 0.76) {
            return inversePbrNeutralToe(o);
        }
        float np = min(peak, 0.99143);
        float p = 0.0576 / (1.0 - np) + 0.52;
        vec2 ng = pbrNeutralCompression(p);
        vec3 c = (o - ng.x * ng.y) / (1.0 - ng.y) * (p / ng.x);
        if (min(c.r, min(c.g, c.b)) >= -1e-4) {
            return inversePbrNeutralToe(c);
        }
        float omin = max(min(o.r, min(o.g, o.b)), 0.0);
        float encPeak = pow(peak, 1.0 / 2.2);
        float encMin = pow(omin, 1.0 / 2.2);
        float lo = 0.76;
        float hi = p;
        for (int i = 0; i < 12; i++) {
            float mid = 0.5 * (lo + hi);
            ng = pbrNeutralCompression(mid);
            if (encPeak - pow(ng.x, 1.0 / 2.2) > pow(omin + ng.x * ng.y, 1.0 / 2.2) - encMin) {
                lo = mid;
            } else {
                hi = mid;
            }
        }
        p = 0.5 * (lo + hi);
        ng = pbrNeutralCompression(p);
        vec3 ratio = clamp((o - ng.x * ng.y) / (ng.x * (1.0 - ng.y)), 0.0, 1.0);
        return inversePbrNeutralToe(ratio * p);
    }

    // Exact sRGB EOTF (IEC 61966-2-1): the View's output stage is the exact OETF (#3338).
    vec3 semanticsSrgbToLinear(vec3 srgb) {
        vec3 s = clamp(srgb, 0.0, 1.0);
        return mix(s * (1.0 / 12.92), pow((s + 0.055) * (1.0 / 1.055), vec3(2.4)),
                step(vec3(0.04045), s));
    }

    // Filament's ColorGrading tone-maps in its Rec.2020 working space, not in Rec.709: the
    // View converts the scene colour to Rec.2020, applies the tone mapper per channel there and
    // converts back. Inverting the curve channel by channel in Rec.709 leaves a saturated colour
    // off (SKY #66B0F5 read back as #95B2FB in a Filmic view), so the inverse runs in the same
    // space. Column-major, the constants of Filament's sRGB_to_REC2020 / REC2020_to_sRGB.
    const mat3 SEMANTICS_REC709_TO_REC2020 = mat3(
        0.6274040, 0.0690970, 0.0163916,
        0.3292820, 0.9195400, 0.0880132,
        0.0433136, 0.0113612, 0.8955950
    );
    const mat3 SEMANTICS_REC2020_TO_REC709 = mat3(
         1.6604910, -0.1245505, -0.0181508,
        -0.5876411,  1.1328999, -0.1005789,
        -0.0728499, -0.0083494,  1.1187297
    );

    // sRGB palette colour -> scene-linear Rec.709 colour that the View's tone mapper and OETF
    // display as it. The few that would need a negative channel (VEHICLE's and WATER's red under
    // Filmic) are clipped at zero: the colour buffer holds no negative value.
    vec3 inverseViewTonemapSRGB(vec3 srgb) {
        vec3 working = SEMANTICS_REC709_TO_REC2020 * semanticsSrgbToLinear(srgb);
        vec3 scene = materialParams.inverseFilmic
                ? Inverse_Tonemap_Filmic(working)
                : inversePbrNeutral(working);
        return max(SEMANTICS_REC2020_TO_REC709 * scene, vec3(0.0));
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        // The R8 texel red channel holds the SemanticLabel ordinal scaled to [0, 1]
        // (label ordinal o → o/255 on upload). Recover the integer ordinal; the palette is
        // indexed with it clamped, so a stray byte can never index out of bounds.
        float raw = texture(materialParams_semanticTexture, getUV0()).r;
        int label = int(raw * 255.0 + 0.5);
        int ordinal = clamp(label, 0, 11);

        // The palette is sRGB, like the legend's bytes: pre-distort it by the inverse of what the
        // View applies after this shader (#5102).
        vec3 tint = inverseViewTonemapSRGB(SEMANTIC_PALETTE[ordinal]);

        // UNLABELED (ordinal 0) stays fully transparent so the live camera feed shows
        // through un-classified pixels — only confident classes get tinted. A byte past the
        // last class is no classification either.
        float classAlpha = (label >= 1 && label <= 11) ? 1.0 : 0.0;

        material.baseColor.a = clamp(materialParams.opacity, 0.0, 1.0) * classAlpha;
        // #2224/#2325 — premultiply the tint by the final alpha. With `blending: transparent`
        // Filament composites ONE * src + (1-a) * dst and does NOT premultiply unlit baseColor,
        // so emitting a straight `tint` composited as `tint + (1-a)*bg` (opacity never reduced
        // the tint). Premultiplying makes it `alpha*tint + (1-alpha)*bg` = lerp(bg, tint, alpha).
        material.baseColor.rgb = tint * material.baseColor.a;
    }
}
