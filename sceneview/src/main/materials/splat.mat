// splat.mat — see CONTRIBUTING.md "Filament runtime ↔ .filamat ABI invariant"
//
// Purpose:    3D Gaussian Splatting (3DGS) renderer. Draws one hardware-instanced quad per
//             gaussian, shaped in the VERTEX shader as the gaussian's projected screen-space
//             ellipse (the standard anisotropic 2D-covariance projection of the reference 3DGS
//             rasteriser), with a gaussian falloff and premultiplied-alpha compositing in the
//             fragment.
// Used by:    io.github.sceneview.node.SplatNode (#2646).
// Parameters:
//   splatOrder          — sampler2d R32UI: draw slot → splat index. The ONLY texture a re-sort
//                         re-uploads (4 B/splat); the three data textures below are static.
//   splatPositionScale  — sampler2d RGBA16F: rgb = splat model-space centre (shader applies
//                         getWorldFromModelMatrix), a = 3σ of the largest axis (culling bound,
//                         kept for layout compatibility — the projection below does not read it).
//   splatColorOpacity   — sampler2d RGBA16F: rgb = SH0 colour (display-referred, what the trainer
//                         saw), a = opacity 0..1.
//   splatRotationScale  — sampler2d RGBA32UI, two IEEE half floats per channel (packHalf2x16,
//                         low half first): (qx,qy) (qz,qw) (sx,sy) (sz,0) — unit rotation
//                         quaternion (xyzw) and the three per-axis standard deviations.
//   texWidth            — int: side of the (square) textures; slot/splat i is texel
//                         (i % texWidth, i / texWidth).
//   instanceOffset      — int: base draw slot for THIS renderable's instance 0.
//                         Splat counts above the 65535 instances/draw cap are drawn as
//                         multiple renderables sharing the textures; each batch offsets
//                         getInstanceIndex() by its base so the slot indexing stays global.
// matc profile: B (lean Android — "-a opengl -p mobile", see tools/GenerateFilamat.sh).
//
// Rendering notes (Filament 1.72.1 — Android Java API still exposes no compute/SSBO →
// CPU painter's sort, see #2646 spike):
//   * instanced:true + getInstanceIndex() feed one unit quad to N gaussians (cap 65535/draw).
//   * Vertex-stage texelFetch is the only way to feed ≥100k per-splat attributes (uniform
//     arrays can't). A helper cannot take a `sampler2d` argument in matc — the fetches are
//     INLINED (spike finding 1).
//   * mulMat4x4Float3(m, v) returns a float4 (homogeneous) — take .xyz (spike finding 2).
//   * Projection: Σ = R·S·Sᵀ·Rᵀ in model space, carried to view space by the upper 3×3 of
//     ViewFromWorld·WorldFromModel (so node scale/rotation apply), projected with the
//     perspective Jacobian J in PIXELS (focal = clipFromView[i][i] · resolution / 2), plus the
//     reference 0.3 px² low-pass. The eigen-decomposition of that 2×2 gives the ellipse axes.
//     The quad is laid in the camera-parallel plane through the splat centre, where a pixel
//     offset maps linearly to a view-space offset (Δview = Δpx · depth / focal) — so the
//     ellipse is exact without switching the material to the device vertex domain.
//   * The quad reaches only as far as the gaussian is visible: min(3σ, √(2·ln(255·α)))σ, so a
//     faint splat gets a proportionally smaller quad (less overdraw, nothing visible lost —
//     beyond that radius its contribution is under 1/255), and splats under 1/255 opacity or
//     behind the camera collapse to a zero-area quad.
//   * Colour: splat colours are display-referred (the trainer fitted them to sRGB photos). The
//     View applies ToneMapper.Filmic then the exact sRGB OETF, so the colour is pre-distorted by
//     the exact inverse (exact sRGB EOTF, then Inverse_Tonemap_Filmic) — the same round trip as
//     camera_stream_flat.mat (#3338). Without it a 0.5 grey displays at ~0.81: the over-bright,
//     washed-out look of the P1 billboard.
//   * blending:transparent composites ONE*src + (1-a)*dst and does NOT premultiply unlit
//     baseColor for us, so the fragment premultiplies `baseColor.rgb *= a` — the #2224 /
//     #2325 wash-out lesson applies verbatim.
//   * depthWrite off + depthCulling on: gaussians read the opaque depth buffer (so solid
//     geometry occludes them) but do not write depth among themselves — correct alpha
//     compositing relies on the CPU back-to-front order, not the z-buffer.
material {
    "name" : "Splat",

    "parameters" : [
        {
            "type" : "sampler2d",
            "name" : "splatOrder",
            "format" : "uint",
            "precision" : "high"
        },
        {
            "type" : "sampler2d",
            "name" : "splatPositionScale",
            "format" : "float",
            "precision" : "high"
        },
        {
            "type" : "sampler2d",
            "name" : "splatColorOpacity",
            "format" : "float"
        },
        {
            "type" : "sampler2d",
            "name" : "splatRotationScale",
            "format" : "uint",
            "precision" : "high"
        },
        {
            "type" : "int",
            "name" : "texWidth"
        },
        {
            "type" : "int",
            "name" : "instanceOffset"
        }
    ],
    "requires" : [
        "position"
    ],
    "variables" : [
        "quadUv",
        "splatColor"
    ],
    "shadingModel" : "unlit",
    "blending" : "transparent",
    "instanced" : true,
    "doubleSided" : true,
    "depthWrite" : false,
    "depthCulling" : true
}
vertex {
    // Exact sRGB EOTF (IEC 61966-2-1) — see camera_stream_flat.mat, #3338.
    float3 splatSrgbToLinear(float3 srgb) {
        float3 s = clamp(srgb, 0.0, 1.0);
        return mix(s * (1.0 / 12.92),
                   pow((s + 0.055) * (1.0 / 1.055), float3(2.4)),
                   step(float3(0.04045), s));
    }

    // Exact analytic inverse of ToneMapper.Filmic (Filament's Inverse_Tonemap_Filmic, inlined
    // so it is available in the vertex stage — the colour is per splat, not per fragment).
    float3 splatInverseFilmic(float3 x) {
        return (0.03 - 0.59 * x - sqrt(0.0009 + 1.3702 * x - 1.0127 * x * x)) / (-5.02 + 4.86 * x);
    }

    void materialVertex(inout MaterialVertexInputs material) {
        int tw = materialParams.texWidth;
        // Draw slot → splat index (the painter's sort lives in this one texture).
        int slot = getInstanceIndex() + materialParams.instanceOffset;
        int splat = int(texelFetch(materialParams_splatOrder, ivec2(slot % tw, slot / tw), 0).r);
        ivec2 texel = ivec2(splat % tw, splat / tw);

        // Per-splat attributes (inlined fetches — samplers can't be helper args under matc).
        highp float4 posScale = texelFetch(materialParams_splatPositionScale, texel, 0);
        float4 col = texelFetch(materialParams_splatColorOpacity, texel, 0);
        highp uvec4 packed = texelFetch(materialParams_splatRotationScale, texel, 0);
        highp float4 q = float4(unpackHalf2x16(packed.x), unpackHalf2x16(packed.y)); // xyzw
        highp float3 s = float3(unpackHalf2x16(packed.z), unpackHalf2x16(packed.w).x);

        highp float3 center = mulMat4x4Float3(getWorldFromModelMatrix(), posScale.xyz).xyz;
        highp mat4 viewFromWorld = getViewFromWorldMatrix();
        highp mat4 clipFromView = getClipFromViewMatrix();
        highp float3 t = mulMat4x4Float3(viewFromWorld, center).xyz; // view space, looks down -z
        highp float depth = -t.z;

        // Unit quad corner in [-1, 1]^2, instanced N times (the only vertex attribute).
        float2 corner = getPosition().xy;

        // Straight opacity → how many σ the gaussian stays above 1/255: the quad stops there.
        float alpha = col.a;
        float reach = alpha > (1.0 / 255.0) ? min(3.0, sqrt(2.0 * log(255.0 * alpha))) : 0.0;

        highp float2 offsetPx = float2(0.0);
        float2 sigmaUv = float2(0.0);
        highp float2 focal = float2(clipFromView[0][0], clipFromView[1][1]) * 0.5 * getResolution().xy;
        if (depth > 1e-4 && reach > 0.0) {
            // Model-space 3D covariance factor M = R·S (Σ = M·Mᵀ), columns = scaled rotation axes.
            highp float x = q.x;
            highp float y = q.y;
            highp float z = q.z;
            highp float w = q.w;
            highp mat3 m = mat3(
                float3(1.0 - 2.0 * (y * y + z * z), 2.0 * (x * y + w * z), 2.0 * (x * z - w * y)) * s.x,
                float3(2.0 * (x * y - w * z), 1.0 - 2.0 * (x * x + z * z), 2.0 * (y * z + w * x)) * s.y,
                float3(2.0 * (x * z + w * y), 2.0 * (y * z - w * x), 1.0 - 2.0 * (x * x + y * y)) * s.z
            );
            // To view space: node transform then camera, rotation/scale part only.
            highp mat3 tm = mat3(viewFromWorld) * mat3(getWorldFromModelMatrix()) * m;

            // Perspective Jacobian in pixels at the (frustum-clamped) centre — the clamp keeps
            // splats far outside the view from blowing up, as in the reference rasteriser.
            highp float2 lim = 1.3 / float2(clipFromView[0][0], clipFromView[1][1]);
            highp float2 txy = clamp(t.xy / depth, -lim, lim) * depth;
            highp float3 tRow0 = float3(tm[0][0], tm[1][0], tm[2][0]);
            highp float3 tRow1 = float3(tm[0][1], tm[1][1], tm[2][1]);
            highp float3 tRow2 = float3(tm[0][2], tm[1][2], tm[2][2]);
            highp float3 j0 = (focal.x / depth) * tRow0 + (focal.x * txy.x / (depth * depth)) * tRow2;
            highp float3 j1 = (focal.y / depth) * tRow1 + (focal.y * txy.y / (depth * depth)) * tRow2;

            // 2×2 screen covariance (+0.3 px² low-pass: never thinner than about a pixel).
            highp float a = dot(j0, j0) + 0.3;
            highp float b = dot(j0, j1);
            highp float c = dot(j1, j1) + 0.3;

            // Eigen-decomposition → major/minor axis lengths (σ, px) and directions.
            highp float mid = 0.5 * (a + c);
            highp float radius = length(float2(0.5 * (a - c), b));
            highp float sigma1 = sqrt(mid + radius);
            highp float sigma2 = sqrt(max(mid - radius, 0.1));
            highp float2 axis1 = abs(b) > 1e-9 * (a + c)
                ? normalize(float2(b, mid + radius - a))
                : (a >= c ? float2(1.0, 0.0) : float2(0.0, 1.0));
            highp float2 axis2 = float2(-axis1.y, axis1.x);

            // Quad half-extent per axis, in σ, capped at 1024 px so a splat grazing the camera
            // cannot flood the screen.
            sigmaUv = float2(min(reach, 1024.0 / sigma1), min(reach, 1024.0 / sigma2));
            offsetPx = corner.x * sigmaUv.x * sigma1 * axis1 + corner.y * sigmaUv.y * sigma2 * axis2;
        }

        // Pixel offset → view-space offset in the camera-parallel plane through the centre, then
        // to world along the camera right/up axes (the first two ROWS of ViewFromWorld).
        highp float2 offsetView = offsetPx * depth / focal;
        highp float3 camRight = float3(viewFromWorld[0][0], viewFromWorld[1][0], viewFromWorld[2][0]);
        highp float3 camUp    = float3(viewFromWorld[0][1], viewFromWorld[1][1], viewFromWorld[2][1]);
        material.worldPosition = float4(center + offsetView.x * camRight + offsetView.y * camUp, 1.0);

        // Custom material `variables` are float4 interpolants: the corner in σ units.
        material.quadUv = float4(corner * sigmaUv, 0.0, 0.0);
        material.splatColor = float4(splatInverseFilmic(splatSrgbToLinear(col.rgb)), alpha);
    }
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        // Gaussian footprint: the interpolated quad coordinate is already in σ units along the
        // ellipse axes, so the Mahalanobis distance is its length.
        float2 uv = variable_quadUv.xy;
        float a = variable_splatColor.a * exp(-0.5 * dot(uv, uv));

        // #2224 / #2325 — premultiply. blending:transparent composites ONE*src + (1-a)*dst,
        // so the emitted rgb must already be alpha-weighted for a correct radiance-field blend.
        material.baseColor = float4(variable_splatColor.rgb * a, a);
    }
}
