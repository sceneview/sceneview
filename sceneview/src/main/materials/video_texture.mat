// video_texture.mat — see CONTRIBUTING.md "Filament runtime ↔ .filamat ABI invariant"
//
// Purpose:    Unlit opaque material that draws video frames from an external (OES) texture.
// Used by:    MaterialLoader.createVideoInstance (chromaKeyColor == null) / VideoNode.
// Parameters:
//   texture — samplerExternal, the SurfaceTexture-backed stream of decoded video frames.
// matc profile: A (heavy Android — "-p all -a all", see tools/GenerateFilamat.sh).
material {
    name : "Video Material",
    parameters : [
        {
            // true when the node is drawn in a Filmic view (createARView), false for the
            // createView default (PBR Neutral). Set by VideoNode / ViewNode from their view.
            type : bool,
            name : inverseFilmic
        },
        {
            // The texture displaying the frames of the video.
            type : samplerExternal,
            name : texture
        }
    ],
    requires : [ uv0 ],
    shadingModel : unlit,
    doubleSided : true,
    blending : opaque
}

fragment {
    // Inverse of the View's tone mapper, so the source colour displays as authored (#4595).
    // createView grades with PBR Neutral (the default); createARView keeps Filmic, and the node
    // sets `inverseFilmic` when it is drawn in such a view. The inverse runs in the Rec.2020
    // space Filament grades in, shared by every pass-through material (#5219).
    #include "include/view_tone_map_inverse.fs"

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 color = texture(materialParams_texture, getUV0()).rgba;
        material.baseColor.a = color.a;
        material.baseColor.rgb = inverseViewTonemapSRGB(color.rgb, materialParams.inverseFilmic);
    }
}
