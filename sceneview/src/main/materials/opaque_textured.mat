// opaque_textured.mat — see CONTRIBUTING.md "Filament runtime ↔ .filamat ABI invariant"
//
// Purpose:    Lit PBR material for opaque geometry textured from a sampler2d.
// Used by:    MaterialLoader.createTextureInstance (isOpaque = true).
// Parameters:
//   texture     — sampler2d, the base-colour texture sampled at uv0.
//   metallic    — float [0,1], 0 = dielectric, 1 = metal.
//   roughness   — float [0,1], 0 = mirror, 1 = fully diffuse.
//   reflectance — float [0,1], dielectric Fresnel reflectance at normal incidence.
// matc profile: A (heavy Android — "-p all -a all", see tools/GenerateFilamat.sh).
material {
    "name" : "Opaque Textured",

    "parameters" : [
        {
           "type" : "sampler2d",
           "name" : "texture"
        },
        {
           "type" : "float",
           "name" : "metallic"
        },
        {
            "type" : "float",
            "name" : "roughness"
        },
        {
            "type" : "float",
            "name" : "reflectance"
        }
    ],
    "requires" : [
        "position",
        "uv0"
    ],
    "shadingModel" : "lit",
    "blending" : "opaque"
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = texture(materialParams_texture, getUV0());
        material.metallic = materialParams.metallic;
        material.roughness = materialParams.roughness;
        material.reflectance = materialParams.reflectance;
    }
}
