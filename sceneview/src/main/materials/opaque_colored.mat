// opaque_colored.mat — see CONTRIBUTING.md "Filament runtime ↔ .filamat ABI invariant"
//
// Purpose:    Lit PBR material for opaque solid-colour geometry.
// Used by:    MaterialLoader.createColorInstance (alpha == 1) — LineNode, PathNode, generic nodes.
// Parameters:
//   color       — float4, base RGBA colour of the surface.
//   metallic    — float [0,1], 0 = dielectric, 1 = metal.
//   roughness   — float [0,1], 0 = mirror, 1 = fully diffuse.
//   reflectance — float [0,1], dielectric Fresnel reflectance at normal incidence.
// matc profile: A (heavy Android — "-p all -a all", see tools/GenerateFilamat.sh).
material {
    "name" : "Opaque Colored",

    "parameters" : [
        {
           "type" : "float4",
           "name" : "color"
        },
        {
           "type" : "float",
           "name" : "metallic"
        },
        {
            "type" : "float",
            "name" : "roughness"
        },
        {
            "type" : "float",
            "name" : "reflectance"
        }
    ],
    "requires" : [
        "position",
        "uv0"
    ],
    "shadingModel" : "lit",
    "blending" : "opaque"
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = materialParams.color;
        material.metallic = materialParams.metallic;
        material.roughness = materialParams.roughness;
        material.reflectance = materialParams.reflectance;
    }
}
