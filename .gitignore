# ── MCP ───────────────────────────────────────────────────
mcp/.DS_Store
mcp/demo/*.mp4
# `mcp/dist/` is a build artefact — `tsc` output regenerated by the
# `prebuild` / `prepare` / `test` lifecycle scripts on every `npm install` /
# `npm run build` / `npm test` / `npm publish`. Committing it meant the
# compiled JS silently drifted from `src/` (issue #2047 — committed
# `dist/generated/llms-txt.js` embedded a stale SceneView SDK version). The
# npm tarball is always built fresh on publish via `npm run prepare`, so the
# committed copy was never used by anything. Same "no committed generated
# artefact" decision as #1928 (`mcp/src/generated/llms-txt.ts`).
mcp/dist/
mcp/llms.txt
mcp/.mcpregistry_*
.mcpregistry_*
# `mcp/src/generated/llms-txt.ts` embeds the entire root `llms.txt` as a
# ~230 KB string literal. Committing it produced a guaranteed merge conflict
# on every parallel PR that also touched `llms.txt` (issue #1928). It is now
# generated at build time — `npm install` / `npm run build` / `npm test` /
# `npm publish` all run `scripts/generate-llms-txt.js` via the
# `prepare` / `prebuild` / `test` lifecycle scripts.
mcp/src/generated/llms-txt.ts

# ── Swift / Xcode ─────────────────────────────────────────
SceneViewSwift/.build/
SceneViewSwift/.swiftpm/
DerivedData/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
samples/ios-demo/.build/
# Xcode-resolved SPM checkout/state — generated, and `workspace-state.json`
# bakes in absolute machine paths, so it must never be committed.
samples/ios-demo/SourcePackages/
# SwiftPM build dir at any depth (root `.build/` appears when `swift build` is
# run from the worktree root).
.build/

# ── Android artifacts ─────────────────────────────────────
*.apk
*.aab

# `GeneratedDemos.kt` is the collated output of the append-only DemoRegistry
# fragments (issue #1797). Committing it produced a guaranteed merge conflict
# on every parallel demo-adding PR (issue #1976) — the same conflict class
# #1928 killed for `mcp/src/generated/llms-txt.ts`. It is now generated at
# build time: the `generateDemoRegistry` Gradle task runs
# `samples/android-demo/scripts/collate-demos.sh --kt-only` before
# `:samples:android-demo` Kotlin compilation.
samples/android-demo/src/main/java/io/github/sceneview/demo/fragments/GeneratedDemos.kt

# `GeneratedScenes.swift` is the iOS counterpart of `GeneratedDemos.kt` —
# collated from per-demo `*Scene.swift` files by
# `samples/ios-demo/scripts/collate-ios-demos.sh`. Same rationale: committing
# it causes guaranteed merge conflicts on parallel demo-adding PRs (issue #1872).
# Xcode regenerates it before each build via the "Collate iOS demos" Run Script
# phase in `SceneViewDemo.xcodeproj`.
samples/ios-demo/SceneViewDemo/Views/Demos/GeneratedScenes.swift

# ── MkDocs ────────────────────────────────────────────────
docs/.cache/
docs/site/
site/

# `docs/docs/llms.txt` is a byte-for-byte mirror of the root `llms.txt`,
# served by mkdocs at `/docs/llms.txt` (issue #899). Committing the mirror
# meant every PR touching root `llms.txt` had to remember to update the copy
# (or run `sync-versions.sh --fix`) — drift landed on `main` repeatedly
# (#1822 → #1847) and turned the quality gate red on otherwise-clean PRs.
# It is now generated from root `llms.txt` at docs-build time by
# `.github/workflows/docs.yml` (the "Mirror root llms.txt into docs" step,
# before `mkdocs build`) and `.gitignore`d. Being a copy made fresh on every
# build, it is fresh-by-construction and cannot drift — the same
# "no committed generated artefact" decision as #1928
# (`mcp/src/generated/llms-txt.ts`) and #1976 (`GeneratedDemos.kt`).
docs/docs/llms.txt

# ── Environment & secrets ─────────────────────────────────
.env
.env.local
.secrets/

# ── Signing & keystore artefacts (defense in depth) ───────
# The Play Store keystore is decoded transiently in CI (.github/workflows/play-store.yml)
# and rm'd in `if: always()`, but a workflow interrupted between decode and rm could
# leak it via failure artifacts. These patterns also block accidental `git add -A`
# after running release tooling locally.
**/*.keystore
**/*.jks
**/google-services.json
# iOS demo Sketchfab key — the REAL key lives here (gitignored). The committed
# `Secrets.xcconfig.template` (placeholder) is intentionally NOT matched — do
# NOT widen this to `**/Secrets.xcconfig*` or the template stops being
# committable. See samples/ios-demo/SceneViewDemo/Config.xcconfig (#2356).
**/Secrets.xcconfig
**/*.p12
**/*.mobileprovision
# Exception: React Native debug keystore is the well-known shared dev key,
# safe to track and required for RN Android dev builds.
!samples/react-native-demo/android/app/debug.keystore

