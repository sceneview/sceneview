// transparent_colored.mat — see CONTRIBUTING.md "Filament runtime ↔ .filamat ABI invariant"
//
// Purpose:    Lit PBR material for translucent solid-colour geometry in the web 3D viewer.
// Used by:    sceneview.js web renderer (Filament.js / WebGL) — translucent coloured nodes.
// Parameters:
//   baseColor   — float4, base RGBA colour; alpha drives the transparency.
//   metallic    — float [0,1], 0 = dielectric, 1 = metal.
//   roughness   — float [0,1], 0 = mirror, 1 = fully diffuse.
//   reflectance — float [0,1], dielectric Fresnel reflectance at normal incidence.
// matc profile: D (website-static / WebGL — "-p mobile -a opengl").
material {
    "name" : "Transparent Colored",
    "parameters" : [
        { "type" : "float4", "name" : "baseColor" },
        { "type" : "float", "name" : "metallic" },
        { "type" : "float", "name" : "roughness" },
        { "type" : "float", "name" : "reflectance" }
    ],
    "requires" : [
        "position"
    ],
    "shadingModel" : "lit",
    "blending" : "transparent"
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = materialParams.baseColor;
        material.metallic = materialParams.metallic;
        material.roughness = materialParams.roughness;
        material.reflectance = materialParams.reflectance;
    }
}
